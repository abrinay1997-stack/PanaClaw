{
  "name": "panaclaw-sitio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // El chat lee sus claves de `process.env`. Con esta bandera, y esa fecha, los
  // secretos y variables del Worker aparecen ahí, y el chat no cambia.
  "compatibility_flags": ["nodejs_compat"],

  // NO HAY `account_id` AQUÍ, igual que en el hub y en el CRM: es un dato de
  // QUIÉN despliega, no del proyecto. Se pasa con `CLOUDFLARE_ACCOUNT_ID`.

  // Apagada (8-nov-2026): el dominio ya sirve desde Cloudflare y la dirección
  // `panaclaw-sitio.<cuenta>.workers.dev` era una copia pública del sitio y una
  // segunda puerta al chat, fuera de cualquier regla que se ponga en el dominio.
  // Para ensayar algo, se enciende un momento y se vuelve a apagar.
  "workers_dev": false,
  "preview_urls": false,

  // EL DOMINIO. Se sirve por RUTAS DE ZONA, no por `custom_domain`.
  //
  // `custom_domain: true` exige que NO exista ningún registro DNS del nombre: hay
  // que borrar el A y el CNAME que apuntan a Netlify y el sitio queda caído hasta
  // que el despliegue termina. Con rutas no se borra nada: mientras los registros
  // `A @` y `CNAME www` estén en NUBE GRIS (DNS only) el tráfico va directo a
  // Netlify y esta ruta no recibe nada. El cambio real ocurre cuando se ponen en
  // NUBE NARANJA (Proxied): desde ese segundo atiende el Worker. Y para volver
  // atrás basta ponerlas otra vez en gris. Pasos en `docs/MIGRACION_CLOUDFLARE.md`.
  "routes": [
    { "pattern": "panaclaw.com/*", "zone_name": "panaclaw.com" },
    { "pattern": "www.panaclaw.com/*", "zone_name": "panaclaw.com" }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // `/contacto/` y no `/contacto.html`: es lo que declara Astro con
    // `trailingSlash: 'always'` y `format: 'directory'`, y es lo que ya está
    // indexado. Es el valor por defecto de Cloudflare; se escribe para que nadie
    // lo cambie sin saber qué cuesta.
    "html_handling": "auto-trailing-slash",
    // Sirve `404.html` con estado 404 en vez de la portada.
    "not_found_handling": "404-page",
    // Solo la API despierta al Worker. Todo lo demás sale del borde, gratis.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
