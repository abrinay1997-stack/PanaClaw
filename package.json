{
  "name": "panaclaw",
  "version": "1.0.0",
  "description": "Sitio web de PanaClaw — agencia de sitios Jamstack en Panamá.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "brand": "node scripts/generate-brand-assets.mjs",
    "medir": "node scripts/measure-projects.mjs",
    "capturas": "node scripts/capture-projects.mjs",
    "medir:movil": "node scripts/check-mobile.mjs",
    "medir:cotizador": "node scripts/check-cotizador.mjs",
    "medir:chat": "node scripts/check-chat.mjs",
    "medir:galeria": "node scripts/check-galeria.mjs",
    "medir:privacidad": "node scripts/check-privacidad.mjs",
    "medir:enlaces": "node scripts/check-links.mjs",
    "astro": "astro",
    "build:cloudflare": "astro build && node scripts/cloudflare-assets.mjs",
    "cloudflare:probar": "npm run build:cloudflare && npx --yes wrangler@4.158.0 deploy --dry-run",
    "cloudflare:dev": "npm run build:cloudflare && npx --yes wrangler@4.158.0 dev",
    "cloudflare:desplegar": "npm run build:cloudflare && npx --yes wrangler@4.158.0 deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrinay1997-stack/PanaClaw.git"
  },
  "author": "PanaClaw",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/abrinay1997-stack/PanaClaw/issues"
  },
  "homepage": "https://github.com/abrinay1997-stack/PanaClaw#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/archivo": "^5.3.0",
    "astro": "^7.1.6",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
