---
/**
 * Movimiento de todo el sitio.
 *
 * Cada sección anima lo que contiene a medida que se baja: los títulos suben
 * con un desenfoque que se aclara, los textos y las tarjetas entran escalonados,
 * las imágenes se asientan y los fondos se desplazan más despacio que el
 * contenido (profundidad). Arriba, una barra fina muestra cuánto se ha leído.
 *
 * NO hay que envolver nada a mano: el script reconoce los bloques de cada
 * sección y les pone `data-anim`. `<Reveal>` sigue valiendo para lo que ya lo
 * usa (el script no lo toca) y para lo que necesite un tiempo propio.
 *
 * Reglas, para que sea seguro:
 *  - Solo se anima lo que está POR DEBAJO de la primera pantalla. Lo que ya se ve
 *    al cargar no se esconde jamás (el LCP no depende de esto).
 *  - Si el script falla, no queda nada escondido: lo oculto lo decide el script.
 *  - Con «reducir movimiento» no se anima nada.
 *  - Sin librería: transiciones CSS y un `IntersectionObserver`.
 *  - Para excluir una zona (por ejemplo, una que ya maneja su propia animación),
 *    `data-sin-anim` en el contenedor.
 */
---

<div class="scroll-progreso" aria-hidden="true"></div>

<script>
  import { prefersReducedMotion } from '../scripts/motion';

  const TITULOS = 'h1, h2, .section-title, .eyebrow';
  const TEXTOS = 'p, .lead, blockquote';
  const ITEMS = 'li, details, figure, .btn, .tk, .care-card, .ebot-cap, .plan-mini, .pil-item, .galeria-marco, [class*="-card"]';
  const IMAGENES = 'img';
  const EXCLUIR =
    '[data-reveal], [data-reveal-eager], [data-sin-anim], [data-ayuda], [data-canales], [data-galeria-pista], nav, footer, .nav-pill, .scene-bg, .muro, .hero-shader, [aria-hidden="true"]';

  let observador: IntersectionObserver | null = null;
  let fondos: HTMLElement[] = [];
  let atento = false;

  function marcar() {
    if (prefersReducedMotion()) return;
    observador?.disconnect();
    const vh = window.innerHeight || 800;
    const secciones = Array.from(document.querySelectorAll<HTMLElement>('main section'));
    const elegidos: HTMLElement[] = [];
    const hermanos = new Map<Element, number>();

    secciones.forEach((sec, n) => {
      if (n === 0) return; // la primera pantalla nunca se esconde
      sec.querySelectorAll<HTMLElement>(`${TITULOS}, ${TEXTOS}, ${ITEMS}, ${IMAGENES}`).forEach((el) => {
        if (el.dataset.anim || el.closest(EXCLUIR)) return;
        // Si un contenedor ya se anima, sus hijos no se animan por separado.
        if (el.parentElement?.closest('[data-anim]')) return;
        const r = el.getBoundingClientRect();
        if (r.height === 0 || r.top < vh * 0.92 && r.bottom > 0) return; // ya se ve: se queda quieto
        const tipo = el.matches(TITULOS) ? 'titulo' : el.matches(IMAGENES) ? 'imagen' : el.matches(ITEMS) ? 'item' : 'texto';
        const padre = el.parentElement!;
        const k = hermanos.get(padre) ?? 0;
        hermanos.set(padre, k + 1);
        el.dataset.anim = tipo;
        el.style.setProperty('--ad', `${Math.min(k, 6) * 0.08}s`);
        elegidos.push(el);
      });
    });

    observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).classList.add('is-in');
          observador!.unobserve(e.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    elegidos.forEach((el) => observador!.observe(el));

    fondos = Array.from(document.querySelectorAll<HTMLElement>('.scene-bg img'));
    fondos.forEach((img) => img.classList.add('con-parallax'));
    alMover();
  }

  const barra = () => document.querySelector<HTMLElement>('.scroll-progreso');
  let pendiente = false;
  function alMover() {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(() => {
      pendiente = false;
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const b = barra();
      if (b) b.style.transform = `scaleX(${total > 0 ? Math.min(1, window.scrollY / total) : 0})`;
      if (prefersReducedMotion()) return;
      const vh = window.innerHeight;
      fondos.forEach((img) => {
        const caja = (img.parentElement as HTMLElement).getBoundingClientRect();
        if (caja.bottom < -100 || caja.top > vh + 100) return;
        const centro = caja.top + caja.height / 2 - vh / 2;
        img.style.setProperty('--py', `${(centro * -0.12).toFixed(1)}px`);
      });
    });
  }

  function iniciar() {
    marcar();
    if (!atento) {
      atento = true;
      window.addEventListener('scroll', alMover, { passive: true });
      window.addEventListener('resize', alMover, { passive: true });
    }
  }
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>

<style is:global>
  .scroll-progreso {
    position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 200;
    background: var(--flash-orange); transform: scaleX(0); transform-origin: left;
    pointer-events: none; box-shadow: 0 0 12px rgba(255, 81, 0, 0.7);
  }

  [data-anim] {
    opacity: 0;
    will-change: opacity, transform;
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--ad, 0s),
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--ad, 0s),
      filter 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--ad, 0s);
  }
  [data-anim='titulo'] { transform: translate3d(0, 44px, 0); filter: blur(7px); }
  [data-anim='texto'] { transform: translate3d(0, 24px, 0); }
  [data-anim='item'] { transform: translate3d(0, 38px, 0) scale(0.96); }
  [data-anim='imagen'] { transform: scale(1.08); }
  [data-anim].is-in { opacity: 1; transform: none; filter: none; will-change: auto; }

  /* Los fondos se mueven más despacio que el contenido. El zoom evita ver el borde. */
  .scene-bg img.con-parallax {
    transform: translate3d(0, var(--py, 0px), 0) scale(1.14);
    will-change: transform;
  }

  /* Botones y tarjetas: respuesta al pasar el cursor, en todo el sitio. */
  .btn { transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s, background 0.25s, border-color 0.25s, color 0.25s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary:hover { box-shadow: 0 10px 30px rgba(255, 81, 0, 0.35); }

  @media (prefers-reduced-motion: reduce) {
    [data-anim] { opacity: 1 !important; transform: none !important; filter: none !important; transition: none !important; }
    .scene-bg img.con-parallax { transform: none; }
    .btn:hover { transform: none; }
  }
</style>
