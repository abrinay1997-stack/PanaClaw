---
/**
 * Smooth scroll global con Lenis.
 * - Se inicializa una vez, se re-inicializa en astro:page-load (View Transitions).
 * - Respeta prefers-reduced-motion (no arranca Lenis, deja scroll nativo).
 *
 * Ya no hay nada que sincronizar: los reveals se disparan con
 * IntersectionObserver, que lee la posición real del elemento y no depende de
 * que nadie le avise de que el scroll se movió.
 */
---

<script>
  import Lenis from 'lenis';
  import { prefersReducedMotion } from '../scripts/motion';

  let lenis: Lenis | null = null;
  let rafId: number | null = null;

  function initLenis() {
    if (prefersReducedMotion()) return;

    lenis = new Lenis({
      duration: 1.1,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.4,
    });

    /*
     * Un solo motor de frames. Antes había dos: se enganchaba `lenis.raf` al
     * ticker de GSAP y además se arrancaba este bucle "por si no había ticker",
     * sin comprobar que lo hubiera. Con GSAP cargado, Lenis avanzaba dos veces
     * por frame y con dos relojes distintos (el ticker en milisegundos, el rAF
     * en su propio timestamp).
     */
    function raf(time: number) {
      lenis?.raf(time);
      rafId = requestAnimationFrame(raf);
    }
    rafId = requestAnimationFrame(raf);
    armarIman();
  }

  /**
   * IMÁN POR SECCIÓN. Al terminar de desplazarse (la rueda se detuvo o se soltó el dedo), la
   * pantalla se asienta sola en la sección más cercana, como Safetory.
   *  - Sección que cabe en la pantalla: se alinea su borde de arriba.
   *  - Sección más alta que la pantalla: se ancla solo cerca de su borde de arriba o de abajo,
   *    para que se pueda leer por dentro sin que el imán te devuelva.
   *  - Las franjas bajas (menos de 60 % de la pantalla) no son destino: son puentes.
   *  - Una página que contenga `data-sin-iman` no lo usa (Ayuda y el cotizador son para
   *    consultar y trabajar, no para recorrer).
   *  - Sin Lenis (con «reducir movimiento») tampoco hay imán.
   */
  let tocando = false;
  let temporizador: number | undefined;
  let asentando = false;

  let direccion = 1;

  function destinoDelIman(): number | null {
    if (document.querySelector('[data-sin-iman]')) return null;
    if (document.documentElement.classList.contains('chat-bloqueo')) return null;
    const vh = window.innerHeight;
    const l = lenis as unknown as { targetScroll?: number } | null;
    const actual = window.scrollY; // dónde está ahora: las posiciones de las secciones se miden desde aquí
    const y = typeof l?.targetScroll === 'number' ? l.targetScroll : actual; // dónde IBA a parar el gesto
    const posiciones: number[] = [];
    let zonaLibre = false;
    document.querySelectorAll<HTMLElement>('main section').forEach((sec) => {
      const r = sec.getBoundingClientRect();
      if (r.height < vh * 0.6 || sec.offsetParent === null) return;
      const arriba = actual + r.top;
      posiciones.push(arriba);
      if (r.height > vh * 1.12) {
        // Sección alta: se ancla arriba y abajo, y en medio se lee sin imán.
        const abajo = actual + r.bottom - vh;
        posiciones.push(abajo);
        if (y > arriba + vh * 0.3 && y < abajo - vh * 0.3) zonaLibre = true;
      }
    });
    if (zonaLibre || posiciones.length === 0) return null;
    posiciones.sort((m, n) => m - n);
    const antes = [...posiciones].reverse().find((p) => p <= y + 2);
    const despues = posiciones.find((p) => p > y + 2);
    const umbral = vh * 0.05; // menos que esto es un roce: vuelve; más, avanza
    let destino: number | undefined;
    if (direccion >= 0) {
      destino = antes !== undefined && y - antes < umbral ? antes : despues ?? undefined;
    } else {
      destino = despues !== undefined && despues - y < umbral ? despues : antes ?? undefined;
    }
    if (destino === undefined || Math.abs(destino - y) < 2) return null;
    // No arrastra más de dos pantallas: el imán asienta, no teletransporta.
    if (Math.abs(destino - y) > vh * 1.6) return null;
    return Math.max(0, Math.round(destino));
  }

  function alReposar() {
    if (!lenis || tocando || asentando) return;
    const destino = destinoDelIman();
    if (destino === null) return;
    asentando = true;
    lenis.scrollTo(destino, {
      duration: 0.42,
      easing: (t: number) => 1 - Math.pow(1 - t, 3),
      lock: false,
      force: true,
      onComplete: () => { asentando = false; },
    });
    // Seguro por si la animación se interrumpe y nunca llama a onComplete.
    window.setTimeout(() => { asentando = false; }, 800);
  }

  function armarIman() {
    window.clearTimeout(temporizador);
    // Fuera de la rueda (teclado, barra de scroll): al reposar.
    lenis?.on('scroll', (e: { direction?: number }) => {
      if (asentando) return;
      if (e.direction) direccion = e.direction;
      window.clearTimeout(temporizador);
      temporizador = window.setTimeout(alReposar, 110);
    });
  }

  // La rueda: el imán actúa 60 ms después del último giro, sin esperar a que termine la
  // inercia del scroll suave (que tarda más de un segundo). Decide por donde IBA a parar.
  let finRueda: number | undefined;
  window.addEventListener('wheel', (e) => {
    if (!lenis) return;
    if ((e.target as HTMLElement)?.closest?.('[data-lenis-prevent]')) return; // se desplaza algo interno (el chat)
    if (e.deltaY !== 0) direccion = e.deltaY > 0 ? 1 : -1;
    asentando = false;
    window.clearTimeout(temporizador);
    window.clearTimeout(finRueda);
    finRueda = window.setTimeout(alReposar, 60);
  }, { passive: true });

  window.addEventListener('touchstart', () => { tocando = true; }, { passive: true });
  window.addEventListener('touchend', () => {
    tocando = false;
    window.clearTimeout(temporizador);
    temporizador = window.setTimeout(alReposar, 220);
  }, { passive: true });

  function destroyLenis() {
    window.clearTimeout(temporizador);
    asentando = false;
    if (rafId !== null) cancelAnimationFrame(rafId);
    lenis?.destroy();
    lenis = null;
    rafId = null;
  }

  function boot() {
    destroyLenis();
    initLenis();
  }

  // Inicial + cada navegación de View Transitions
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', destroyLenis);

  // Bootstrap: si astro:page-load ya se disparó (module scripts son diferidos), arrancar igual
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
