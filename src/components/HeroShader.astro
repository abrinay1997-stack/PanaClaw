---
/**
 * Fondo cinemático del hero: shader WebGL con simplex noise que dibuja
 * ribbons rojos sobre negro, respondiendo a la posición del mouse.
 *
 * - Colores adaptados a --ember-red del branding híbrido PanaClaw.
 * - Fallback: imagen estática SOLO si WebGL no está disponible o hay reduce-motion.
 *   Arranca invisible a propósito: antes se veía un destello del cohete en el
 *   primer paint, hasta que el canvas tomaba el relevo.
 * - El shader va deliberadamente apagado: el elemento más brillante del hero
 *   tiene que ser el titular, no el fondo.
 * - Se re-inicializa en astro:page-load (compatibilidad View Transitions).
 */
import { Image } from 'astro:assets';
import heroFallback from '../assets/hero/hero-fallback.png';
---

<div class="hero-shader" data-hero-shader>
  {/* alt="" + aria-hidden es intencional: la imagen es atmósfera, no
     contenido, y el hero ya dice todo lo que hay que decir en su H1. Que un
     lector de pantalla la anuncie sería ruido. La auditoría SEO del 20 ago
     marcó este alt vacío como "corregir"; es un falso positivo — sacar el
     alt="" o rellenarlo con "imagen del hero" empeoraría la accesibilidad. */}
  {/*
    Tres decisiones de peso, todas medidas en PageSpeed el 22 ago 2026:

    - `widths` con escalones finos. Con [640, 1280, 1920] y `sizes="100vw"`, un
      teléfono de 412 px a DPR 1,75 necesita ~721 px y no le queda más remedio
      que bajarse el de 1280 — 51 KiB para pintar 721. Los escalones intermedios
      le dejan pedir el que de verdad usa.
    - `quality` 62 en lugar de 72. Esta imagen nunca se ve limpia: va al 42 %
      de opacidad (62 % en móvil) y debajo de una viñeta que la oscurece entera.
      La calidad que se le quita no llega a la pantalla.
    - `fetchpriority="high"` se queda, y merece la aclaración porque el informe
      dice lo contrario. Ahí el elemento LCP era el H1 y esta imagen parecía una
      prioridad robada; lo era solo porque la imagen estaba invisible esperando
      al JavaScript. Arreglado eso, en móvil vuelve a ser lo que siempre fue de
      hecho: un fondo a pantalla completa, o sea el elemento más grande de la
      primera pantalla, o sea el LCP. Medido con Lighthouse en local, mediana de
      tres pasadas: quitarle la prioridad empeora el LCP de 1,97 s a 2,11 s.
      (En escritorio manda el shader y esta imagen no llega a verse, así que ahí
      la prioridad se gasta en algo invisible. Se acepta: el escritorio ya iba a
      1,3 s de LCP y el problema estaba en móvil.)
  */}
  <Image
    src={heroFallback}
    alt=""
    class="hero-shader-fallback"
    aria-hidden="true"
    widths={[480, 640, 768, 960, 1280, 1920]}
    sizes="100vw"
    format="webp"
    quality={62}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <canvas class="hero-shader-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero-shader-vignette" aria-hidden="true"></div>
</div>

<script>
  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  /**
   * En pantallas verticales el shader no vale la pena: el patrón de ruido se
   * calcula sobre un lienzo de proporción ~0.5 y las vetas salen estiradas en
   * vertical. Además es el peor sitio para gastar batería y GPU. Debajo de este
   * ancho mandamos la imagen fija, que es lo que se ve bien.
   */
  function isNarrow() {
    return window.matchMedia('(max-width: 900px)').matches;
  }

  let cleanup: (() => void) | null = null;

  /**
   * ¿Toca shader o imagen? Es la parte barata —dos media queries y una clase—,
   * así que corre de inmediato: en móvil la imagen es el fondo del hero y no
   * tiene por qué esperar a nada. Devuelve si hay que intentar el WebGL.
   */
  function decidirFondo(): boolean {
    const container = document.querySelector<HTMLElement>('[data-hero-shader]');
    if (!container) return false;

    // La imagen de respaldo solo aparece si de verdad no vamos a animar nada.
    if (prefersReducedMotion() || isNarrow()) {
      container.classList.add('is-fallback');
      return false;
    }
    return true;
  }

  function initHeroShader() {
    // Limpieza de instancia anterior (View Transitions puede re-invocar)
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const container = document.querySelector<HTMLElement>('[data-hero-shader]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!container || !canvas) return;

    // Entre la decisión y este punto pudo cambiar el ancho (rotar el móvil).
    if (prefersReducedMotion() || isNarrow()) {
      container.classList.add('is-fallback');
      return;
    }

    const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
    if (!gl) {
      container.classList.add('is-fallback');
      return;
    }

    // Sincronizar tamaño del drawing buffer con el layout
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    function syncSize() {
      const w = Math.max(1, Math.round(canvas!.clientWidth * dpr));
      const h = Math.max(1, Math.round(canvas!.clientHeight * dpr));
      if (canvas!.width !== w || canvas!.height !== h) {
        canvas!.width = w;
        canvas!.height = h;
      }
    }
    const ro = new ResizeObserver(syncSize);
    ro.observe(canvas);
    syncSize();

    const vs = `attribute vec2 a_position;
varying vec2 v_texCoord;
void main() {
  v_texCoord = a_position * 0.5 + 0.5;
  gl_Position = vec4(a_position, 0.0, 1.0);
}`;

    const fs = `precision highp float;
varying vec2 v_texCoord;
uniform float u_time;
uniform vec2 u_resolution;
uniform vec2 u_mouse;

vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }
float snoise(vec2 v){
  const vec4 C = vec4(0.211324865405187, 0.366025403784439,
           -0.577350269189626, 0.024390243902439);
  vec2 i  = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);
  vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
  m = m*m; m = m*m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 a0 = x - floor(x + 0.5);
  m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
  vec3 g;
  g.x  = a0.x  * x0.x  + h.x  * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

void main() {
  vec2 uv = v_texCoord;
  vec2 mouse = u_mouse / u_resolution;

  // El ruido se muestrea en espacio corregido por proporción. Sin esto, en una
  // ventana alta las vetas salen estiradas en vertical (el patrón se calcula
  // sobre un cuadrado deformado). La viñeta sigue usando uv sin corregir.
  float aspect = u_resolution.x / max(u_resolution.y, 1.0);
  vec2 st = vec2(uv.x * aspect, uv.y);

  // Animacion autónoma muy sutil (casi estático); el mouse manda.
  float noise1 = snoise(st * 2.6 + u_time * 0.020 + mouse * 2.4);
  float noise2 = snoise(st * 4.2 - u_time * 0.014 + mouse * 1.6);
  float ribbons = 1.0 - smoothstep(0.09, 0.13, abs(noise1 - noise2));
  float glow = smoothstep(0.45, 0.0, abs(noise1 - noise2));

  vec3 obsidian = vec3(0.02, 0.005, 0.005);
  vec3 ember    = vec3(1.0, 0.12, 0.12);

  vec3 color = obsidian;
  color = mix(color, ember, ribbons * 0.52);
  color += ember * glow * 0.14;
  float structures = smoothstep(0.45, 0.55, noise1);
  color += vec3(0.03) * structures;

  float d = distance(uv, vec2(0.5));
  color *= smoothstep(0.95, 0.15, d);

  // El fondo se queda deliberadamente por debajo del titular: sin este freno,
  // las vetas de lava compiten con el H1 y ganan.
  color *= 0.62;
  gl_FragColor = vec4(color, 1.0);
}`;

    function compile(type: number, src: string): WebGLShader | null {
      const s = gl!.createShader(type);
      if (!s) return null;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      return s;
    }

    const vShader = compile(gl.VERTEX_SHADER, vs);
    const fShader = compile(gl.FRAGMENT_SHADER, fs);
    if (!vShader || !fShader) return;

    const prog = gl.createProgram();
    if (!prog) return;
    gl.attachShader(prog, vShader);
    gl.attachShader(prog, fShader);
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const pos = gl.getAttribLocation(prog, 'a_position');
    gl.enableVertexAttribArray(pos);
    gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

    const uTime = gl.getUniformLocation(prog, 'u_time');
    const uRes = gl.getUniformLocation(prog, 'u_resolution');
    const uMouse = gl.getUniformLocation(prog, 'u_mouse');

    // Mouse en píxeles del canvas (convención ShaderToy)
    let mouseX = canvas.width / 2;
    let mouseY = canvas.height / 2;
    let targetX = mouseX;
    let targetY = mouseY;

    function onMouseMove(e: MouseEvent) {
      const rect = canvas!.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const nx = (e.clientX - rect.left) / rect.width;
      const ny = 1.0 - (e.clientY - rect.top) / rect.height;
      targetX = nx * canvas!.width;
      targetY = ny * canvas!.height;
    }
    window.addEventListener('mousemove', onMouseMove, { passive: true });

    // Pausar cuando el hero sale de viewport (ahorro de batería)
    let visible = true;
    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true;
      },
      { threshold: 0.01 }
    );
    io.observe(container);

    // Marcar como activo (oculta el fallback con transición)
    container.classList.add('is-active');

    let raf = 0;
    let running = true;
    function render(t: number) {
      if (!running) return;
      raf = requestAnimationFrame(render);
      if (!visible) return; // no renderiza si no está en pantalla
      // Lerp muy bajo: el fondo persigue al cursor con retardo, sin tirones.
      // Subirlo hace que el giro "salte" al mover el mouse rápido.
      mouseX += (targetX - mouseX) * 0.018;
      mouseY += (targetY - mouseY) * 0.018;
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
      if (uTime) gl!.uniform1f(uTime, t * 0.001);
      if (uRes) gl!.uniform2f(uRes, canvas!.width, canvas!.height);
      if (uMouse) gl!.uniform2f(uMouse, mouseX, mouseY);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
    }
    raf = requestAnimationFrame(render);

    cleanup = () => {
      running = false;
      cancelAnimationFrame(raf);
      window.removeEventListener('mousemove', onMouseMove);
      ro.disconnect();
      io.disconnect();
      container.classList.remove('is-active');
    };
  }

  // Al cruzar el umbral (rotar el móvil, redimensionar la ventana) hay que
  // decidir de nuevo entre shader e imagen.
  const narrowQuery = window.matchMedia('(max-width: 900px)');
  const onBreakpoint = () => {
    document.querySelector('[data-hero-shader]')?.classList.remove('is-fallback');
    arrancar();
  };
  if (narrowQuery.addEventListener) narrowQuery.addEventListener('change', onBreakpoint);

  /**
   * El shader arranca DESPUÉS de que cargue la página, no durante.
   *
   * Compilar dos shaders, crear el contexto WebGL y entrar en un bucle de
   * requestAnimationFrame no es trabajo gratis, y hacerlo mientras el navegador
   * todavía está pintando la primera pantalla es gastarlo en el peor momento
   * posible: PageSpeed midió 620 ms de TBT en escritorio el 22 ago 2026, que es
   * justo la ventana en la que esto corría. El fondo es atmósfera; el titular
   * es el contenido. Primero el contenido.
   *
   * Lo que NO se aplaza es la decisión: `decidirFondo` corre de inmediato y, si
   * toca imagen fija —móvil o reduce-motion—, la enciende ahí mismo. Cuesta una
   * clase y en móvil esa imagen es el fondo del hero, no un plan B.
   *
   * En una navegación con View Transitions la página ya está cargada, así que
   * `readyState === 'complete'` y el shader entra sin esperar a nada.
   */
  function alQuedarOcioso(fn: () => void) {
    const lanzar = () => {
      if ('requestIdleCallback' in window) window.requestIdleCallback(fn, { timeout: 1200 });
      else setTimeout(fn, 200);
    };
    if (document.readyState === 'complete') lanzar();
    else window.addEventListener('load', lanzar, { once: true });
  }

  function arrancar() {
    if (decidirFondo()) alQuedarOcioso(initHeroShader);
  }

  document.addEventListener('astro:page-load', arrancar);
  document.addEventListener('astro:before-swap', () => {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }
  });

  // Bootstrap para el primer render (module scripts llegan después de astro:page-load)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', arrancar, { once: true });
  } else {
    arrancar();
  }
</script>

<style>
  .hero-shader {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--deep-black);
  }
  .hero-shader-fallback,
  .hero-shader-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Invisible por defecto: solo entra si el JS confirma que no habrá shader.
     Antes arrancaba visible y se veía un destello de la imagen en cada carga. */
  .hero-shader-fallback {
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .hero-shader.is-fallback .hero-shader-fallback {
    opacity: 0.42;
  }
  /* En móvil la imagen no es un respaldo, es EL fondo del hero: sube de
     presencia y se recentra para que el sujeto no quede fuera del recorte. */
  @media (max-width: 900px) {
    .hero-shader.is-fallback .hero-shader-fallback {
      opacity: 0.62;
      object-position: 62% center;
    }
  }
  .hero-shader-canvas {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .hero-shader.is-active .hero-shader-canvas {
    opacity: 1;
  }
  .hero-shader-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 45%, transparent 30%, rgba(16, 1, 1, 0.55) 78%, rgba(16, 1, 1, 0.9) 100%),
      linear-gradient(to bottom, rgba(16, 1, 1, 0.55) 0%, transparent 32%, transparent 55%, rgba(16, 1, 1, 0.92) 100%);
  }
  /* Con imagen detrás el titular necesita más cama que con el shader */
  @media (max-width: 900px) {
    .hero-shader-vignette {
      background:
        linear-gradient(to bottom, rgba(16, 1, 1, 0.82) 0%, rgba(16, 1, 1, 0.5) 34%, rgba(16, 1, 1, 0.72) 72%, var(--deep-black) 100%);
    }
  }
</style>
