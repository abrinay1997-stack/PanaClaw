      left: 0;
      right: 0;
      bottom: var(--chat-kb, 0px);
      width: auto;
      height: min(86vh, 680px);
      height: min(86dvh, calc(var(--chat-vvh, 100dvh) - 8px), 680px);
      border-radius: 22px 22px 0 0;
      border-bottom: none;
      /* Opaco: sobre la página de atrás el 3 % de transparencia dejaba ver su
         texto como un fantasma detrás de la conversación. */
      background: #0c0202;
      transform-origin: bottom center;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      animation: chat-sube 0.32s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .chat-panel:not(.is-arrastrando) {
