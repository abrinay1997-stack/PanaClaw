---
import { waLink, site } from '../data/site';
import { routes } from '../data/links';

/**
 * Burbuja de chat.
 *
 * Dos decisiones que no son de estilo:
 *
 * 1. **Las sugerencias iniciales no son decorado.** Dirigen la conversación
 *    hacia preguntas que la base de conocimiento responde bien. En un modelo
 *    pequeño, encauzar la pregunta vale más que mejorar el prompt.
 *
 * 2. **Degrada a WhatsApp, no a un error.** En GitHub Pages no existe
 *    `/api/chat`; el widget lo detecta al primer intento y se convierte en un
 *    atajo a WhatsApp en vez de quedarse roto. Así el mismo código sirve en
 *    Pages hoy y en Netlify mañana.
 */
/*
 * Las preguntas de arranque cambian según la página en la que estás (están en el
 * script, en `porPagina`): quien mira /planes/ pregunta otra cosa que quien mira
 * /ebot/. Todas están escritas como se pregunta, no como se llaman los
 * productos —quien no conoce el nombre no puede pulsar una pastilla que diga
 * «eBot»—, y todas se comprobaron contra la recuperación real del chat: cada una
 * devuelve el hecho que toca en los dos primeros lugares.
 */
const rutas = {
  planes: routes.planes,
  servicios: routes.servicios,
  ebot: routes.ebot,
  seguridad: routes.seguridad,
  proyectos: routes.proyectos,
  proceso: routes.proceso,
  cotizador: routes.cotizador,
  contacto: routes.contacto,
  ayuda: routes.ayuda,
  blog: routes.blog,
  home: routes.home,
};
---

<div class="chat" data-chat transition:persist="chat">
  {/*
    El aria-label repite la palabra que ya se lee al lado, y tiene que estar:
    debajo de 520 px la etiqueta visible se oculta con display:none y el botón
    se queda en icono puro, sin nombre accesible —un lector de pantalla anuncia
    "botón" y ya—. Lighthouse lo marcó el 22 ago 2026 solo en la pasada de
    móvil, por eso mismo.

    Dice exactamente "Asistente", el mismo texto visible, y no algo más
    descriptivo tipo "Abrir el asistente": si el nombre accesible no contiene al
    texto que se ve, quien maneja el sitio por voz dice lo que lee y no pasa
    nada (WCAG 2.5.3, y es el fallo que tenía la flecha del hero).
  */}
  <button
    class="chat-launcher"
    type="button"
    data-chat-toggle
    aria-label="Asistente"
    aria-expanded="false"
    aria-controls="chat-panel"
  >
    <span class="chat-launcher-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
      </svg>
    </span>
    <span class="chat-launcher-label">Asistente</span>
  </button>

  {/* Solo en teléfono: oscurece la página y, al tocarlo, cierra el chat. */}
  <div class="chat-backdrop" data-chat-backdrop hidden></div>

  {/*
    `data-lenis-prevent`: el desplazamiento suave de la página (Lenis) captura la
    rueda y el dedo en toda la ventana. Sin este atributo, mover el contenido del
    chat desplazaba la página de atrás y no la conversación.
  */}
  <section
    class="chat-panel"
    id="chat-panel"
    data-chat-panel
    data-lenis-prevent
    hidden
    tabindex="-1"
    aria-label="Asistente de PanaClaw"
  >
    <header class="chat-head" data-chat-head>
      {/* Asa para arrastrar hacia abajo y cerrar (teléfono). Decorativa. */}
      <span class="chat-grip" aria-hidden="true"></span>
      <div class="chat-head-text">
        <p class="chat-title">Asistente de {site.name}</p>
        <p class="chat-sub" data-chat-sub>Te contesto y te llevo adonde necesitas</p>
      </div>
      <div class="chat-head-actions">
        <button class="chat-icon-btn chat-expand" type="button" data-chat-expand aria-label="Agrandar el chat" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
          </svg>
        </button>
        <button class="chat-icon-btn chat-close" type="button" data-chat-close aria-label="Cerrar el chat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <div class="chat-log" data-chat-log role="log" aria-live="polite" aria-atomic="false">
      <div class="chat-msg is-bot">
        <p>
          Hola. Te contesto dudas y te llevo a lo que buscas en el sitio.
          Si no lo sé, te paso con una persona.
        </p>
      </div>
      <div class="chat-suggestions" data-chat-suggestions></div>
    </div>

    {/* Atajos que siempre están: la guía. Se desplazan de lado, no ocupan alto. */}
    <div class="chat-guia" data-chat-guia role="group" aria-label="Atajos">
      <button type="button" class="chat-chip is-guia is-main" data-chat-elegir>Ayúdame a elegir</button>
      <a class="chat-chip is-guia" data-chat-ir href={routes.proyectos}>Ver proyectos</a>
      <a class="chat-chip is-guia" data-chat-ir href={routes.cotizador}>Cotizar</a>
    </div>

    <form class="chat-form" data-chat-form>
      <label class="visually-hidden" for="chat-input">Escribe tu pregunta</label>
      <input
        id="chat-input"
        type="text"
        name="q"
        placeholder="Escribe tu pregunta…"
        autocomplete="off"
        autocapitalize="sentences"
        enterkeyhint="send"
        maxlength="500"
        data-chat-input
      />
      <button type="submit" class="chat-send" data-chat-send aria-label="Enviar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4 20-7Z" />
        </svg>
      </button>
    </form>

    <p class="chat-foot">
      Respuestas generadas a partir de la información del sitio.
      <a href={waLink()} target="_blank" rel="noopener">Hablar con una persona</a>
    </p>
  </section>
</div>

<script is:inline define:vars={{ whatsapp: waLink(), rutas }}>
  (() => {
    const root = document.querySelector('[data-chat]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const html = document.documentElement;
    const panel = root.querySelector('[data-chat-panel]');
    const head = root.querySelector('[data-chat-head]');
    const toggle = root.querySelector('[data-chat-toggle]');
    const closeBtn = root.querySelector('[data-chat-close]');
    const expandBtn = root.querySelector('[data-chat-expand]');
    const backdrop = root.querySelector('[data-chat-backdrop]');
    const sub = root.querySelector('[data-chat-sub]');
    const log = root.querySelector('[data-chat-log]');
    const form = root.querySelector('[data-chat-form]');
    const input = root.querySelector('[data-chat-input]');
    const send = root.querySelector('[data-chat-send]');
    const suggestions = root.querySelector('[data-chat-suggestions]');
    const guia = root.querySelector('[data-chat-guia]');
    const elegirBtn = root.querySelector('[data-chat-elegir]');

    /** Historial que se manda al servidor. Corto: el backend re-recupera cada turno. */
    const history = [];
    let busy = false;
    let endpointDown = false;
    let conversando = false;

    const mq = (q) => window.matchMedia(q).matches;
    /** Teléfono: el chat es una hoja que sube desde abajo. */
    const esMovil = () => mq('(max-width: 640px)');
    /** Pantalla táctil: abrir el teclado solo cuando la persona toca el campo. */
    const esTactil = () => mq('(pointer: coarse)');
    const reducido = () => mq('(prefers-reduced-motion: reduce)');

    const guardar = (k, v) => { try { v == null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} };
    const leer = (k) => { try { return localStorage.getItem(k); } catch { return null; } };

    /* ------------------------------------------------------------------ *
     * Abrir y cerrar
     * ------------------------------------------------------------------ */

    const open = () => {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      sincronizarMovil();
      aplicarPosicion();
      ajustarTeclado();
      /*
       * EL TECLADO NO SE ABRE SOLO EN TELÉFONO.
       *
       * Antes aquí había `input.focus()` siempre. En Safari de iPhone, enfocar un
       * campo con letra menor de 16 px AMPLÍA la página —y no vuelve a su
       * tamaño—, así que el panel quedaba recortado por la derecha y la página
       * entera se veía agrandada: lo que enseñó la captura del 8-nov-2026.
       * Ahora el campo mide 16 px y, además, en pantallas táctiles el foco va al
       * panel (que no abre teclado) y el teclado sale cuando la persona toca el
       * campo porque quiere escribir.
       */
      if (esTactil()) panel.focus({ preventScroll: true });
      else input.focus();
    };
    const close = (devolverFoco = true) => {
      panel.hidden = true;
      panel.style.transform = '';
      toggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
      html.classList.remove('chat-bloqueo');
      backdrop.hidden = true;
      if (devolverFoco) toggle.focus({ preventScroll: true });
    };
    /** Al ir a una sección o a otra página, en teléfono el chat se pliega para que se vea. */
    const plegarEnMovil = () => { if (esMovil() && !panel.hidden) close(false); };

    /** Teléfono: fondo oscuro y la página de atrás no se desplaza. Escritorio: nada de eso. */
    function sincronizarMovil() {
      if (panel.hidden) return;
      const movil = esMovil();
      html.classList.toggle('chat-bloqueo', movil);
      backdrop.hidden = !movil;
    }

    /**
     * El teclado de iPhone y Android encoge el viewport VISUAL, no el de diseño:
     * un panel anclado abajo se queda tapado por el teclado. Se mide lo que lo
     * tapa y se sube el panel esa cantidad; y se acota su alto a lo que se ve.
     */
    const vv = window.visualViewport;
    function ajustarTeclado() {
      if (!vv || panel.hidden || !esMovil()) {
        root.style.removeProperty('--chat-kb');
        root.style.removeProperty('--chat-vvh');
        return;
      }
      const tapado = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
      root.style.setProperty('--chat-kb', `${Math.round(tapado)}px`);
      root.style.setProperty('--chat-vvh', `${Math.round(vv.height)}px`);
    }
    vv?.addEventListener('resize', ajustarTeclado);
    vv?.addEventListener('scroll', ajustarTeclado);
    window.addEventListener('resize', () => { sincronizarMovil(); ajustarTeclado(); aplicarPosicion(); });

    /**
     * La llamada de atención del lanzador.
     *
     * Tres límites, y ninguno es cosmético:
     *
     *  · **Se para sola.** Dos tandas y se acabó. Una animación permanente
     *    sería la segunda del sitio que no para nunca —hoy solo lo hace el
     *    shader del hero— y un botón que no deja de moverse pasa de invitar a
     *    molestar en menos de un minuto.
     *  · **No vuelve si ya abriste el chat.** Quien ya sabe que está ahí no
     *    necesita que se lo recuerden; se guarda en la sesión, no para
     *    siempre, para que mañana vuelva a saludar.
     *  · **Con `prefers-reduced-motion` no ocurre nada.** No se acelera: no
     *    existe. Es la regla 4 del proyecto.
     *
     * Y espera 12 segundos: aparecer moviéndose nada más cargar compite con
     * lo que la persona vino a leer.
     */
    const YA_ABIERTO = 'panaclaw:chat-abierto';
    let llamadas = 0;

    function llamarLaAtencion() {
      if (!panel.hidden || sessionStorage.getItem(YA_ABIERTO)) return;
      toggle.classList.add('is-calling');
      // La clase se quita al terminar para que la siguiente tanda vuelva a
      // dispararla: reasignarla sin quitarla no reinicia una animación CSS.
      setTimeout(() => toggle.classList.remove('is-calling'), 3400);
      if (++llamadas < 2) setTimeout(llamarLaAtencion, 35000);
    }

    if (!reducido()) setTimeout(llamarLaAtencion, 12000);

    toggle.addEventListener('click', () => {
      if (panel.hidden) {
        try { sessionStorage.setItem(YA_ABIERTO, '1'); } catch {}
        toggle.classList.remove('is-calling');
        open();
      } else {
        close();
      }
    });
    closeBtn.addEventListener('click', () => close());
    backdrop.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    /* ------------------------------------------------------------------ *
     * Escritorio: mover y agrandar
     * ------------------------------------------------------------------ */

    const POS = 'panaclaw:chat-pos';
    const ANCHO = 'panaclaw:chat-grande';
    let dx = 0;
    let dy = 0;

    /** Mover solo tiene sentido con ratón y pantalla ancha; en teléfono es una hoja fija. */
    const puedeMover = () => !esMovil() && mq('(pointer: fine)');

    /** Deja el panel dentro de la ventana, sea cual sea la posición guardada. */
    function acotar() {
      const r = panel.getBoundingClientRect();
      const antes = { dx, dy };
      // `r` ya incluye el desplazamiento actual: se calcula el sobrante y se corrige.
      const m = 8;
      if (r.left < m) dx += m - r.left;
      if (r.right > window.innerWidth - m) dx -= r.right - (window.innerWidth - m);
      if (r.top < m) dy += m - r.top;
      if (r.bottom > window.innerHeight - m) dy -= r.bottom - (window.innerHeight - m);
      return antes.dx !== dx || antes.dy !== dy;
    }
    function pintarPosicion() {
      panel.style.transform = dx || dy ? `translate3d(${Math.round(dx)}px, ${Math.round(dy)}px, 0)` : '';
    }
    function aplicarPosicion() {
      if (panel.hidden) return;
      if (!puedeMover()) { panel.style.transform = ''; return; }
      pintarPosicion();
      if (acotar()) pintarPosicion();
    }
    try {
      const g = JSON.parse(leer(POS) || 'null');
      if (g && Number.isFinite(g.dx) && Number.isFinite(g.dy)) { dx = g.dx; dy = g.dy; }
    } catch {}

    let arrastre = null;
    head.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || e.target.closest('button, a')) return;
      if (puedeMover()) {
        arrastre = { x: e.clientX, y: e.clientY, dx, dy, tipo: 'mover' };
      } else if (esMovil()) {
        arrastre = { x: e.clientX, y: e.clientY, dy: 0, tipo: 'cerrar' };
      } else return;
      head.setPointerCapture(e.pointerId);
      panel.classList.add('is-arrastrando');
    });
    head.addEventListener('pointermove', (e) => {
      if (!arrastre) return;
      if (arrastre.tipo === 'mover') {
        dx = arrastre.dx + (e.clientX - arrastre.x);
        dy = arrastre.dy + (e.clientY - arrastre.y);
        pintarPosicion();
        if (acotar()) pintarPosicion();
      } else {
        arrastre.dy = Math.max(0, e.clientY - arrastre.y);
        panel.style.transform = `translate3d(0, ${arrastre.dy}px, 0)`;
      }
    });
    const soltar = () => {
      if (!arrastre) return;
      panel.classList.remove('is-arrastrando');
      if (arrastre.tipo === 'mover') {
        guardar(POS, JSON.stringify({ dx: Math.round(dx), dy: Math.round(dy) }));
      } else if (arrastre.dy > 90) {
        close(false);
      } else {
        panel.style.transform = '';
      }
      arrastre = null;
    };
    head.addEventListener('pointerup', soltar);
    head.addEventListener('pointercancel', soltar);
    // Doble clic en la cabecera: vuelve a su sitio.
    head.addEventListener('dblclick', (e) => {
      if (e.target.closest('button, a') || !puedeMover()) return;
      dx = 0; dy = 0; guardar(POS, null); pintarPosicion();
    });

    function fijarGrande(grande) {
      panel.classList.toggle('is-grande', grande);
      expandBtn.setAttribute('aria-pressed', String(grande));
      expandBtn.setAttribute('aria-label', grande ? 'Reducir el chat' : 'Agrandar el chat');
      guardar(ANCHO, grande ? '1' : null);
      requestAnimationFrame(aplicarPosicion);
    }
    expandBtn.addEventListener('click', () => fijarGrande(!panel.classList.contains('is-grande')));
    if (leer(ANCHO) === '1') fijarGrande(true);

    /* ------------------------------------------------------------------ *
     * La guía: a dónde llevar a cada quien
     * ------------------------------------------------------------------ */

    const quitarBarra = (r) => (r.length > 1 ? r.replace(/\/$/, '') : r);

    const esc = (t) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const ancla = (ruta, hash) => `${ruta}${hash}`;

    /** Los botones de acción: enlaces normales, para que funcionen también sin esta lógica. */
    function acciones(lista) {
      // Un botón que lleva a la página donde ya estás, sin sección concreta, no
      // lleva a ningún lado: se omite.
      const aqui = quitarBarra(location.pathname);
      lista = (lista || []).filter((a) => {
        try {
          const u = new URL(a.href, location.href);
          return u.origin !== location.origin || u.hash || quitarBarra(u.pathname) !== aqui;
        } catch {
          return true;
        }
      });
      if (!lista.length) return '';
      return lista
        .map((a, i) => {
          const externo = /^https?:/i.test(a.href);
          const extra = externo ? ' target="_blank" rel="noopener"' : '';
          return `<a class="chat-action${i === 0 ? ' is-main' : ''}" data-chat-ir href="${esc(a.href)}"${extra}>${esc(a.t)}</a>`;
        })
        .join('');
    }

    /** «Ayúdame a elegir»: qué necesita la persona → a dónde llevarla. Solo rutas, ninguna cifra. */
    const necesidades = [
      {
        t: 'Una web nueva',
        r: 'Los cuatro planes tienen precio y plazo publicados. Si prefieres que te lo calculemos, el cotizador lo hace en cuatro preguntas.',
        a: [{ t: 'Calcular mi precio', href: rutas.cotizador }, { t: 'Ver los 4 planes', href: ancla(rutas.planes, '#planes') }],
      },
      {
        t: 'Vender en línea',
        r: 'Para una tienda con carrito y cobros en línea existe un plan pensado para eso. Míralo con lo que incluye y lo que no.',
        a: [{ t: 'Ver los planes', href: ancla(rutas.planes, '#planes') }, { t: 'Calcular mi precio', href: rutas.cotizador }],
      },
      {
        t: 'Un agente de IA para WhatsApp',
        r: 'eBot es un agente de inteligencia artificial que conoce tu negocio y contesta por WhatsApp, Instagram, Messenger y Telegram.',
        a: [{ t: 'Conocer eBot', href: rutas.ebot }, { t: 'Ver el precio', href: ancla(rutas.ebot, '#precio') }],
      },
      {
        t: 'Proteger mi sitio',
        r: 'Revisamos el sitio que ya tienes, te decimos por dónde podrían entrar y lo cerramos.',
        a: [{ t: 'Ver Seguridad', href: rutas.seguridad }, { t: 'Cómo se revisa', href: ancla(rutas.seguridad, '#como') }],
      },
      {
        t: 'Ver trabajos reales',
        r: 'Cada tarjeta abre el sitio real, funcionando hoy. Míralo desde tu celular y cronométralo.',
        a: [{ t: 'Ver proyectos', href: rutas.proyectos }],
      },
      {
        t: 'No sé por dónde empezar',
        r: 'Está bien. Empieza por ver cómo trabajamos, o escríbenos y te orientamos.',
        a: [{ t: 'Cómo trabajamos', href: rutas.proceso }, { t: 'Hablar con una persona', href: whatsapp }],
      },
    ];

    function elegir() {
      quitarSugerencias();
      conversando = true;
      if (esTactil()) input.blur();
      const el = document.createElement('div');
      el.className = 'chat-msg is-bot';
      const p = document.createElement('p');
      p.textContent = 'Cuéntame qué necesitas y te llevo directo.';
      el.appendChild(p);
      const op = document.createElement('div');
      op.className = 'chat-opciones';
      necesidades.forEach((n, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chat-chip';
        b.dataset.chatNecesidad = String(i);
        b.textContent = n.t;
        op.appendChild(b);
      });
      el.appendChild(op);
      log.appendChild(el);
      verUltimo(el);
    }

    log.addEventListener('click', (e) => {
      const b = e.target.closest('[data-chat-necesidad]');
      if (!b) return;
      const n = necesidades[Number(b.dataset.chatNecesidad)];
      b.closest('.chat-opciones')?.remove();
      bubble(n.t, 'user');
      history.push({ role: 'user', content: n.t });
      history.push({ role: 'assistant', content: n.r });
      bubble(n.r, 'bot', acciones(n.a));
    });
    elegirBtn.addEventListener('click', elegir);

    /**
     * Preguntas de arranque según la página. Cada una se comprobó contra la
     * recuperación real del chat (devuelve el hecho que toca entre los dos
     * primeros). Si la página no está aquí, salen las de la portada.
     */
    const base = [
      '¿Cuánto cuesta un sitio?',
      '¿Tienen un agente de IA para WhatsApp?',
      '¿En cuánto tiempo lo entregan?',
      '¿El código es mío?',
    ];
    const porPagina = {
      [rutas.planes]: ['¿Qué planes tienen?', '¿Qué no incluye el precio?', '¿En cuánto tiempo lo entregan?'],
      [rutas.proyectos]: ['¿Cuánto cuesta un sitio?', '¿El código es mío?', '¿En cuánto tiempo lo entregan?'],
      [rutas.ebot]: ['¿Qué es eBot?', '¿Cuánto cuesta eBot?', '¿Qué pasa si el agente contesta mal?'],
      [rutas.seguridad]: ['¿Qué incluye la auditoría?', '¿Auditoría o mantenimiento?'],
      [rutas.servicios]: ['¿Qué incluye el mantenimiento?', '¿Cuánto cuesta un sitio?'],
      [rutas.cotizador]: ['¿Cómo funciona el cotizador?', '¿En cuánto tiempo lo entregan?'],
      [rutas.proceso]: ['¿En cuánto tiempo lo entregan?', '¿Cómo se paga?'],
    };
    const claves = Object.keys(porPagina);

    function contextualizar() {
      if (conversando || !suggestions) return;
      const aqui = quitarBarra(location.pathname);
      const k = claves.find((c) => quitarBarra(c) === aqui);
      const lista = k ? porPagina[k] : base;
      suggestions.textContent = '';
      lista.forEach((q) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chat-chip';
        b.dataset.chatSuggestion = q;
        b.textContent = q;
        suggestions.appendChild(b);
      });
      // Si ya estás en una de las páginas de los atajos, ese atajo sobra.
      guia.querySelectorAll('a[data-chat-ir]').forEach((a) => {
        const mismo = quitarBarra(new URL(a.href, location.href).pathname) === aqui;
        a.hidden = mismo;
      });
    }
    contextualizar();
    document.addEventListener('astro:page-load', contextualizar);

    /** Ir a una sección de ESTA página: desplazarse hasta ella y marcarla un instante. */
    function resaltar(el) {
      el.classList.remove('chat-destino');
      void el.offsetWidth; // reinicia la animación si ya la tenía
      el.classList.add('chat-destino');
      setTimeout(() => el.classList.remove('chat-destino'), 2000);
    }
    document.addEventListener('click', (e) => {
      const a = e.target.closest?.('[data-chat-ir]');
      if (!a || !root.contains(a) || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
      let url;
      try { url = new URL(a.href, location.href); } catch { return; }
      if (url.origin !== location.origin) { plegarEnMovil(); return; } // WhatsApp y demás: se abren aparte
      const mismaPagina = quitarBarra(url.pathname) === quitarBarra(location.pathname);
      const destino = url.hash ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
      if (mismaPagina && destino) {
        e.preventDefault();
        plegarEnMovil();
        // Un instante para que el chat termine de plegarse y no estorbe al desplazamiento.
        setTimeout(() => {
          destino.scrollIntoView({ behavior: reducido() ? 'auto' : 'smooth', block: 'start' });
          resaltar(destino);
        }, esMovil() ? 120 : 0);
      } else {
        plegarEnMovil();
      }
    });

    /* ------------------------------------------------------------------ *
     * La conversación
     * ------------------------------------------------------------------ */

    function verUltimo(el) {
      // Sin animación si la persona pidió menos movimiento.
      log.scrollTo({ top: log.scrollHeight, behavior: reducido() ? 'auto' : 'smooth' });
      return el;
    }

    function bubble(text, who, extraHtml) {
      const el = document.createElement('div');
      el.className = `chat-msg is-${who}`;
      const p = document.createElement('p');
      p.textContent = text;
      el.appendChild(p);
      if (extraHtml) {
        const extra = document.createElement('div');
        extra.className = 'chat-actions';
        extra.innerHTML = extraHtml;
        el.appendChild(extra);
      }
      log.appendChild(el);
      verUltimo(el);
      return el;
    }

    function thinking() {
      const el = document.createElement('div');
      el.className = 'chat-msg is-bot is-thinking';
      el.innerHTML = '<span></span><span></span><span></span>';
      el.setAttribute('aria-label', 'Escribiendo');
      log.appendChild(el);
      verUltimo(el);
      return el;
    }

    function quitarSugerencias() {
      suggestions?.remove();
      conversando = true;
    }

    /** Cuando no hay backend (GitHub Pages), el chat se vuelve un atajo útil. */
    function offlineAnswer() {
      return bubble(
        'El asistente aún no está conectado en esta versión del sitio. Te paso las dos vías rápidas:',
        'bot',
        acciones([{ t: 'Escríbenos por WhatsApp', href: whatsapp }, { t: 'Cotizar en 4 preguntas', href: rutas.cotizador }])
      );
    }

    async function ask(text) {
      if (busy || !text.trim()) return;
      busy = true;
      send.disabled = true;
      quitarSugerencias();

      bubble(text, 'user');
      history.push({ role: 'user', content: text });
      input.value = '';

      if (endpointDown) {
        offlineAnswer();
        busy = false;
        send.disabled = false;
        return;
      }

      const dots = thinking();
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-6) }),
        });

        // 404/405 = no hay función desplegada. 403 = el endpoint no reconoce
        // este origen (un navegador que no manda ni Origin ni Referer). En los
        // tres casos no hay nada que reintentar: pasamos a modo atajo.
        if (res.status === 404 || res.status === 405 || res.status === 403) {
          endpointDown = true;
          dots.remove();
          offlineAnswer();
          return;
        }

        const data = await res.json();
        dots.remove();
        const reply = data.reply || 'No pude responder eso.';
        history.push({ role: 'assistant', content: reply });

        // Los botones salen de lo que el servidor usó para contestar (a qué
        // página pertenece cada hecho). Si la respuesta habla del cotizador, ese
        // botón va primero.
        let lista = Array.isArray(data.acciones) ? data.acciones.slice(0, 3) : [];
        if (/cotizador|cuatro preguntas/i.test(reply) && !lista.some((a) => a.href === rutas.cotizador)) {
          lista = [{ t: 'Abrir el cotizador', href: rutas.cotizador }, ...lista].slice(0, 3);
        }
        bubble(reply, 'bot', acciones(lista));
      } catch {
        endpointDown = true;
        dots.remove();
        offlineAnswer();
      } finally {
        busy = false;
        send.disabled = false;
        // En pantalla táctil no se reabre el teclado solo: taparía la respuesta
        // que acaba de llegar. La persona vuelve a tocar el campo si sigue.
        if (!esTactil()) input.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });

    suggestions?.addEventListener('click', (e) => {
      const chip = e.target.closest('[data-chat-suggestion]');
      if (chip) ask(chip.dataset.chatSuggestion);
    });
  })();
</script>

<style>
