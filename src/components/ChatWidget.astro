---
import { waLink, site } from '../data/site';
import { routes } from '../data/links';

/**
 * Burbuja de chat.
 *
 * Dos decisiones que no son de estilo:
 *
 * 1. **Las sugerencias iniciales no son decorado.** Dirigen la conversación
 *    hacia preguntas que la base de conocimiento responde bien. En un modelo
 *    pequeño, encauzar la pregunta vale más que mejorar el prompt.
 *
 * 2. **Degrada a WhatsApp, no a un error.** En GitHub Pages no existe
 *    `/api/chat`; el widget lo detecta al primer intento y se convierte en un
 *    atajo a WhatsApp en vez de quedarse roto. Así el mismo código sirve en
 *    Pages hoy y en Netlify mañana.
 */
/*
 * La segunda es de eBot y va en ese sitio a propósito.
 *
 * Es el único producto del catálogo que nadie viene buscando: quien entra al
 * sitio busca una web, así que si el chat no lo nombra, no aparece en la
 * conversación jamás. Pero va SEGUNDA y no primera — el precio de un sitio
 * sigue siendo la pregunta que trae a la gente.
 *
 * Y va escrita como se pregunta («¿tienen bot para WhatsApp?»), no como se
 * llama el producto: quien no conoce el nombre no puede pulsar una pastilla que
 * diga «eBot». Comprobado contra la recuperación real de `_retrieval.mts` sobre
 * la base ya construida: devuelve `ebot-que-es` en primer lugar.
 */
const sugerencias = [
  '¿Cuánto cuesta un sitio?',
  '¿Tienen bot para WhatsApp?',
  '¿En cuánto tiempo lo entregan?',
  '¿El código es mío?',
  '¿Qué incluye el mantenimiento?',
];
---

<div class="chat" data-chat transition:persist="chat">
  {/*
    El aria-label repite la palabra que ya se lee al lado, y tiene que estar:
    debajo de 520 px la etiqueta visible se oculta con display:none y el botón
    se queda en icono puro, sin nombre accesible —un lector de pantalla anuncia
    "botón" y ya—. Lighthouse lo marcó el 22 ago 2026 solo en la pasada de
    móvil, por eso mismo.

    Dice exactamente "Asistente", el mismo texto visible, y no algo más
    descriptivo tipo "Abrir el asistente": si el nombre accesible no contiene al
    texto que se ve, quien maneja el sitio por voz dice lo que lee y no pasa
    nada (WCAG 2.5.3, y es el fallo que tenía la flecha del hero).
  */}
  <button
    class="chat-launcher"
    type="button"
    data-chat-toggle
    aria-label="Asistente"
    aria-expanded="false"
    aria-controls="chat-panel"
  >
    <span class="chat-launcher-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
      </svg>
    </span>
    <span class="chat-launcher-label">Asistente</span>
  </button>

  <section class="chat-panel" id="chat-panel" data-chat-panel hidden aria-label="Asistente de PanaClaw">
    <header class="chat-head">
      <div>
        <p class="chat-title">Asistente de {site.name}</p>
        <p class="chat-sub">Responde sobre planes, precios y plazos</p>
      </div>
      <button class="chat-close" type="button" data-chat-close aria-label="Cerrar el chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="chat-log" data-chat-log role="log" aria-live="polite" aria-atomic="false">
      <div class="chat-msg is-bot">
        <p>
          Pregúntame lo que quieras sobre planes, precios, plazos o cómo trabajamos.
          Si no lo sé, te paso con una persona.
        </p>
      </div>
      <div class="chat-suggestions" data-chat-suggestions>
        {sugerencias.map((s) => (
          <button type="button" class="chat-chip" data-chat-suggestion={s}>{s}</button>
        ))}
      </div>
    </div>

    <form class="chat-form" data-chat-form>
      <label class="visually-hidden" for="chat-input">Escribe tu pregunta</label>
      <input
        id="chat-input"
        type="text"
        name="q"
        placeholder="Escribe tu pregunta…"
        autocomplete="off"
        maxlength="500"
        data-chat-input
      />
      <button type="submit" class="chat-send" data-chat-send aria-label="Enviar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4 20-7Z" />
        </svg>
      </button>
    </form>

    <p class="chat-foot">
      Respuestas generadas a partir de la información del sitio.
      <a href={waLink()} target="_blank" rel="noopener">Hablar con una persona</a>
    </p>
  </section>
</div>

<script is:inline define:vars={{ whatsapp: waLink(), cotizador: routes.cotizador }}>
  (() => {
    const root = document.querySelector('[data-chat]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const panel = root.querySelector('[data-chat-panel]');
    const toggle = root.querySelector('[data-chat-toggle]');
    const closeBtn = root.querySelector('[data-chat-close]');
    const log = root.querySelector('[data-chat-log]');
    const form = root.querySelector('[data-chat-form]');
    const input = root.querySelector('[data-chat-input]');
    const send = root.querySelector('[data-chat-send]');
    const suggestions = root.querySelector('[data-chat-suggestions]');

    /** Historial que se manda al servidor. Corto: el backend re-recupera cada turno. */
    const history = [];
    let busy = false;
    let endpointDown = false;

    const open = () => {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      input.focus();
    };
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
      toggle.focus();
    };

    /**
     * La llamada de atención del lanzador.
     *
     * Tres límites, y ninguno es cosmético:
     *
     *  · **Se para sola.** Dos tandas y se acabó. Una animación permanente
     *    sería la segunda del sitio que no para nunca —hoy solo lo hace el
     *    shader del hero— y un botón que no deja de moverse pasa de invitar a
     *    molestar en menos de un minuto.
     *  · **No vuelve si ya abriste el chat.** Quien ya sabe que está ahí no
     *    necesita que se lo recuerden; se guarda en la sesión, no para
     *    siempre, para que mañana vuelva a saludar.
     *  · **Con `prefers-reduced-motion` no ocurre nada.** No se acelera: no
     *    existe. Es la regla 4 del proyecto.
     *
     * Y espera 12 segundos: aparecer moviéndose nada más cargar compite con
     * lo que la persona vino a leer.
     */
    const YA_ABIERTO = 'panaclaw:chat-abierto';
    let llamadas = 0;

    function llamarLaAtencion() {
      if (!panel.hidden || sessionStorage.getItem(YA_ABIERTO)) return;
      toggle.classList.add('is-calling');
      // La clase se quita al terminar para que la siguiente tanda vuelva a
      // dispararla: reasignarla sin quitarla no reinicia una animación CSS.
      setTimeout(() => toggle.classList.remove('is-calling'), 3400);
      if (++llamadas < 2) setTimeout(llamarLaAtencion, 35000);
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setTimeout(llamarLaAtencion, 12000);
    }

    toggle.addEventListener('click', () => {
      if (panel.hidden) {
        sessionStorage.setItem(YA_ABIERTO, '1');
        toggle.classList.remove('is-calling');
        open();
      } else {
        close();
      }
    });
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    function bubble(text, who, extraHtml) {
      const el = document.createElement('div');
      el.className = `chat-msg is-${who}`;
      const p = document.createElement('p');
      p.textContent = text;
      el.appendChild(p);
      if (extraHtml) {
        const extra = document.createElement('div');
        extra.className = 'chat-actions';
        extra.innerHTML = extraHtml;
        el.appendChild(extra);
      }
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function thinking() {
      const el = document.createElement('div');
      el.className = 'chat-msg is-bot is-thinking';
      el.innerHTML = '<span></span><span></span><span></span>';
      el.setAttribute('aria-label', 'Escribiendo');
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    /** Cuando no hay backend (GitHub Pages), el chat se vuelve un atajo útil. */
    function offlineAnswer() {
      return bubble(
        'El asistente aún no está conectado en esta versión del sitio. Te paso las dos vías rápidas:',
        'bot',
        `<a class="chat-action" href="${whatsapp}" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>` +
          `<a class="chat-action" href="${cotizador}">Cotizar en 4 preguntas</a>`
      );
    }

    async function ask(text) {
      if (busy || !text.trim()) return;
      busy = true;
      send.disabled = true;
      suggestions?.remove();

      bubble(text, 'user');
      history.push({ role: 'user', content: text });
      input.value = '';

      if (endpointDown) {
        offlineAnswer();
        busy = false;
        send.disabled = false;
        return;
      }

      const dots = thinking();
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-6) }),
        });

        // 404/405 = no hay función desplegada. 403 = el endpoint no reconoce
        // este origen (un navegador que no manda ni Origin ni Referer). En los
        // tres casos no hay nada que reintentar: pasamos a modo atajo.
        if (res.status === 404 || res.status === 405 || res.status === 403) {
          endpointDown = true;
          dots.remove();
          offlineAnswer();
          return;
        }

        const data = await res.json();
        dots.remove();
        const reply = data.reply || 'No pude responder eso.';
        history.push({ role: 'assistant', content: reply });

        const wantsQuote = /cotizador|cuatro preguntas/i.test(reply);
        bubble(
          reply,
          'bot',
          wantsQuote ? `<a class="chat-action" href="${cotizador}">Abrir el cotizador</a>` : ''
        );
      } catch {
        endpointDown = true;
        dots.remove();
        offlineAnswer();
      } finally {
        busy = false;
        send.disabled = false;
        input.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });

    suggestions?.addEventListener('click', (e) => {
      const chip = e.target.closest('[data-chat-suggestion]');
      if (chip) ask(chip.dataset.chatSuggestion);
    });
  })();
</script>

<style>
  .chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 120;
    font-size: 15px;
  }

  /* ---------- LANZADOR ---------- */
  .chat-launcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px 13px 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(9, 1, 1, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--soft-white);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55);
    transition: transform 0.22s, border-color 0.22s, background 0.22s;
  }
  .chat-launcher:hover {
    transform: translateY(-2px);
    border-color: var(--flash-orange);
  }
  .chat-launcher-icon {
    display: inline-flex;
    width: 20px;
    height: 20px;
    color: var(--flash-orange);
  }
  .chat-launcher-icon svg {
    width: 100%;
    height: 100%;
  }
  .chat.is-open .chat-launcher {
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- LLAMADA DE ATENCIÓN ---------- *
     Un halo que se expande y se apaga, más una vibración corta del botón.
     Las dos son `transform` y `opacity` y nada más: es la regla del sitio, y
     animar `box-shadow` obligaría a repintar en cada cuadro justo en la
     página que vende abrir en menos de un segundo. */
  .chat-launcher::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 999px;
    border: 1px solid var(--flash-orange);
    opacity: 0;
    pointer-events: none;
  }
  .chat-launcher.is-calling::after {
    animation: chat-halo 1.6s ease-out 2;
  }
  .chat-launcher.is-calling {
    animation: chat-vibra 1.6s ease-out 2;
  }
  @keyframes chat-halo {
    0% { opacity: 0.9; transform: scale(1); }
    70% { opacity: 0; transform: scale(1.28); }
    100% { opacity: 0; transform: scale(1.28); }
  }
  @keyframes chat-vibra {
    0%, 62%, 100% { transform: translate3d(0, 0, 0); }
    66% { transform: translate3d(-3px, 0, 0); }
    70% { transform: translate3d(3px, 0, 0); }
    74% { transform: translate3d(-2px, 0, 0); }
    78% { transform: translate3d(2px, 0, 0); }
    82% { transform: translate3d(0, 0, 0); }
  }

  /* ---------- PANEL ---------- */
  .chat-panel {
    position: absolute;
    right: 0;
    bottom: 0;
    /* El panel es un <section>, y la regla global `section{padding:120px 0}`
       de global.css le metía 120 px arriba y abajo. */
    padding: 0;
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 40px));
    height: min(560px, calc(100vh - 120px));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(12, 2, 2, 0.97);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }

  .chat-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 18px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }
  .chat-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--soft-white);
  }
  .chat-sub {
    margin-top: 3px;
    font-size: 13px;
    font-weight: 300;
    color: var(--studio-gray);
  }
  .chat-close {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: var(--studio-gray);
    cursor: pointer;
  }
  .chat-close svg {
    width: 15px;
    height: 15px;
  }
  .chat-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--soft-white);
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scrollbar-width: thin;
  }

  /*
    Las burbujas, los atajos y los puntos de "escribiendo" los crea el script,
    así que nacen sin el `data-astro-cid-*` de este componente y una regla con
    scope no los alcanza. Se cuelgan de `.chat-log`, que sí está en la
    plantilla, para que el alcance siga acotado al widget.
  */
  .chat-log :global(.chat-msg) {
    max-width: 88%;
    padding: 12px 15px;
    border-radius: 16px;
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.55;
  }
  .chat-log :global(.chat-msg.is-bot) {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.055);
    color: var(--soft-white);
    border-bottom-left-radius: 5px;
  }
  .chat-log :global(.chat-msg.is-user) {
    align-self: flex-end;
    background: var(--flash-orange);
    color: var(--deep-black);
    font-weight: 400;
    border-bottom-right-radius: 5px;
  }

  .chat-log :global(.chat-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .chat-log :global(.chat-action) {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid rgba(255, 81, 0, 0.5);
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--flash-orange);
  }
  .chat-log :global(.chat-action:hover) {
    background: rgba(255, 81, 0, 0.12);
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chat-chip {
    padding: 9px 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: transparent;
    color: var(--studio-gray);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .chat-chip:hover {
    border-color: var(--flash-orange);
    color: var(--soft-white);
  }

  .chat-log :global(.chat-msg.is-thinking) {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 15px;
  }
  .chat-log :global(.chat-msg.is-thinking span) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--studio-gray);
    animation: chat-dot 1.2s ease-in-out infinite;
  }
  .chat-log :global(.chat-msg.is-thinking span:nth-child(2)) { animation-delay: 0.15s; }
  .chat-log :global(.chat-msg.is-thinking span:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes chat-dot {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }

  .chat-form {
    display: flex;
    gap: 8px;
    padding: 12px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }
  .chat-form input {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--soft-white);
    font-family: inherit;
    font-size: 14.5px;
  }
  .chat-form input:focus {
    outline: none;
    border-color: var(--flash-orange);
  }
  .chat-form input::placeholder {
    color: rgba(255, 247, 247, 0.35);
  }
  .chat-send {
    flex-shrink: 0;
    width: 44px;
    border: none;
    border-radius: 12px;
    background: var(--flash-orange);
    color: var(--deep-black);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .chat-send svg {
    width: 17px;
    height: 17px;
  }
  .chat-send:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .chat-foot {
    padding: 0 16px 14px;
    font-size: 13px;
    font-weight: 300;
    color: rgba(186, 186, 186, 0.65);
    line-height: 1.5;
  }
  .chat-foot a {
    color: var(--flash-orange);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .chat {
      right: 14px;
      bottom: 14px;
    }
    .chat-launcher-label {
      display: none;
    }
    .chat-launcher {
      padding: 14px;
    }
    /*
      En teléfono el panel se ancla al viewport, no al lanzador.

      Antes era `position:absolute` dentro de `.chat` —que va desplazado
      `right:14px`— y encima pedía `width:calc(100vw - 28px)`. Dos medidas
      distintas decidiendo el mismo ancho: si `100vw` no coincide exactamente
      con el ancho útil, el panel se descuadra y se sale por la derecha. Es
      justo lo que pasaba en Safari de iOS, donde `100vw` no siempre mide lo
      que se ve; en Chromium no se reproducía.

      Con `left` y `right` fijados y `width:auto`, el ancho lo deriva el
      navegador del viewport real. No hay aritmética que pueda desajustarse.
    */
    .chat-panel {
      position: fixed;
      left: 14px;
      right: 14px;
      bottom: 14px;
      width: auto;
      /* dvh descuenta la barra de direcciones de Safari; vh queda de reserva
         para navegadores que no lo soporten. */
      height: min(72vh, 560px);
      height: min(72dvh, 560px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-launcher:hover { transform: none; }
    /* La llamada de atención se apaga entera, no se acelera. */
    .chat-launcher.is-calling,
    .chat-launcher.is-calling::after { animation: none; }
    .chat-log :global(.chat-msg.is-thinking span) { animation: none; opacity: 0.6; }
  }
</style>
