  }
  @keyframes chat-sube {
    from { transform: translate3d(0, 100%, 0); }
    to { transform: none; }
  }

  /* La sección a la que lleva un botón se marca un instante para que se vea dónde se llegó.
     Está en el global porque la sección es de otra página. */
  :global(.chat-destino) {
    animation: chat-destino 1.8s ease-out;
  }
  @keyframes chat-destino {
    0% { outline: 2px solid rgba(255, 81, 0, 0.9); outline-offset: -8px; }
    100% { outline: 2px solid rgba(255, 81, 0, 0); outline-offset: -8px; }
  }
  /* Con el chat abierto en teléfono la página de atrás no se mueve. */
  :global(html.chat-bloqueo) {
