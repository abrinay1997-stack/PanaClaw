---
import { navLinks } from '../data/services';
import { routes, withBase } from '../data/links';

interface Props {
  activePath?: string;
}

const { activePath = '' } = Astro.props;
---

<!--
  transition:persist mantiene el nav vivo entre navegaciones (no reconstruye el
  pill ni pierde el estado del menú). A cambio, el `aria-current` renderizado en
  el servidor se queda congelado en la primera página: el script lo re-sincroniza
  en cada `astro:page-load`.
-->
<header class="floating-nav" transition:persist="nav">
  <!-- Filtro de refracción del vidrio líquido (el de D'CASA): ruido que desplaza lo que pasa por detrás. -->
  <svg class="filtro-liquido" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="liquido" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.009 0.022" numOctaves="2" seed="7" result="ruido" />
      <feGaussianBlur in="ruido" stdDeviation="1.5" result="ruido_suave" />
      <feDisplacementMap in="SourceGraphic" in2="ruido_suave" scale="38" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <div class="nav-pill">
    {/*
      El avatar y el wordmark viajan juntos. El <img> se sirve del mismo
      public/favicon.svg que la pestaña — cuando la marca cambia, cambian los
      dos a la vez sin acordarse.
    */}
    <a href={routes.home} class="brand" aria-label="PanaClaw — inicio">
      <img src={withBase('favicon.svg')} alt="" width="28" height="28" class="brand-logo" />
      <span class="brand-name">PanaClaw<span class="dot">.</span></span>
    </a>

    <nav id="nav-principal" aria-label="Navegación principal">
      <ul class="nav-links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={activePath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!--
      El CTA global apunta al cotizador, no al formulario. Está en las 9 páginas:
      mandarlo a un formulario en frío obligaba a elegir plan antes de saber cuál
      encaja — justo la pregunta que la persona vino a resolver.
    -->
    <a href={routes.cotizador} class="nav-cta" aria-current={activePath === routes.cotizador ? 'page' : undefined}>
      Cotizar
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-principal"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  function closeMenu(pill: HTMLElement, toggle: HTMLButtonElement) {
    pill.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menú');
  }

  /**
   * El nav sobrevive a las navegaciones (transition:persist), así que sus
   * listeners también. Sin este guard, cada `astro:page-load` engancharía otro
   * click y el menú se abriría y cerraría en el mismo toque.
   */
  function initNavToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const pill = document.querySelector<HTMLElement>('.nav-pill');
    if (!toggle || !pill) return;

    if (!toggle.dataset.bound) {
      toggle.dataset.bound = 'true';

      bindShrinkOnScroll();

      toggle.addEventListener('click', () => {
        const open = pill.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      });

      // Cerrar al navegar o al escapar
      pill.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.nav-links a, .nav-cta, .brand')) {
          closeMenu(pill, toggle);
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && pill.classList.contains('is-open')) {
          closeMenu(pill, toggle);
          toggle.focus();
        }
      });
    }

    closeMenu(pill, toggle);
    syncCurrent();
    initLiquido();
    initGota();
    // Tras una navegación con View Transitions el scroll vuelve a 0 pero el nav
    // persiste, así que hay que reevaluar su tamaño en cada page-load.
    syncShrink();
  }

  /**
   * Vidrio líquido: solo donde `backdrop-filter: url()` funciona (Chromium). La referencia
   * va por una variable puesta aquí y no escrita en el CSS: el empaquetador reescribiría
   * `url(#liquido)` como una ruta de archivo y el filtro no se aplicaría. El ruido se
   * mueve lento (el vidrio «fluye»), en pausa con la pestaña oculta y sin movimiento si
   * la persona pidió reducirlo.
   */
  function initLiquido() {
    const filtro = document.querySelector<SVGSVGElement>('.filtro-liquido');
    const ruido = filtro?.querySelector('feTurbulence');
    if (!filtro || !ruido || filtro.dataset.listo) return;
    filtro.dataset.listo = '1';
    const chromium = (navigator as unknown as { userAgentData?: { brands?: { brand: string }[] } }).userAgentData?.brands?.some(
      (b) => b.brand === 'Chromium',
    );
    if (!chromium || !window.CSS?.supports?.('backdrop-filter', 'url(#a)')) return;
    document.documentElement.style.setProperty('--refraccion', 'url(#liquido) blur(3px) saturate(220%) brightness(1.08)');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const anim = document.createElementNS('http://www.w3.org/2000/svg', 'animate');
    anim.setAttribute('attributeName', 'baseFrequency');
    anim.setAttribute('dur', '18s');
    anim.setAttribute('repeatCount', 'indefinite');
    anim.setAttribute('values', '0.009 0.022;0.012 0.018;0.009 0.022');
    ruido.appendChild(anim);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) filtro.pauseAnimations();
      else filtro.unpauseAnimations();
    });
  }

  /** La gota: una burbuja de vidrio que se desliza con rebote hasta el enlace bajo el puntero o con el foco. */
  function initGota() {
    const nav = document.querySelector<HTMLElement>('#nav-principal');
    if (!nav) return;
    let gota = nav.querySelector<HTMLElement>('.nav-gota');
    const enlaces = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.nav-links a'));
    const activo = () => nav.querySelector<HTMLAnchorElement>('.nav-links a[aria-current="page"]');
    if (!gota) {
      gota = document.createElement('span');
      gota.className = 'nav-gota';
      gota.setAttribute('aria-hidden', 'true');
      nav.prepend(gota);
    }
    const g = gota;
    const moverA = (a: HTMLElement | null) => {
      if (!a) { g.classList.remove('is-visible'); return; }
      const caja = nav.getBoundingClientRect();
      const r = a.getBoundingClientRect();
      g.style.setProperty('--gota-x', `${r.left - caja.left}px`);
      g.style.setProperty('--gota-y', `${r.top - caja.top}px`);
      g.style.setProperty('--gota-ancho', `${r.width}px`);
      g.style.setProperty('--gota-alto', `${r.height}px`);
      g.classList.add('is-visible');
    };
    if (!nav.dataset.gotaLista) {
      nav.dataset.gotaLista = '1';
      enlaces.forEach((a) => {
        a.addEventListener('mouseenter', () => moverA(a));
        a.addEventListener('focus', () => moverA(a));
      });
      nav.addEventListener('mouseleave', () => moverA(activo()));
      nav.addEventListener('focusout', (e) => { if (!nav.contains(e.relatedTarget as Node)) moverA(activo()); });
      window.addEventListener('resize', () => moverA(activo()));
      document.fonts?.ready.then(() => moverA(activo()));
      // Al encoger o ensanchar el menú (bajar o subir) los enlaces se reacomodan: la gota los sigue.
      if ('ResizeObserver' in window) new ResizeObserver(() => { if (!nav.matches(':hover') && !nav.contains(document.activeElement)) moverA(activo()); }).observe(nav);
    }
    requestAnimationFrame(() => moverA(activo()));
  }

  /**
   * Encoge el nav al bajar y lo devuelve a su tamaño al volver al tope.
   * La histéresis (40 px para encoger, 12 px para volver) evita el parpadeo
   * cuando el scroll se queda oscilando justo en el umbral.
   */
  function syncShrink() {
    const header = document.querySelector<HTMLElement>('.floating-nav');
    if (!header) return;
    const y = window.scrollY;
    const shrunk = header.classList.contains('is-scrolled');
    if (!shrunk && y > 40) header.classList.add('is-scrolled');
    else if (shrunk && y < 12) header.classList.remove('is-scrolled');
  }

  function bindShrinkOnScroll() {
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          syncShrink();
        });
      },
      { passive: true }
    );
  }

  /**
   * Marca el enlace de la página actual. Normaliza los dos extremos —quita un
   * `.html` heredado y la barra final— para comparar formas equivalentes de la
   * misma ruta: así sigue acertando aunque alguien llegue por una URL vieja.
   */
  function syncCurrent() {
    const here = location.pathname.replace(/\.html$/, '').replace(/\/$/, '');
    document.querySelectorAll<HTMLAnchorElement>('.nav-links a, .nav-cta').forEach((a) => {
      const target = new URL(a.href).pathname.replace(/\.html$/, '').replace(/\/$/, '');
      if (target === here) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', initNavToggle);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavToggle, { once: true });
  } else {
    initNavToggle();
  }
</script>
