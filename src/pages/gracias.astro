---
import Icono from '../components/Icono.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { waLink } from '../data/site';
import { routes } from '../data/links';

/**
 * A esta página se llega por DOS caminos, no por uno: el formulario de
 * /contacto y, desde hoy, el final del cotizador. Por eso el texto no puede
 * nombrar ninguno de los dos —«acabo de enviar el formulario» le sonaba a chino
 * a quien acaba de mandar su cotización por WhatsApp—, y por eso importa que
 * los dos pasen por aquí: es el único punto del sitio donde el píxel cuenta un
 * `Lead`.
 */
---

<BaseLayout
  title="Gracias"
  description="Mensaje recibido. PanaClaw te responde en menos de 24 horas."
  noindex={true}
>
  <section class="simple-page">
    <div class="simple-inner">
      <span class="simple-tag">Mensaje recibido</span>
      <h1>Gracias. <br /><span style="color:var(--flash-orange);">Te escribimos pronto.</span></h1>
      <p>
        Ya llegó tu mensaje. Te respondemos en menos de 24 horas con una propuesta escrita: alcance,
        cronograma y precio. Si prefieres cerrar antes, escríbenos directo por WhatsApp.
      </p>
      <div class="simple-actions">
        <a
          class="btn btn-primary"
          href={waLink('Hola PanaClaw, acabo de escribirles desde el sitio')}
          target="_blank"
          rel="noopener"
        >
          <Icono nombre="whatsapp" /> Ir a WhatsApp
        </a>
        <a class="btn btn-ghost" href={routes.home}>Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>
