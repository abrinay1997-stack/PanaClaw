---
import Icono from '../components/Icono.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { Image } from 'astro:assets';
import SceneBg from '../components/SceneBg.astro';

import { projects, publishedMetrics } from '../data/projects';
import { sceneVisuals } from '../data/images';
import { routes } from '../data/links';
import { site, waLink } from '../data/site';

/**
 * La página que le faltaba al sitio.
 *
 * Todo lo demás son promesas escritas por quien cobra: los plazos, la velocidad,
 * el precio cerrado. Esta es la única donde el visitante puede ir a comprobarlo
 * él mismo, y por eso cada tarjeta enlaza al sitio en vivo en lugar de a una
 * ficha interna. Mandarle a un caso de estudio propio sería pedirle que vuelva a
 * creernos; mandarle al dominio del cliente es dejar que lo verifique.
 *
 * Mientras las fichas no tengan métricas medidas, la página no habla de
 * velocidad. Prometerla aquí sin la cifra al lado sería el mismo humo que el
 * sitio critica en las agencias.
 */
const origin = Astro.site ?? new URL('http://localhost:4321');
// Cada columna del muro empieza en un sitio distinto y se repite dos veces para que el bucle no tenga costura.
const conCaptura = projects.filter((p) => p.image);
const columnas = [0, 1, 2].map((k) => {
  const giro = [...conCaptura.slice(k * 2), ...conCaptura.slice(0, k * 2)];
  return [...giro, ...giro];
});
const anyMeasured = projects.some((p) => publishedMetrics(p).length > 0);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Proyectos — ${site.name}`,
  description: `Sitios publicados por ${site.name} en ${site.location}.`,
  url: new URL(routes.proyectos, origin).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: project.name,
      url: project.url,
    })),
  },
};
---

<BaseLayout
  title="Proyectos web publicados en Panamá"
  description={`Sitios que hemos construido y están en línea hoy. Cada uno enlaza a su dominio para que compruebes tú mismo cómo carga. ${site.name}, ${site.location}.`}
  activePath={routes.proyectos}
  jsonLd={[itemListSchema]}
>
  <!-- HERO: texto a la izquierda, muro de capturas reales a la derecha -->
  <section class="hero hero-short proy-hero">
    <div class="container hero-inner proy-hero-inner">
      <span class="year">Proyectos · {projects.length} sitios en línea</span>
      <div class="proy-hero-copy">
        <Reveal eager>
          <h1>No te lo contamos. <span class="muted">Ábrelos.</span></h1>
        </Reveal>
        <Reveal delay={0.15} eager>
          <p class="lead">
            Todo lo demás en este sitio son promesas nuestras. Esto es lo único que puedes
            comprobar sin fiarte de nadie: cada sitio abre en vivo, funcionando hoy. Míralo
            desde tu celular y cronométralo si quieres.
          </p>
        </Reveal>
        <Reveal delay={0.25} eager>
          <div class="proy-hero-actions">
            <a class="btn btn-primary" href="#trabajo">
              <Icono nombre="ojo" />
              Ver los {projects.length} sitios
            </a>
            <a class="btn btn-ghost" href={routes.cotizador}>Quiero el mío</a>
          </div>
        </Reveal>
      </div>
    </div>

    <!-- Decorativo: los mismos sitios de la galería, repetidos para que el bucle no tenga costura. -->
    <div class="muro" aria-hidden="true">
      {[0, 1, 2].map((col) => (
        <div class="muro-col" data-col={col}>
          {columnas[col].map((project) => (
            <Image
              src={project.image!}
              alt=""
              widths={[320, 520]}
              sizes="(max-width: 900px) 40vw, 22vw"
              format="webp"
              quality={60}
              loading="eager"
              decoding="async"
            />
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- GALERÍA: una pantalla, un sitio a la vez -->
  <section class="galeria" id="trabajo" aria-labelledby="trabajo-title">
    <div class="container galeria-head">
      <h2 id="trabajo-title">Sitios publicados <span class="muted">· ábrelos</span></h2>
      <div class="galeria-ctrl">
        <span class="galeria-count" data-galeria-count aria-live="polite">1 / {projects.length}</span>
        <button type="button" class="galeria-btn" data-galeria="-1" aria-label="Sitio anterior">←</button>
        <button type="button" class="galeria-btn" data-galeria="1" aria-label="Sitio siguiente">→</button>
      </div>
    </div>
    <ul class="galeria-pista" data-galeria-pista tabindex="0" aria-label="Galería de sitios publicados">
      {projects.map((project, i) => (
        <li class="galeria-slide" data-slide={i}>
          <a href={project.url} target="_blank" rel="noopener" class="galeria-marco"
             aria-label={`Abrir ${project.domain} en una pestaña nueva`}>
            <div class="galeria-barra" aria-hidden="true"><i></i><i></i><i></i><span>{project.domain}</span></div>
            {project.image && (
              <Image
                src={project.image}
                alt={`Captura de la portada de ${project.domain}`}
                widths={[640, 1000, 1400]}
                sizes="(max-width: 900px) 86vw, 70vw"
                format="webp"
                quality={78}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
          </a>
          <div class="galeria-pie">
            <div>
              <h3>{project.name}</h3>
              <p>{[project.sector, project.summary].filter(Boolean).join(' · ') || project.domain}</p>
            </div>
            <a class="btn btn-ghost" href={project.url} target="_blank" rel="noopener">Abrir el sitio ↗</a>
          </div>
        </li>
      ))}
    </ul>
    {anyMeasured && (
      <p class="proyectos-nota container">
        Las cifras las mide Google, con su propia prueba de velocidad y sobre el sitio en vivo,
        tal como lo carga un celular. Cada una lleva al lado la fecha en que se tomó.
      </p>
    )}
  </section>

  <!-- CIERRE -->
  <section class="proyectos-cta">
    <SceneBg visual={sceneVisuals.interfaz} side="center" dim={0.34} />
    <div class="container">
      <Reveal>
        <h2>¿El tuyo es el siguiente?</h2>
        <p>
          Dinos qué necesitas y te decimos el precio y la fecha. Sin llamadas de venta y sin
          «consultar por interno».
        </p>
        <div class="proyectos-cta-actions">
          <a class="btn btn-primary" href={routes.cotizador}>
            <Icono nombre="calculadora" /> Calcular mi precio
          </a>
          <a
            class="btn btn-ghost"
            href={waLink('Hola PanaClaw, vi sus proyectos y quiero cotizar el mío')}
            target="_blank"
            rel="noopener"
          >
            Hablar por WhatsApp
          </a>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO CON MURO ---------- */
  .proy-hero-copy { max-width: 46ch; position: relative; z-index: 2; }
  .proy-hero-actions :global(.ico) { color: var(--flash-orange); flex: none; }
  .proy-hero-actions { display: flex; gap: var(--e2); flex-wrap: wrap; margin-top: var(--e4); }
  .muro {
    position: absolute; z-index: 1; top: -8%; right: -6%;
    width: 58%; height: 116%;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e2);
    transform: rotate(-9deg);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 28%, #000 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 28%, #000 100%);
    opacity: .9;
    pointer-events: none;
  }
  .muro-col { display: flex; flex-direction: column; gap: var(--e2); animation: muro-sube 46s linear infinite; }
  .muro-col[data-col="1"] { animation-direction: reverse; animation-duration: 58s; margin-top: calc(var(--e4) * -1); }
  .muro-col[data-col="2"] { animation-duration: 52s; margin-top: var(--e3); }
  .muro :global(img) {
    width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; object-position: top;
    border-radius: 10px; border: 1px solid rgba(255, 255, 255, .12);
    box-shadow: 0 18px 40px rgba(0, 0, 0, .55);
  }
  @keyframes muro-sube { from { transform: translateY(0); } to { transform: translateY(-50%); } }

  /* ---------- GALERÍA ---------- */
  .galeria { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: var(--e6) 0 var(--e5); border-top: 1px solid rgba(255, 255, 255, .06); }
  .galeria-head { display: flex; align-items: end; justify-content: space-between; gap: var(--e2) var(--e3); flex-wrap: wrap; margin-bottom: var(--e3); }
  .galeria-head h2 { font-size: clamp(28px, 4vw, 52px); font-weight: 600; letter-spacing: -.02em; text-transform: uppercase; line-height: 1.02; }
  .galeria-head h2 .muted { color: var(--studio-gray); }
  .galeria-ctrl { display: flex; align-items: center; gap: var(--e1); flex: none; }
  .galeria-count { font-size: 14px; letter-spacing: .12em; color: var(--studio-gray); margin-right: var(--e1); }
  .galeria-btn {
    width: 48px; height: 48px; border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(255, 255, 255, .3); background: transparent; color: var(--soft-white);
    font: inherit; font-size: 18px; transition: border-color .2s, color .2s;
  }
  .galeria-btn:hover { border-color: var(--flash-orange); color: var(--flash-orange); }
  .galeria-btn:focus-visible { outline: 2px solid var(--flash-orange); outline-offset: 3px; }
  .galeria-pista {
    list-style: none; margin: 0; padding: 0 max(var(--e3), calc((100vw - 1240px) / 2));
    display: flex; gap: var(--e3);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: max(var(--e3), calc((100vw - 1240px) / 2));
    scrollbar-width: none; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain;
  }
  .galeria-pista::-webkit-scrollbar { display: none; }
  .galeria-slide { flex: 0 0 min(86vw, 980px); scroll-snap-align: start; }
  .galeria-marco {
    display: block; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .14); background: #0c0202;
    transition: border-color .25s, transform .35s;
  }
  .galeria-marco:hover { border-color: var(--flash-orange); transform: translateY(-4px); }
  .galeria-barra { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: #160404; border-bottom: 1px solid rgba(255, 255, 255, .08); }
  .galeria-barra i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, .2); }
  .galeria-barra span { margin-left: var(--e1); font-size: 13px; color: var(--studio-gray); letter-spacing: .04em; }
  .galeria-marco :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; object-position: top; }
  .galeria-pie { display: flex; align-items: center; justify-content: space-between; gap: var(--e3); padding-top: var(--e2); }
  .galeria-pie h3 { font-size: clamp(20px, 2.4vw, 30px); font-weight: 600; letter-spacing: -.01em; }
  .galeria-pie .btn { white-space: nowrap; flex: none; }
  .galeria-pie p { font-size: 15px; font-weight: 300; color: var(--studio-gray); margin-top: 4px; }
  .proyectos-nota {
    margin-top: var(--e3);
    max-width: 68ch;
    font-size: 14px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
  }

  /* ---------- CIERRE ---------- */
  .proyectos-cta {
    position: relative;
    overflow: hidden;
    padding: var(--e6) 0;
    text-align: center;
  }
  .proyectos-cta .container {
    position: relative;
    z-index: 1;
  }
  .proyectos-cta h2 {
    font-size: clamp(34px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .proyectos-cta p {
    margin: var(--e3) auto 0;
    max-width: 52ch;
    font-size: 17px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }
  .proyectos-cta-actions {
    display: flex;
    gap: var(--e2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--e4);
  }

  @media (max-width: 900px) {
    /* En el celular el fondo animado sobra: el titular y el botón mandan. */
    .muro { display: none; }
    .proy-hero { justify-content: center; }
    .galeria-pie { flex-direction: column; align-items: flex-start; gap: var(--e2); }
    .galeria-head h2 { font-size: 26px; }
  }
</style>

<style>
  @media (prefers-reduced-motion: reduce) { .muro-col { animation: none !important; } }
</style>

<script>
  function iniciar() {
    const pista = document.querySelector<HTMLElement>('[data-galeria-pista]');
    if (!pista || pista.dataset.listo) return;
    pista.dataset.listo = '1';
    const cuenta = document.querySelector('[data-galeria-count]');
    const slides = Array.from(pista.children) as HTMLElement[];
    // Posición de cada diapositiva dentro de la pista; la actual es la más cercana a lo desplazado.
    const pos = () => slides.map((el) => el.offsetLeft - slides[0].offsetLeft);
    const actual = () => {
      const p = pos();
      let mejor = 0;
      p.forEach((v, i) => { if (Math.abs(v - pista.scrollLeft) < Math.abs(p[mejor] - pista.scrollLeft)) mejor = i; });
      return mejor;
    };
    const pintar = () => { if (cuenta) cuenta.textContent = `${actual() + 1} / ${slides.length}`; };
    const ir = (d: number) => {
      const i = Math.min(slides.length - 1, Math.max(0, actual() + d));
      pista.scrollTo({ left: pos()[i], behavior: 'smooth' });
    };
    document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((b) =>
      b.addEventListener('click', () => ir(Number(b.dataset.galeria))));
    pista.addEventListener('scroll', pintar, { passive: true });
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); ir(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); ir(-1); }
    });
  }
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>
