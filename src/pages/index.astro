---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import HeroShader from '../components/HeroShader.astro';
import SceneBg from '../components/SceneBg.astro';

import { site, waLink } from '../data/site';
import { plans } from '../data/plans';
import { ebot } from '../data/ebot';
import { seguridad, revision } from '../data/seguridad';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { procesoVisual } from '../data/images';
import { routes } from '../data/links';
---

<BaseLayout
  title={`${site.name} — ${site.tagline} ${site.location}.`}
  description={site.description}
  activePath={routes.home}
>
  <!-- HERO CINEMÁTICO -->
  <section class="hero hero-cinematic" id="top">
    <HeroShader />

    <div class="container hero-inner">
      <Reveal y={50}>
        <h1 class="hero-title">
          Sitios que <span class="ember">encienden</span>.<br />
          Código <span class="ember">tuyo</span>.
        </h1>
      </Reveal>
      <Reveal delay={0.2}>
        <p class="hero-lead">
          Webs que abren en menos de un segundo, listas en días y que quedan a tu nombre —
          no al nuestro. Desde $295, en {site.location}.
        </p>
      </Reveal>
      <!--
        La acción principal de la home es cotizar, no «ver planes».

        Las dos llevan al precio, pero por caminos muy distintos: /planes enseña
        cuatro cifras y deja al visitante decidiendo solo; el cotizador le da SU
        cifra en cuatro respuestas y termina en un mensaje ya redactado. Es el
        camino que mejor convierte del sitio (está medido en el bloque 6) y hasta
        ahora la portada no lo ofrecía ni una vez: solo lo llevaba el botón del
        nav. Los cuatro precios siguen abajo, a un scroll.
      -->
      <Reveal delay={0.35}>
        <div class="hero-actions">
          <a class="btn btn-primary" href={routes.cotizador}>
            <span class="dot"></span> Cotizar mi sitio
          </a>
          <a class="btn btn-ghost" href={waLink()} target="_blank" rel="noopener">
            Hablar por WhatsApp
          </a>
        </div>
      </Reveal>
    </div>

    <a class="hero-scroll-cue" href="#servicios" aria-label="Ver servicios">
      <span>Scroll</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!--
    PRUEBA, antes que el discurso.

    Es lo primero que aparece tras el hero porque es lo único de la home que el
    visitante puede verificar sin fiarse de nosotros. Van los dominios y no unos
    logos: un logo se dibuja, un dominio se abre.
  -->
  <section class="proof" aria-labelledby="proof-title">
    <div class="container">
      <div class="proof-inner">
        <span class="eyebrow" id="proof-title">Trabajo publicado</span>
        <!--
          Los dominios van en texto, no enlazados, y es deliberado.
          Enlazados eran cuatro salidas a sitios ajenos en la primera pantalla
          de la portada, sin ninguna vuelta: el visitante se iba a bukoflow y la
          visita terminaba ahí. Siguen escritos porque un dominio se puede
          teclear y comprobar —que es el argumento entero de esta banda—, pero
          la puerta para abrirlos es /proyectos, donde cada ficha ya tiene su
          camino de regreso.
        -->
        <ul class="proof-list">
          {projects.map((project) => <li>{project.domain}</li>)}
        </ul>
        <a class="proof-link" href={routes.proyectos}>
          Ábrelos uno a uno <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PREVIEW SERVICIOS -->
  <section class="services" id="servicios">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Servicios</span>
          <Reveal>
            <h2 class="section-title">Tres pilares. <span class="muted">Cero atajos.</span></h2>
          </Reveal>
        </div>
        <Reveal delay={0.15}>
          <a class="section-link" href={routes.servicios}>
            Ver todo <span aria-hidden="true">→</span>
          </a>
        </Reveal>
      </div>
      <!--
        Las tres tarjetas ya NO son enlaces. Las tres llevaban a la misma
        página que el «Ver todo» de arriba, así que eran cuatro clics para un
        solo destino: cuatro acciones contadas, una decisión real. Son un
        argumento —el porqué—, y un argumento no necesita ser un botón.
      -->
      <div class="service-list">
        {services.map((s) => (
          <Reveal>
            <div class="service-card">
              <span class="idx">{s.idx}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- PREVIEW PLANES -->
  <section class="planes-preview">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Planes</span>
          <Reveal>
            <h2 class="section-title">Precios fijos. <span class="muted">Cero letra chica.</span></h2>
          </Reveal>
        </div>
        <!--
          Sin «Ver planes en detalle» aquí: las cuatro tarjetas de abajo ya
          llevan al mismo sitio, y un quinto enlace al mismo destino no añade
          un camino, añade ruido.
        -->
      </div>
      <div class="plans-preview-grid">
        {plans.map((plan) => (
          <Reveal>
            <a class="plan-mini" href={routes.planes} data-featured={plan.featured}>
              {plan.featured && <span class="plan-mini-badge">Recomendado</span>}
              <div class="plan-mini-name">{plan.name.replace('PanaClaw ', '')}</div>
              <div class="plan-mini-price">{plan.price}</div>
              <div class="plan-mini-delivery">{plan.delivery}</div>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!--
    NO SOLO WEBS.

    eBot y Seguridad llevaban meses existiendo sin aparecer en la portada: solo
    estaban en la barra, en el pie y en el chat, así que quien entraba por aquí y
    no miraba el menú no se enteraba de que existen. Y son justo los dos
    productos que nadie viene buscando —quien llega busca una web—, o sea los que
    más dependen de que la portada los nombre.

    Van después de los planes a propósito: primero lo que trae a la gente, y
    cuando ya tiene el precio de su sitio en la cabeza, lo que puede sumarle.
  -->
  <section class="extras">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Y además</span>
          <Reveal>
            <h2 class="section-title">No solo hacemos webs. <span class="muted">Esto también.</span></h2>
          </Reveal>
        </div>
        <!--
          Sin enlace de sección: las dos tarjetas ya son los dos destinos, y el
          «Ver todo →» de los pilares, tres secciones más arriba, lleva a la
          misma página. Dos enlaces al mismo sitio en una portada que ya tenía
          diecisiete acciones es exactamente lo que se está quitando.
        -->
      </div>

      <div class="extras-grid">
        <Reveal>
          <a class="extra" href={routes.ebot}>
            <span class="extra-k">{ebot.name}</span>
            <span class="extra-price">{ebot.price}</span>
            <p>{ebot.tagline} Contesta por WhatsApp, Instagram, Messenger y Telegram a cualquier hora, con un panel donde ves cada conversación.</p>
            <span class="extra-go" aria-hidden="true">→</span>
          </a>
        </Reveal>
        <Reveal delay={0.1}>
          <a class="extra" href={routes.seguridad}>
            <span class="extra-k">{seguridad.name}</span>
            <span class="extra-price">Desde {revision.price.split('–')[0]}</span>
            <p>{seguridad.tagline} Revisamos el sitio que ya tienes, te decimos por dónde podrían entrar y lo cerramos.</p>
            <span class="extra-go" aria-hidden="true">→</span>
          </a>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ARGUMENTO, sobre la textura líquida -->
  <section class="quote">
    <SceneBg visual={procesoVisual} side="center" dim={0.38} />
    <div class="container">
      <Reveal>
        <blockquote>
          Tu competencia sale en Google.<br />
          <span class="muted">Tú sales en un perfil de Instagram.</span>
        </blockquote>
        <div class="cite">
          Cada día sin sitio propio es un cliente que buscó lo que vendes y encontró a otro.
        </div>
      </Reveal>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- HERO CINEMÁTICO ---------- */
  .hero-cinematic {
    position: relative;
    min-height: 100vh;
    height: 100vh;
    max-height: 1080px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 100px 0 60px;
    overflow: hidden;
  }
  .hero-cinematic .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1280px;
  }
  .hero-title {
    font-size: clamp(52px, 9vw, 132px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: none;
    max-width: 18ch;
    color: var(--soft-white);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }
  /* El acento del titular es el naranja de marca. El rojo ember queda para el
     shader del fondo: dos rojos compitiendo aplanaban toda la escena. */
  .hero-title .ember {
    color: var(--flash-orange);
    font-style: italic;
    font-weight: 700;
    text-shadow: 0 0 40px rgba(255, 81, 0, 0.35);
  }
  .hero-lead {
    margin-top: 30px;
    max-width: 54ch;
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.5;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 44px;
    flex-wrap: wrap;
  }

  /* Scroll indicator */
  .hero-scroll-cue {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--studio-gray);
    padding: 8px 12px;
  }
  .hero-scroll-cue:hover {
    color: var(--soft-white);
  }
  .hero-scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    top: -36px;
    left: 0;
    width: 100%;
    height: 36px;
    background: linear-gradient(to bottom, transparent, var(--ember-red), transparent);
    animation: scroll-cue 2.2s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% { transform: translateY(0); }
    100% { transform: translateY(72px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after { animation: none; opacity: 0.4; }
  }

  /* Ocultar el gradiente CSS antiguo (lo reemplaza el shader) */
  .hero-cinematic::after {
    display: none !important;
  }

  /* ---------- BANDA DE PRUEBA ---------- */
  .proof {
    padding: 34px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.015);
  }
  .proof-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 30px;
  }
  .proof .eyebrow {
    margin: 0;
    flex-shrink: 0;
  }
  .proof-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 26px;
    list-style: none;
    flex: 1;
  }
  /* Los dominios ya no son enlaces (ver el comentario de la plantilla), así que
     tampoco necesitan objetivo táctil: son texto. El aire vertical se queda
     porque la banda se lee mejor con él. */
  .proof-list li {
    padding-block: 6px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--studio-gray);
  }
  .proof-link {
    display: inline-block;
    padding-block: 6px;
    flex-shrink: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
    white-space: nowrap;
  }
  .proof-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---------- RESTO DE LA HOME ---------- */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }
  .section-head h2.section-title { margin-bottom: 0; }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
    padding: 12px 20px;
    border: 1px solid rgba(255, 81, 0, 0.4);
    border-radius: 999px;
    transition: background 0.25s, border-color 0.25s;
    white-space: nowrap;
  }
  .section-link:hover {
    background: rgba(255, 81, 0, 0.1);
    border-color: var(--flash-orange);
  }
  /* Ya no es un enlace: bloque, sin cursor de mano. */
  .service-card { display: block; }

  /* ---------- NO SOLO WEBS ---------- */
  .extras {
    padding-top: 0;
  }
  .extras-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .extra {
    position: relative;
    display: block;
    height: 100%;
    padding: 34px 30px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
  }
  .extra:hover {
    border-color: var(--flash-orange);
    background: rgba(255, 81, 0, 0.05);
    transform: translateY(-4px);
  }
  .extra-k {
    display: block;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .extra-price {
    display: block;
    margin: 6px 0 14px;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
  }
  .extra p {
    max-width: 46ch;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }
  .extra-go {
    position: absolute;
    top: 34px;
    right: 30px;
    font-size: 20px;
    color: var(--studio-gray);
    transition: transform 0.25s, color 0.25s;
  }
  .extra:hover .extra-go {
    color: var(--flash-orange);
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .extra,
    .extra-go {
      transition: none;
    }
    .extra:hover {
      transform: none;
    }
  }

  /* La cita se apoya sobre la textura líquida a sangre */
  .quote {
    position: relative;
    overflow: hidden;
    padding: 150px 0;
  }
  .quote .container {
    position: relative;
    z-index: 1;
  }
  .quote :global(blockquote) {
    max-width: 26ch;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.9);
  }
  .quote :global(.cite) {
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }

  .planes-preview { padding: 120px 0; }
  .plans-preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .plan-mini {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, transform 0.25s, background 0.25s;
    position: relative;
  }
  .plan-mini:hover {
    border-color: var(--flash-orange);
    transform: translateY(-4px);
    background: rgba(255, 81, 0, 0.04);
  }
  .plan-mini[data-featured='true'] {
    border-color: var(--flash-orange);
    background: linear-gradient(180deg, rgba(255, 81, 0, 0.1), rgba(255, 81, 0, 0) 60%);
  }
  .plan-mini-badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--flash-orange);
    color: var(--deep-black);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
  }
  .plan-mini-name {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
    margin-bottom: 12px;
  }
  .plan-mini-price {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 6px;
  }
  .plan-mini-delivery {
    font-size: 12px;
    color: var(--flash-orange);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .plans-preview-grid { grid-template-columns: repeat(2, 1fr); }
    .section-head { flex-direction: column; align-items: flex-start; gap: 20px; }
    .hero-cinematic { min-height: 90vh; height: auto; padding: 120px 0 100px; }
    .hero-title { font-size: clamp(44px, 12vw, 88px); }
  }
  @media (max-width: 640px) {
    .plans-preview-grid { grid-template-columns: 1fr; }
    .extras-grid { grid-template-columns: 1fr; }
  }
</style>
