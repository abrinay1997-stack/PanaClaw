---
import Icono from '../components/Icono.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import HeroShader from '../components/HeroShader.astro';
import SceneBg from '../components/SceneBg.astro';

import { site, waLink } from '../data/site';
import { plans } from '../data/plans';
import { ebot } from '../data/ebot';
import { seguridad, revision } from '../data/seguridad';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { procesoVisual } from '../data/images';
import { routes } from '../data/links';

// De menor a mayor precio: la escalera se lee de izquierda a derecha.
const precioNum = (p: string) => Number(p.replace(/[^0-9]/g, ''));
const planesOrdenados = [...plans].sort((a, b) => precioNum(a.price) - precioNum(b.price));
// Una frase corta por pilar, tomada de lo que ya dice su descripción (nada nuevo que prometer).
const pruebas = ['Menos de un segundo', 'Sin complementos que se rompan', '72 horas o tres semanas'];
---

<BaseLayout
  title={`${site.name} — ${site.tagline} ${site.location}.`}
  description={site.description}
  activePath={routes.home}
>
  <!-- HERO CINEMÁTICO -->
  <!-- Portada: el héroe y la franja de proyectos suman exactamente una pantalla. -->
  <div class="portada">
  <section class="hero hero-cinematic" id="top">
    <HeroShader />

    <div class="container hero-inner">
      <Reveal y={50} eager>
        <h1 class="hero-title">
          Sitios que <span class="ember">encienden</span>.<br />
          Código <span class="ember">tuyo</span>.
        </h1>
      </Reveal>
      <Reveal delay={0.2} eager>
        <p class="hero-lead">
          Webs que abren en menos de un segundo, listas en días y que quedan a tu nombre —
          no al nuestro. Desde $295, en {site.location}.
        </p>
      </Reveal>
      <!--
        La acción principal de la home es cotizar, no «ver planes».

        Las dos llevan al precio, pero por caminos muy distintos: /planes enseña
        cuatro cifras y deja al visitante decidiendo solo; el cotizador le da SU
        cifra en cuatro respuestas y termina en un mensaje ya redactado. Es el
        camino que mejor convierte del sitio (está medido en el bloque 6) y hasta
        ahora la portada no lo ofrecía ni una vez: solo lo llevaba el botón del
        nav. Los cuatro precios siguen abajo, a un scroll.
      -->
      <Reveal delay={0.35} eager>
        <div class="hero-actions">
          <a class="btn btn-primary" href={routes.cotizador}>
            <Icono nombre="calculadora" /> Cotizar mi sitio
          </a>
          <a class="btn btn-ghost" href={waLink()} target="_blank" rel="noopener">
            Hablar por WhatsApp
          </a>
        </div>
      </Reveal>
    </div>

    {/*
      El nombre accesible empieza por "Scroll" porque es lo que se lee en
      pantalla. Decía "Ver servicios", que describe mejor el destino pero deja a
      quien navega por voz sin poder pedirlo: dice "Scroll", que es lo que ve, y
      no existe (WCAG 2.5.3 «Label in Name»; Lighthouse lo marcó el 22 ago 2026).
    */}
    <a class="hero-scroll-cue" href="#servicios" aria-label="Scroll a servicios">
      <span>Scroll</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!--
    PRUEBA, antes que el discurso.

    Es lo primero que aparece tras el hero porque es lo único de la home que el
    visitante puede verificar sin fiarse de nosotros. Van los dominios y no unos
    logos: un logo se dibuja, un dominio se abre.
  -->
  <section class="proof" aria-labelledby="proof-title">
    <div class="container">
      <div class="proof-inner">
        <span class="eyebrow" id="proof-title">Trabajo publicado</span>
        <!--
          Los dominios van en texto, no enlazados, y es deliberado.
          Enlazados eran cuatro salidas a sitios ajenos en la primera pantalla
          de la portada, sin ninguna vuelta: el visitante se iba a bukoflow y la
          visita terminaba ahí. Siguen escritos porque un dominio se puede
          teclear y comprobar —que es el argumento entero de esta banda—, pero
          la puerta para abrirlos es /proyectos, donde cada ficha ya tiene su
          camino de regreso.
        -->
        <ul class="proof-list">
          {projects.map((project) => <li>{project.domain}</li>)}
        </ul>
        <a class="proof-link" href={routes.proyectos}>
          Ábrelos uno a uno <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  </div>

  <!-- LOS TRES PILARES: una pantalla, tres franjas -->
  <section class="pil fondo-brasa" id="servicios" aria-labelledby="pil-titulo">
    <div class="container">
      <div class="pil-head">
        <div>
          <span class="eyebrow">Servicios</span>
          <Reveal>
            <h2 class="section-title" id="pil-titulo">Tres pilares. <span class="muted">Cero atajos.</span></h2>
          </Reveal>
        </div>
        <Reveal delay={0.15}>
          <a class="section-link" href={routes.servicios}>Ver todo <span aria-hidden="true">→</span></a>
        </Reveal>
      </div>
      <!-- Son un argumento, no botones: el único enlace es el «Ver todo» de arriba. -->
      <ol class="pil-list">
        {services.map((s, i) => (
          <Reveal as="li" class="pil-item" delay={i * 0.08} x={i % 2 === 0 ? -28 : 28}>
            <span class="pil-num" aria-hidden="true">{s.idx}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="pil-prueba">{pruebas[i]}</span>
          </Reveal>
        ))}
      </ol>
    </div>
  </section>

  <!--
    PRECIOS Y MÁS, EN UNA SOLA PANTALLA.

    Los planes y «Y además» eran dos secciones sueltas con el mismo titular a
    medio camino. Ahora son una: arriba la escalera de planes, de menor a mayor
    precio (antes salían en desorden: 850, 450, 1.200, 295), y debajo, separado
    por una línea, lo que no es una web: eBot y Seguridad, que antes solo se
    descubrían por el menú. Primero lo que trae a la gente; cuando ya tiene el
    precio de su sitio en la cabeza, lo que puede sumarle.
  -->
  <section class="pre fondo-brasa" id="precios" aria-labelledby="pre-titulo">
    <div class="container">
      <div class="pre-head">
        <span class="eyebrow">Planes</span>
        <Reveal>
          <h2 class="section-title" id="pre-titulo">Precios fijos. <span class="muted">Cero letra chica.</span></h2>
        </Reveal>
      </div>

      <ol class="escalera">
        {planesOrdenados.map((plan, i) => (
          <Reveal as="li" class="escalon" delay={i * 0.07}>
            <a class="plan-mini" href={routes.planes} data-featured={plan.featured} style={`--alto:${28 + i * 24}%`}>
              {plan.featured && <span class="plan-mini-badge">Recomendado</span>}
              <span class="plan-mini-name">{plan.name.replace('PanaClaw ', '')}</span>
              <span class="plan-mini-price">{plan.price}</span>
              <span class="plan-mini-delivery">{plan.delivery}</span>
              <span class="escalon-barra" aria-hidden="true"></span>
            </a>
          </Reveal>
        ))}
      </ol>

      <div class="ademas">
        <span class="ademas-rotulo">Y además</span>
        <Reveal>
          <a class="ademas-fila" href={routes.ebot}>
            <span class="ademas-nombre">{ebot.name}</span>
            <span class="ademas-precio">{ebot.price}</span>
            <span class="ademas-texto">Un agente de inteligencia artificial que conoce tu negocio y contesta por WhatsApp, Instagram, Messenger y Telegram a cualquier hora, con un panel donde ves cada conversación.</span>
            <span class="ademas-go" aria-hidden="true">→</span>
          </a>
        </Reveal>
        <Reveal delay={0.08}>
          <a class="ademas-fila" href={routes.seguridad}>
            <span class="ademas-nombre">{seguridad.name}</span>
            <span class="ademas-precio">Desde {revision.price.split('–')[0]}</span>
            <span class="ademas-texto">{seguridad.tagline} Revisamos el sitio que ya tienes, te decimos por dónde podrían entrar y lo cerramos.</span>
            <span class="ademas-go" aria-hidden="true">→</span>
          </a>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ARGUMENTO, sobre la textura líquida -->
  <section class="quote">
    <SceneBg visual={procesoVisual} side="center" dim={0.38} />
    <div class="container">
      <Reveal>
        <blockquote>
          Tu competencia sale en Google.<br />
          <span class="muted">Tú sales en un perfil de Instagram.</span>
        </blockquote>
        <div class="cite">
          Cada día sin sitio propio es un cliente que buscó lo que vendes y encontró a otro.
        </div>
        <div class="quote-actions">
          <a class="btn btn-primary" href={routes.cotizador}><Icono nombre="calculadora" /> Calcular mi precio</a>
          <a class="btn btn-ghost" href={waLink('Hola PanaClaw, quiero un sitio para mi negocio')} target="_blank" rel="noopener">Hablar por WhatsApp</a>
        </div>
      </Reveal>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- HERO CINEMÁTICO ---------- */
  .portada { display: flex; flex-direction: column; min-height: 100svh; }
  .portada .hero-cinematic { flex: 1 1 auto; height: auto; min-height: 0; max-height: none; }
  .hero-cinematic {
    position: relative;
    min-height: 100svh;
    height: 100svh;
    max-height: 1080px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: var(--e6) 0 var(--e5);
    overflow: hidden;
  }
  .hero-cinematic .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1280px;
  }
  .hero-title {
    font-size: clamp(52px, 9vw, 132px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: none;
    max-width: 18ch;
    color: var(--soft-white);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }
  /* El acento del titular es el naranja de marca. El rojo ember queda para el
     shader del fondo: dos rojos compitiendo aplanaban toda la escena. */
  .hero-title .ember {
    color: var(--flash-orange);
    font-style: italic;
    font-weight: 700;
    text-shadow: 0 0 40px rgba(255, 81, 0, 0.35);
  }
  .hero-lead {
    margin-top: var(--e3);
    max-width: 54ch;
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.5;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }
  .hero-actions {
    display: flex;
    gap: var(--e2);
    margin-top: var(--e4);
    flex-wrap: wrap;
  }

  /* Scroll indicator */
  .hero-scroll-cue {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e1);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--studio-gray);
    padding: 8px var(--e1);
  }
  .hero-scroll-cue:hover {
    color: var(--soft-white);
  }
  .hero-scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    top: -36px;
    left: 0;
    width: 100%;
    height: 36px;
    background: linear-gradient(to bottom, transparent, var(--ember-red), transparent);
    animation: scroll-cue 2.2s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% { transform: translateY(0); }
    100% { transform: translateY(72px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after { animation: none; opacity: 0.4; }
  }

  /* Ocultar el gradiente CSS antiguo (lo reemplaza el shader) */
  .hero-cinematic::after {
    display: none !important;
  }

  /* ---------- BANDA DE PRUEBA ---------- */
  .proof {
    padding: var(--e4) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.015);
  }
  .proof-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--e2) var(--e3);
  }
  .proof .eyebrow {
    margin: 0;
    flex-shrink: 0;
  }
  .proof-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e1) var(--e3);
    list-style: none;
    flex: 1;
  }
  /* Los dominios ya no son enlaces (ver el comentario de la plantilla), así que
     tampoco necesitan objetivo táctil: son texto. El aire vertical se queda
     porque la banda se lee mejor con él. */
  .proof-list li {
    padding-block: 6px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--studio-gray);
  }
  .proof-link {
    display: inline-block;
    padding-block: 6px;
    flex-shrink: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
    white-space: nowrap;
  }
  .proof-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---------- RESTO DE LA HOME ---------- */
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
    padding: var(--e1) var(--e2);
    border: 1px solid rgba(255, 81, 0, 0.4);
    border-radius: 999px;
    transition: background 0.25s, border-color 0.25s;
    white-space: nowrap;
  }
  .section-link:hover {
    background: rgba(255, 81, 0, 0.1);
    border-color: var(--flash-orange);
  }
  .pil, .pre {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 84px 0 var(--e3);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .pil > .container, .pre > .container { width: 100%; }

  /* ---------- PILARES ---------- */
  .pil-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--e3); flex-wrap: wrap; margin-bottom: var(--e3);
  }
  .pil-head h2.section-title { margin-bottom: 0; }
  .pil-list { list-style: none; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  :global(.pil-item) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(150px, 0.45fr) minmax(0, 1.25fr) minmax(0, 1.2fr) 14.5rem;
    align-items: center;
    gap: var(--e3);
    padding: var(--e3) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    transition: padding-left 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* La línea naranja se dibuja de izquierda a derecha al pasar el cursor. */
  :global(.pil-item)::after {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    background: var(--flash-orange); transform: scaleX(0); transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.pil-item):hover { padding-left: var(--e2); }
  :global(.pil-item):hover::after { transform: scaleX(1); }
  /* Cifra hueca: solo contorno, se llena de naranja al acercarse. */
  .pil-num {
    font-size: clamp(56px, 7vw, 104px);
    font-weight: 700;
    line-height: .85;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.4);
    transition: color 0.35s, -webkit-text-stroke-color 0.35s;
  }
  :global(.pil-item):hover .pil-num { color: var(--flash-orange); -webkit-text-stroke-color: var(--flash-orange); }
  :global(.pil-item) h3 {
    font-size: clamp(24px, 2.8vw, 38px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  :global(.pil-item) p { font-size: 16px; font-weight: 300; color: var(--studio-gray); line-height: 1.6; max-width: 44ch; }
  .pil-prueba {
    justify-self: stretch; text-align: center;
    font-size: 12px; letter-spacing: 0.07em; line-height: 1.35; text-transform: uppercase; color: var(--flash-orange);
    border: 1px solid rgba(255, 81, 0, 0.4); border-radius: 999px; padding: 9px var(--e2);
  }

  /* ---------- PRECIOS Y MÁS ---------- */
  .pre-head { margin-bottom: var(--e4); }
  .pre-head h2.section-title { margin-bottom: 0; }
  .escalera {
    list-style: none;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--e2);
    align-items: end;
  }
  .escalon { display: block; }
  .plan-mini {
    position: relative;
    display: flex; flex-direction: column;
    min-height: 210px;
    padding: var(--e3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.3s;
  }
  .plan-mini:hover { border-color: var(--flash-orange); transform: translateY(-6px); }
  .plan-mini[data-featured='true'] { border-color: var(--flash-orange); }
  /* La barra de abajo sube con el precio: la escalera se ve antes de leerse. */
  .escalon-barra {
    position: absolute; left: 0; right: 0; bottom: 0; height: var(--alto, 30%); z-index: 0;
    background: linear-gradient(180deg, rgba(255, 81, 0, 0.0), rgba(255, 81, 0, 0.16));
    transition: opacity 0.3s;
  }
  .plan-mini[data-featured='true'] .escalon-barra { background: linear-gradient(180deg, rgba(255, 81, 0, 0.05), rgba(255, 81, 0, 0.3)); }
  .plan-mini > span:not(.escalon-barra) { position: relative; z-index: 1; }
  .plan-mini-badge {
    position: absolute !important; top: -1px; right: var(--e2);
    background: var(--flash-orange); color: var(--deep-black);
    font-size: 11.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 6px var(--e1); border-radius: 0 0 10px 10px;
  }
  .plan-mini-name { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--studio-gray); margin-bottom: var(--e2); }
  .plan-mini-price { font-size: clamp(36px, 4vw, 54px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; margin-bottom: var(--e1); }
  .plan-mini-delivery { font-size: 12px; color: var(--flash-orange); letter-spacing: 0.06em; text-transform: uppercase; }

  .ademas { margin-top: var(--e4); border-top: 1px solid rgba(255, 255, 255, 0.14); padding-top: var(--e2); }
  .ademas-rotulo { display: block; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--flash-orange); margin-bottom: var(--e1); }
  .ademas-fila {
    display: grid; grid-template-columns: 0.55fr 0.4fr 2fr auto; align-items: center; gap: var(--e3);
    padding: var(--e2) 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: padding-left 0.3s, background 0.3s;
  }
  .ademas-fila:hover { padding-left: var(--e1); background: rgba(255, 81, 0, 0.05); }
  .ademas-fila:focus-visible { outline: 2px solid var(--flash-orange); outline-offset: -2px; }
  .ademas-nombre { font-size: clamp(22px, 2.4vw, 30px); font-weight: 600; letter-spacing: -0.015em; }
  .ademas-precio { font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--flash-orange); }
  .ademas-texto { font-size: 15px; font-weight: 300; color: var(--studio-gray); line-height: 1.55; max-width: 62ch; }
  .ademas-go { font-size: 20px; color: var(--studio-gray); transition: transform 0.25s, color 0.25s; }
  .ademas-fila:hover .ademas-go { color: var(--flash-orange); transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    :global(.pil-item), :global(.pil-item)::after, .pil-num, .plan-mini, .ademas-fila, .ademas-go { transition: none; }
  }

  /* La cita se apoya sobre la textura líquida a sangre */
  .quote {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--e7) 0;
  }
  .quote > .container { width: 100%; }
  .quote-actions { display: flex; gap: var(--e2); flex-wrap: wrap; margin-top: var(--e4); }
  .quote .container {
    position: relative;
    z-index: 1;
  }
  .quote :global(blockquote) {
    max-width: 26ch;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.9);
  }
  .quote :global(.cite) {
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }

  @media (max-width: 900px) {
    .escalera { grid-template-columns: repeat(2, 1fr); align-items: stretch; }
    :global(.pil-item) { grid-template-columns: auto 1fr; gap: var(--e1) var(--e3); padding: var(--e3) 0; }
    :global(.pil-item) h3, :global(.pil-item) p, .pil-prueba { grid-column: 2; }
    .pil-num { grid-row: 1 / span 3; font-size: 64px; }
    .pil-prueba { justify-self: start; margin-top: var(--e1); }
    .pil-head { flex-direction: column; align-items: flex-start; gap: var(--e2); }
    .ademas-fila { grid-template-columns: 1fr auto; gap: 4px var(--e2); }
    .ademas-texto { grid-column: 1 / -1; }
    .ademas-precio { grid-column: 1; grid-row: 2; }
    .ademas-go { grid-column: 2; grid-row: 1; }
    .hero-cinematic, .portada .hero-cinematic { min-height: 90svh; height: auto; padding: var(--e6) 0 var(--e6); }
    .hero-title { font-size: clamp(44px, 12vw, 88px); }
  }
  @media (max-width: 640px) {
    .escalera { grid-template-columns: 1fr; }
    .plan-mini { min-height: 0; }
  }
