---
/**
 * /blog/[slug]/ — cada post individual.
 *
 * Genera una ruta por cada archivo `.md` de `src/content/blog/`. Cero
 * mantenimiento de rutas: publicar un post es crear el archivo y hacer push.
 *
 * TRES DECISIONES QUE NO SON DE ESTILO:
 *
 * 1. **CTA fuerte al final del post, no en medio.** El post es el gancho
 *    informacional; el cotizador es la conversión. Meter CTA en medio del
 *    cuerpo interrumpe la lectura; ponerlo abajo respeta al que quiere leer
 *    y captura al que llegó a la respuesta.
 *
 * 2. **Posts relacionados por keyword compartida, no por categoría.** Es más
 *    específico: dos posts de categoría "guias" pueden tratar de cosas
 *    completamente distintas. Compartir keyword garantiza afinidad temática.
 *
 * 3. **Breadcrumbs con Schema BreadcrumbList.** Google lo usa para mostrar
 *    la ruta en los resultados de búsqueda (Panamá → Blog → título del post),
 *    lo que gana espacio visual y da contexto.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import { getCollection, render } from 'astro:content';
import { routes } from '../../data/links';
import { site, waLink } from '../../data/site';

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const posts = await getCollection('blog', ({ data }) => isDev || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const slug = post.id.replace(/\.md$/, '');
const origin = Astro.site ?? new URL('http://localhost:4321');
const url = new URL(`blog/${slug}/`, origin).toString();
const ogImage = new URL('og.png', origin).toString();

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('es-PA', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const categoryLabels: Record<string, string> = {
  precios: 'Precios',
  guias: 'Guía',
  comparativas: 'Comparativa',
  casos: 'Caso',
  panama: 'Panamá',
};

// Posts relacionados: los que comparten al menos una keyword, ordenados por
// número de coincidencias. Se limitan a 2, que es lo que aguanta la tarjeta
// del final sin llenar la pantalla en móvil.
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    overlap: p.data.keywords.filter((k) => post.data.keywords.includes(k)).length,
  }))
  .filter((r) => r.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, 2)
  .map((r) => r.post);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  url,
  image: ogImage,
  author: {
    '@type': 'Organization',
    name: site.name,
    url: origin.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('icon-512.png', origin).toString(),
    },
  },
  keywords: post.data.keywords.join(', '),
  articleSection: categoryLabels[post.data.category] ?? post.data.category,
  inLanguage: 'es-PA',
  mainEntityOfPage: url,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: origin.toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('blog/', origin).toString() },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  activePath={routes.blog}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <article class="post">
    <div class="container container-post">
      <nav class="post-crumbs" aria-label="Ruta">
        <a href={routes.home}>Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={routes.blog}>Blog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{categoryLabels[post.data.category] ?? post.data.category}</span>
      </nav>

      <header class="post-head">
        <Reveal>
          <div class="post-meta">
            <span class="post-cat">{categoryLabels[post.data.category] ?? post.data.category}</span>
            <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
            <span class="post-dot" aria-hidden="true">·</span>
            <span>{post.data.readingTime} min de lectura</span>
          </div>
        </Reveal>
        <Reveal delay={0.08}>
          <h1 class="post-title">{post.data.title}</h1>
        </Reveal>
        <Reveal delay={0.16}>
          <p class="post-lead">{post.data.description}</p>
        </Reveal>
      </header>

      <div class="post-body">
        <Content />
      </div>

      {/* CTA al final: es donde la persona ya leyó y está más caliente. */}
      <aside class="post-cta">
        <p class="post-cta-eyebrow">¿Te ayudó este post?</p>
        <h2 class="post-cta-title">
          Sale más rápido con <span class="ember">una cifra</span> concreta.
        </h2>
        <p class="post-cta-lead">
          El cotizador te da el precio exacto para tu caso en cuatro
          respuestas, sin pedirte datos primero. Si prefieres hablar,
          escríbenos por WhatsApp.
        </p>
        <div class="post-cta-actions">
          <a class="btn btn-primary" href={routes.cotizador}>
            <span class="dot"></span> Calcular mi precio
          </a>
          <a class="btn btn-ghost" href={waLink(`Hola PanaClaw, leí ${post.data.title} y quiero cotizar`)} target="_blank" rel="noopener">
            Escribir por WhatsApp
          </a>
        </div>
      </aside>

      {relatedPosts.length > 0 && (
        <section class="post-related" aria-labelledby="related-heading">
          <h2 id="related-heading" class="post-related-title">También te puede interesar</h2>
          <ul class="post-related-list">
            {relatedPosts.map((r) => {
              const rslug = r.id.replace(/\.md$/, '');
              return (
                <li>
                  <a class="post-related-card" href={`/blog/${rslug}/`}>
                    <span class="post-related-cat">{categoryLabels[r.data.category] ?? r.data.category}</span>
                    <h3>{r.data.title}</h3>
                    <p>{r.data.description}</p>
                    <span class="post-related-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 100px 0 120px;
  }
  /* Un contenedor más estrecho que el resto del sitio: el texto largo se lee
     mejor en 720 px, no en 1280. Es la única página con esta anchura. */
  .container-post {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .post-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--studio-gray);
    margin-bottom: 32px;
  }
  .post-crumbs a {
    color: var(--studio-gray);
    transition: color 0.2s;
  }
  .post-crumbs a:hover {
    color: var(--flash-orange);
  }
  .post-crumbs span[aria-current] {
    color: var(--soft-white);
  }

  .post-head {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--studio-gray);
  }
  .post-cat {
    padding: 4px 10px;
    border: 1px solid rgba(255, 81, 0, 0.4);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--flash-orange);
  }
  .post-dot {
    color: rgba(255, 255, 255, 0.2);
  }
  .post-title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 20px;
  }
  .post-lead {
    font-size: 19px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--studio-gray);
  }

  /* Estilos del contenido markdown. Las clases las genera Astro
     (`.post-body > *`); no hay que casar con las clases del proyecto. */
  .post-body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--soft-white);
  }
  .post-body :global(h2) {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 48px 0 16px;
    color: var(--soft-white);
  }
  .post-body :global(h3) {
    font-size: 20px;
    font-weight: 600;
    margin: 32px 0 12px;
    color: var(--soft-white);
  }
  .post-body :global(p) {
    margin-bottom: 20px;
  }
  .post-body :global(strong) {
    color: var(--soft-white);
    font-weight: 600;
  }
  .post-body :global(a) {
    color: var(--flash-orange);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .post-body :global(a:hover) {
    color: var(--ember-red);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 20px 0 24px;
    padding-left: 24px;
  }
  .post-body :global(li) {
    margin-bottom: 8px;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--flash-orange);
    padding: 4px 20px;
    margin: 24px 0;
    font-style: italic;
    color: var(--studio-gray);
  }
  .post-body :global(code) {
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    font-size: 15px;
  }

  .post-cta {
    margin-top: 64px;
    padding: 40px 32px;
    border: 1px solid rgba(255, 81, 0, 0.3);
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 81, 0, 0.06), rgba(255, 81, 0, 0.02));
    text-align: center;
  }
  .post-cta-eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 12px;
  }
  .post-cta-title {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 12px;
  }
  .post-cta-title .ember {
    color: var(--flash-orange);
  }
  .post-cta-lead {
    max-width: 480px;
    margin: 0 auto 24px;
    font-size: 15px;
    color: var(--studio-gray);
    line-height: 1.55;
  }
  .post-cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .post-related {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .post-related-title {
    font-size: 18px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--studio-gray);
    margin-bottom: 24px;
  }
  .post-related-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .post-related-card {
    display: block;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, transform 0.25s;
  }
  .post-related-card:hover {
    border-color: var(--flash-orange);
    transform: translateY(-2px);
  }
  .post-related-cat {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid rgba(255, 81, 0, 0.4);
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 12px;
  }
  .post-related-card h3 {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 8px;
  }
  .post-related-card p {
    font-size: 14px;
    color: var(--studio-gray);
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .post-related-arrow {
    color: var(--flash-orange);
    font-size: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-related-card:hover {
      transform: none;
    }
  }
</style>
