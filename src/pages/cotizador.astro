---
import BaseLayout from '../layouts/BaseLayout.astro';
import { steps, optionPriceLabel } from '../data/quote';
import { diagnostico } from '../data/plans';
import { routes } from '../data/links';

/**
 * El precio se enseña ANTES de pedir datos, a propósito.
 *
 * Es la promesa del sitio ("precio público, cero consultar por interno")
 * ejecutada como experiencia en vez de como afirmación. Y comercialmente
 * funciona mejor: cuatro respuestas ya invertidas + una cifra concreta delante
 * hacen que pedir el contacto deje de ser un peaje y pase a ser el paso obvio
 * para recibir la versión escrita.
 *
 * El cálculo vive entero en `src/data/quote.ts`, y el script de abajo lo
 * IMPORTA en vez de reimplementarlo. Antes había dos copias del algoritmo —una
 * aquí y otra allí, esta última sin que la llamara nadie— con un comentario
 * prometiendo que darían el mismo resultado. Dos implementaciones y solo una
 * ejecutándose es divergencia silenciosa garantizada.
 */
---

<BaseLayout
  title="Cotizador"
  description="Define lo que necesitas en cuatro respuestas y te decimos el precio al instante. Sin dar tus datos primero."
  activePath={routes.cotizador}
>
  <section class="cot">
    <div class="container">
      <header class="cot-head">
        <span class="eyebrow">Cotizador</span>
        <h1>Tu precio en <span class="muted">cuatro respuestas.</span></h1>
        <p class="cot-lead">
          Sin dejar tus datos y sin esperar a que alguien te conteste. Ves la cifra al final;
          si te encaja, entonces hablamos.
        </p>
      </header>

      <!-- Progreso + total corriendo -->
      <div class="cot-progress" role="group" aria-label="Progreso del cotizador">
        <div class="cot-bar"><span data-bar></span></div>
        <div class="cot-meta">
          <p class="cot-count" aria-live="polite" data-count>Paso 1 de {steps.length}</p>
          <p class="cot-running" data-running hidden>
            <span class="cot-running-k">Va por</span>
            <span class="cot-running-v" data-running-total aria-live="polite">—</span>
            <!--
              La mensualidad, aparte y en otro tamaño. Pegada al total de una
              vez se leería como parte de él; y sumarlas para enseñar un solo
              número sería inventarse cuántos meses va a durar el cliente.
            -->
            <span class="cot-running-mes" data-running-mes hidden></span>
          </p>
        </div>
      </div>

      <!--
        Sin JavaScript el cotizador es HTML muerto: se ve el primer paso con el
        botón deshabilitado y ahí se acaba. No se va a rehacer sin JS —el
        cálculo en vivo es el producto— pero dejar a alguien en una pantalla
        que no responde sí se arregla con dos líneas.
      -->
      <noscript>
        <p class="cot-noscript">
          El cotizador necesita JavaScript para calcular en vivo. Los precios están
          publicados igual en <a href={routes.planes}>planes</a>, y por
          <a href={routes.contacto}>contacto</a> te lo pasamos por escrito.
        </p>
      </noscript>

      <form class="cot-form" data-quote novalidate>
        {steps.map((step, i) => (
          <fieldset class="cot-step" data-step={step.id} hidden={i > 0}>
            <legend tabindex="-1">
              <span class="cot-q">{step.question}</span>
              <span class="cot-help">{step.help}</span>
            </legend>

            <div class="cot-options" data-multiple={String(step.multiple)}>
              {step.options.map((opt) => {
                /*
                 * La etiqueta son dos cifras, no una: lo que suma de una vez y
                 * lo que suma cada mes. Van en dos nodos separados —y no en una
                 * sola frase— para que ninguna de las dos pueda leerse como
                 * parte de la otra, y para que el arnés pueda comprobarlas por
                 * separado contra su propio total.
                 */
                const price = optionPriceLabel(step.id, opt.value);
                return (
                  <label class="cot-opt">
                    <input
                      type={step.multiple ? 'checkbox' : 'radio'}
                      name={step.id}
                      value={opt.value}
                    />
                    <span class="cot-opt-body">
                      <span class="cot-opt-label">{opt.label}</span>
                      <span class="cot-opt-hint">{opt.hint}</span>
                    </span>
                    {price && (
                      <span class="cot-opt-price" data-opt-price={opt.value}>
                        <span data-opt-unico={opt.value}>{price.unico}</span>
                        <span class="cot-opt-mes" data-opt-mes={opt.value} hidden={!price.mensual}>
                          {price.mensual ?? ''}
                        </span>
                      </span>
                    )}
                    <span class="cot-tick" aria-hidden="true"></span>
                  </label>
                );
              })}
            </div>

            <div class="cot-nav">
              <button type="button" class="btn btn-ghost" data-back hidden={i === 0}>
                Atrás
              </button>
              <button type="button" class="btn btn-primary" data-next disabled>
                <span class="dot"></span>
                {i === steps.length - 1 ? 'Ver mi precio' : 'Siguiente'}
              </button>
              {step.multiple && (
                <button type="button" class="cot-skip" data-skip>
                  Ninguna de estas
                </button>
              )}
            </div>
          </fieldset>
        ))}
      </form>

      <!-- RESULTADO -->
      <!--
        Sin `aria-live` en el bloque entero: al aparecer hacía que un lector de
        pantalla releyera plan, líneas, total y formulario de una tacada, y de
        paso competía con el `aria-live` del contador de pasos. Lo que sí hay
        es foco en el titular, que es el patrón estándar para "la vista cambió"
        y además deja el teclado donde toca.
      -->
      <div class="cot-result" data-result hidden>
        <div class="cot-result-head">
          <span class="eyebrow">Tu estimación</span>
          <h2 data-plan-name tabindex="-1">—</h2>
          <p class="cot-reason" data-reason></p>
        </div>

        <ul class="cot-lines" data-lines></ul>

        <div class="cot-total">
          <div>
            <span class="cot-total-k">Total estimado</span>
            <span class="cot-total-v" data-total>—</span>
            <span class="cot-total-mes" data-total-mes hidden></span>
            <span class="cot-total-mes-nota" data-total-mes-nota hidden>
              Mensualidad aparte del total. Se para cuando quieras.
            </span>
          </div>
          <div class="cot-total-meta">
            <span data-delivery></span>
            <span class="cot-urgencia" data-urgencia hidden></span>
            <span class="cot-disclaimer">
              Estimación, no factura. La propuesta escrita confirma alcance, cronograma y cifra final.
            </span>
          </div>
        </div>

        <div class="cot-send">
          <h3>¿Te encaja? Te lo mandamos por escrito.</h3>
          <p class="cot-send-lead">
            Solo el nombre y por dónde te escribimos. El resumen de arriba va incluido, no hay que
            repetir nada.
          </p>
          <div class="cot-fields">
            <div class="field">
              <label for="cot-nombre">Nombre <span class="req">*</span></label>
              <input id="cot-nombre" name="nombre" type="text" autocomplete="name" placeholder="Cómo te llamas" />
            </div>
            <div class="field">
              <label for="cot-contacto">WhatsApp o correo <span class="req">*</span></label>
              <input id="cot-contacto" name="contacto" type="text" autocomplete="tel" placeholder="+507 6000 0000" />
            </div>
          </div>
          <p class="cot-error" data-error hidden role="alert"></p>

          <div class="cot-actions">
            <button type="button" class="btn btn-primary" data-send>
              <span class="dot"></span> Enviar y recibir la propuesta
            </button>
            <!--
              Cambiar una respuesta CONSERVA las cuatro. Antes la única salida
              era empezar de cero, así que corregir una coma costaba rehacerlo
              todo, justo en el momento de mayor intención de compra.
            -->
            <button type="button" class="btn btn-ghost" data-edit>Cambiar una respuesta</button>
            <button type="button" class="cot-skip" data-restart>Empezar de nuevo</button>
          </div>

          <p class="cot-alt">
            ¿Prefieres que revisemos primero tu sitio actual?
            <a href={`${routes.contacto}?plan=${diagnostico.slug}`}>
              {diagnostico.name} · {diagnostico.price}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    steps,
    computeQuote,
    capabilityState,
    capabilityLabel,
    formatMoney,
    formatMensual,
    isZero,
    type Answers,
    type Money,
  } from '../data/quote';
  import { routes } from '../data/links';
  import { contact } from '../data/site';
  import { prefersReducedMotion } from '../scripts/motion';

  /**
   * El cálculo NO se reimplementa aquí: se importa de `src/data/quote.ts` y
   * Vite lo empaqueta con la página. Antes había dos copias del algoritmo, y la
   * de `quote.ts` no la llamaba nadie: el archivo prometía en su cabecera que
   * las dos darían el mismo resultado y solo una llegaba a ejecutarse jamás.
   */
  const CAPACIDADES = 'capacidades';

  /**
   * `scrollIntoView({behavior:'smooth'})` IGNORA el `scroll-behavior:auto` que
   * la hoja de estilos pone bajo `prefers-reduced-motion`: el argumento
   * explícito gana a la CSS. Era el único sitio del sitio donde la preferencia
   * no se respetaba, y solo se ve midiendo el scroll cuadro a cuadro.
   */
  const llevarA = (el: Element, block: ScrollLogicalPosition) =>
    el.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth', block });

  function initCotizador() {
    const found = document.querySelector<HTMLFormElement>('[data-quote]');
    if (!found || found.dataset.bound) return;
    found.dataset.bound = 'true';
    const root: HTMLFormElement = found;

    const stepEls = [...root.querySelectorAll<HTMLFieldSetElement>('.cot-step')];
    const result = document.querySelector<HTMLElement>('[data-result]')!;
    const bar = document.querySelector<HTMLElement>('[data-bar]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const progress = document.querySelector<HTMLElement>('.cot-progress')!;
    const running = document.querySelector<HTMLElement>('[data-running]')!;

    let current = 0;

    const answers = (): Answers => {
      const out: Answers = {};
      for (const step of steps) {
        out[step.id] = [
          ...root.querySelectorAll<HTMLInputElement>(`input[name="${step.id}"]:checked`),
        ].map((i) => i.value);
      }
      return out;
    };

    const inputDe = (value: string) =>
      root.querySelector<HTMLInputElement>(`input[name="${CAPACIDADES}"][value="${value}"]`);

    /**
     * Pinta cada capacidad según lo que le cuesta a quien está mirando, y
     * bloquea las que el plan ya trae.
     *
     * Una casilla marcable que dice "Incluido" pide un clic que no decide nada:
     * ni cambia el precio ni el plan, solo añade ruido al resultado y al
     * mensaje de WhatsApp. Se apagan.
     *
     * Se desmarcan al bloquearlas, y eso es seguro por cómo está definido
     * `capabilityState`: solo se bloquea lo que cubre el plan de los pasos 1 y
     * 2, que ninguna capacidad puede bajar. Bloquear mirando el plan final
     * encerraría a la persona en el plan caro — marcas "Cobrar en línea",
     * subes a Commerce, y esa misma opción quedaría incluida, marcada y sin
     * poder desmarcarse.
     */
    function refreshPrices() {
      const capStep = steps.find((s) => s.id === CAPACIDADES)!;

      for (const opt of capStep.options) {
        if (capabilityState(opt.value, answers())?.kind !== 'bloqueada') continue;
        const input = inputDe(opt.value);
        if (input?.checked) input.checked = false;
      }

      const a = answers();
      for (const opt of capStep.options) {
        const el = document.querySelector<HTMLElement>(`[data-opt-price="${opt.value}"]`);
        const unico = document.querySelector<HTMLElement>(`[data-opt-unico="${opt.value}"]`);
        const mes = document.querySelector<HTMLElement>(`[data-opt-mes="${opt.value}"]`);
        const state = capabilityState(opt.value, a);
        if (!el || !unico || !state) continue;

        const bloqueada = state.kind === 'bloqueada';
        const label = capabilityLabel(state);
        unico.textContent = label.unico;
        if (mes) {
          mes.textContent = label.mensual ?? '';
          mes.hidden = !label.mensual;
        }
        /*
         * La clase la decide el estado, no la primera letra del texto. Antes el
         * formato salía de un `:not([data-base^='+'])` en la hoja de estilos:
         * cambiar "Desde" por otra palabra lo rompía sin que nada avisara.
         */
        el.className =
          'cot-opt-price' +
          (bloqueada || state.kind === 'gratis' ? ' is-free' : '') +
          (state.kind === 'sube-plan' ? ' is-delta' : '');

        const input = inputDe(opt.value);
        if (input) input.disabled = bloqueada;
        input?.closest('.cot-opt')?.classList.toggle('is-locked', bloqueada);
      }

      // El total aparece en cuanto hay plan, no al final: ver la cifra subir es
      // lo que evita llegar al resultado con una sorpresa de cuatro dígitos.
      const q = computeQuote(a);
      running.hidden = q === null;
      if (q) {
        document.querySelector('[data-running-total]')!.textContent = formatMoney(q.total);
        pintarMensual('[data-running-mes]', q.mensual, 'y ');
      }
    }

    /**
     * Escribe una cifra mensual donde toque, o la esconde si no hay ninguna.
     *
     * El elemento se OCULTA cuando no hay mensualidad en vez de escribir "$0":
     * un cero es una cifra, y una cifra en pantalla se lee como un concepto que
     * existe. Aquí la mayoría de las cotizaciones no tienen nada mensual y el
     * hueco tiene que desaparecer entero.
     */
    function pintarMensual(selector: string, mensual: Money, prefijo = '') {
      const el = document.querySelector<HTMLElement>(selector);
      if (!el) return;
      const hay = !isZero(mensual);
      el.hidden = !hay;
      el.textContent = hay ? `${prefijo}${formatMensual(mensual)}` : '';
    }

    function paint() {
      stepEls.forEach((el, i) => (el.hidden = i !== current));
      const pct = ((current + 1) / stepEls.length) * 100;
      bar.style.transform = `scaleX(${pct / 100})`;
      count.textContent = `Paso ${current + 1} de ${stepEls.length}`;
      // Un paso obligatorio no avanza hasta que haya respuesta; los múltiples sí
      const step = steps[current]!;
      const chosen = root.querySelectorAll(`input[name="${step.id}"]:checked`).length;
      const next = stepEls[current]!.querySelector<HTMLButtonElement>('button[data-next]')!;
      next.disabled = !step.multiple && chosen === 0;
      refreshPrices();
    }

    function go(to: number) {
      current = Math.max(0, Math.min(stepEls.length - 1, to));
      paint();
      // Mover el foco al enunciado: sin esto, quien navega con teclado se queda
      // en un botón que ya no existe en pantalla.
      stepEls[current]!.querySelector<HTMLElement>('legend')?.focus();
    }

    function show() {
      const q = computeQuote(answers());
      if (!q) return;

      document.querySelector('[data-plan-name]')!.textContent = q.plan.name;
      document.querySelector('[data-reason]')!.textContent = q.reason;

      const list = document.querySelector('[data-lines]')!;
      list.innerHTML = '';
      for (const l of q.lines) {
        const li = document.createElement('li');
        li.className = 'cot-line';
        // Una línea mensual lleva su "/mes" pegado a la cifra, no en la nota:
        // el desglose se lee de arriba abajo por la columna de precios, y ahí
        // es donde tiene que verse que esa no es como las demás.
        const precio = l.price
          ? l.periodo === 'mes'
            ? formatMensual(l.price)
            : formatMoney(l.price)
          : 'Incluido';
        li.innerHTML =
          `<span class="cot-line-label">${l.label}<small>${l.note ?? ''}</small></span>` +
          `<span class="cot-line-price${l.price ? '' : ' is-free'}">${precio}</span>`;
        list.appendChild(li);
      }

      document.querySelector('[data-total]')!.textContent = formatMoney(q.total);
      pintarMensual('[data-total-mes]', q.mensual, 'y ');
      document.querySelector<HTMLElement>('[data-total-mes-nota]')!.hidden = isZero(q.mensual);
      document.querySelector('[data-delivery]')!.textContent = q.delivery;

      /*
       * El paso de urgencia dice que no cambia el precio, y es verdad, pero
       * tampoco cambiaba nada visible: se podía pedir "esta semana" y recibir
       * un plazo de 15–20 días sin una palabra. El aviso solo constata la
       * tensión —no promete prioridad, que es una decisión comercial y no del
       * cotizador.
       */
      const aviso = document.querySelector<HTMLElement>('[data-urgencia]')!;
      aviso.hidden = !q.urgenciaAviso;
      aviso.textContent = q.urgenciaAviso ?? '';

      root.hidden = true;
      progress.hidden = true;
      result.hidden = false;
      llevarA(result, 'start');
      document.querySelector<HTMLElement>('[data-plan-name]')!.focus();
    }

    function send() {
      const nombreEl = document.querySelector<HTMLInputElement>('#cot-nombre')!;
      const viaEl = document.querySelector<HTMLInputElement>('#cot-contacto')!;
      const nombre = nombreEl.value.trim();
      const via = viaEl.value.trim();
      const err = document.querySelector<HTMLElement>('[data-error]')!;

      if (!nombre || !via) {
        err.textContent = 'Falta tu nombre o por dónde te escribimos.';
        err.hidden = false;
        (nombre ? viaEl : nombreEl).focus();
        return;
      }
      /*
       * Comprobación mínima, no un validador. Antes pasaba una sola letra y el
       * mensaje llegaba con un contacto inservible: se pierde el lead sin que
       * nadie se entere. Se acepta cualquier forma de escribir un teléfono
       * —con espacios, guiones o prefijo— porque rechazar un número bueno
       * cuesta más que aceptar uno raro.
       */
      const pareceCorreo = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(via);
      const pareceTelefono = via.replace(/\D/g, '').length >= 7;
      if (!pareceCorreo && !pareceTelefono) {
        err.textContent = 'Eso no parece un WhatsApp ni un correo. Revísalo y te escribimos.';
        err.hidden = false;
        viaEl.focus();
        return;
      }
      err.hidden = true;

      const q = computeQuote(answers());
      if (!q) return;

      // `null` marca líneas que se descartan; '' son saltos de párrafo a conservar.
      const txt = [
        `Hola PanaClaw, usé el cotizador y esto me salió:`,
        '',
        `Plan: ${q.plan.name}`,
        ...q.lines
          .slice(1)
          .map(
            (l) =>
              `+ ${l.label}: ${
                l.price
                  ? l.periodo === 'mes'
                    ? formatMensual(l.price)
                    : formatMoney(l.price)
                  : 'incluido'
              }`
          ),
        '',
        `Total estimado: ${formatMoney(q.total)}`,
        // La mensualidad va en su propia línea del mensaje y solo si existe: en
        // WhatsApp no hay tipografía que la distinga, así que o se nombra o
        // desaparece dentro del total.
        isZero(q.mensual) ? null : `Mensualidad: ${formatMensual(q.mensual)}`,
        `Plazo: ${q.plan.delivery}`,
        q.urgencia ? `Lo necesito: ${q.urgencia}` : null,
        '',
        `Nombre: ${nombre}`,
        `Contacto: ${via}`,
        '',
        'Quiero la propuesta escrita.',
      ]
        .filter((l): l is string => l !== null)
        .join('\n');

      /*
       * WhatsApp en una pestaña nueva y esta se va a /gracias/, igual que el
       * formulario de /contacto.
       *
       * No es cosmético: /gracias/ es el único punto del sitio donde el píxel
       * dispara `Lead`. Antes esto terminaba aquí, con la pestaña abierta y
       * nada más, así que el camino que mejor convierte —cuatro respuestas, una
       * cifra aceptada y un mensaje ya redactado— era invisible para Meta, que
       * solo veía el formulario. Con la publicidad encendida, eso es optimizar
       * hacia visitas en vez de hacia clientes.
       *
       * El evento NO se dispara aquí a mano, a propósito: qué cuenta como
       * conversión se decide en un solo sitio (el fragmento del píxel en
       * BaseLayout, que mira la ruta). Dispararlo también aquí contaría dos
       * veces el mismo lead, y una conversión inflada engaña peor que una que
       * falta.
       *
       * Si el navegador bloquea la pestaña, manda el mensaje —que es lo que la
       * persona pidió— y se pierde la medición. Ese orden de prioridades es el
       * mismo que ya tiene /contacto.
       */
      const url = `https://wa.me/${contact.whatsappRaw}?text=${encodeURIComponent(txt)}`;
      /*
       * `window.open(…, 'noopener')` devuelve null SIEMPRE, por especificación:
       * con esa opción no hay handle que entregar. Aquí el valor decide si esta
       * pestaña se va a /gracias/ o al propio WhatsApp, así que pedirlo así
       * dejaba el camino entero roto en silencio: se abría la pestaña nueva y
       * ADEMÁS esta se iba a wa.me, o sea dos pestañas idénticas, ningún paso
       * por /gracias/ y por tanto ni un solo `Lead` contado. El código parecía
       * correcto —de ahí que se diera por comprobado— y solo se ve abriendo un
       * navegador de verdad; por eso ahora hay un arnés que lo vigila.
       *
       * Se abre sin la opción y se corta el `opener` a mano: mismo aislamiento
       * frente a la pestaña de WhatsApp, y sí devuelve la referencia.
       */
      const tab = window.open(url, '_blank');
      if (tab) tab.opener = null;
      location.href = tab ? routes.gracias : url;
    }

    const avanzar = () => (current === stepEls.length - 1 ? show() : go(current + 1));

    root.addEventListener('change', paint);
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-skip]')) {
        /*
         * "Ninguna de estas" tiene que desmarcar, no solo avanzar. Compartía el
         * atributo con "Siguiente", así que lo único que hacía era pasar de
         * paso: quien marcaba dos capacidades y luego se arrepentía llegaba al
         * resultado con las dos cobradas —hasta $1,050 de más— y con ellas
         * escritas en el mensaje de WhatsApp. Un botón que dice "ninguna" y
         * cobra dos es peor que no tener el botón.
         */
        const step = steps[current]!;
        root
          .querySelectorAll<HTMLInputElement>(`input[name="${step.id}"]:checked`)
          .forEach((input) => (input.checked = false));
        paint();
        avanzar();
      } else if (t.closest('[data-next]')) {
        avanzar();
      } else if (t.closest('[data-back]')) {
        go(current - 1);
      }
    });

    function volverAlFormulario() {
      result.hidden = true;
      root.hidden = false;
      progress.hidden = false;
      go(0);
      llevarA(progress, 'center');
    }

    document.querySelector('[data-send]')?.addEventListener('click', send);
    document.querySelector('[data-edit]')?.addEventListener('click', volverAlFormulario);
    document.querySelector('[data-restart]')?.addEventListener('click', () => {
      root.reset();
      volverAlFormulario();
    });

    paint();
  }

  /*
   * Este script se vuelve a ejecutar en cada visita a la página —así funcionan
   * las transiciones de vista— pero `document` sobrevive a la navegación. Sin
   * el guardia se registraba un `astro:page-load` más en cada visita: inertes
   * todos por el `dataset.bound`, pero acumulándose igual.
   *
   * La llamada directa basta para la primera carga: los módulos van diferidos,
   * así que el DOM ya está listo cuando esto corre.
   */
  const hooks = window as unknown as { __cotizadorHook?: boolean };
  initCotizador();
  if (!hooks.__cotizadorHook) {
    hooks.__cotizadorHook = true;
    document.addEventListener('astro:page-load', initCotizador);
  }
</script>

