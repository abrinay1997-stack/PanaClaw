---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanCard from '../components/PlanCard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';
import SectionNav from '../components/SectionNav.astro';

import { plans, diagnostico } from '../data/plans';
import { modules } from '../data/modules';
import { planVisuals } from '../data/images';
import { routes } from '../data/links';
import { site } from '../data/site';

const origin = Astro.site ?? new URL('http://localhost:4321');
const planesUrl = new URL(routes.planes, origin).toString();

/** El precio va como número: schema.org no acepta "$850". */
const toAmount = (price: string) => Number(price.replace(/[^0-9.]/g, ''));

// Catálogo de servicios: le dice a Google qué vende PanaClaw y a qué precio.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Diseño y desarrollo web — ${site.name}`,
  serviceType: 'Diseño y desarrollo de sitios web',
  description: site.description,
  areaServed: { '@type': 'Country', name: site.location },
  provider: {
    '@type': 'Organization',
    name: site.name,
    url: new URL(routes.home, origin).toString(),
  },
  offers: [...plans, diagnostico].map((item) => ({
    '@type': 'Offer',
    name: item.name,
    description: item.desc,
    price: toAmount(item.price),
    priceCurrency: 'USD',
    url: planesUrl,
    availability: 'https://schema.org/InStock',
  })),
};

/**
 * Vitrina: los dos extremos del catálogo de sitios. Muestra de dónde parte el
 * rango y hasta dónde llega, con enlace directo al formulario ya preseleccionado.
 */
const showcase = ['start', 'corporate']
  .map((slug) => ({ plan: plans.find((p) => p.slug === slug)!, visual: planVisuals[slug]! }))
  .filter((item) => item.plan && item.visual);

---

<BaseLayout
  title="Planes y precios de páginas web en Panamá"
  description="Cuatro planes fijos entre $295 y $1,200, con precio y fecha cerrados antes de empezar. Capacidades avanzadas por separado. Cero letra chica."
  activePath={routes.planes}
  jsonLd={[serviceSchema]}
>
  <!--
    Los precios van primero, sin hero de por medio: quien entra aquí ya sabe qué
    quiere ver. El argumento de venta ("Cuatro planes. Cero letra chica.") pasa
    justo debajo, cuando ya tiene las cifras delante y le sirve de respaldo.
  -->
  <section class="planes" id="planes">
    <div class="container">
      <div class="planes-head">
        <span class="eyebrow">Sitios web · $295 – $1,200</span>
        <h1 class="planes-title">Elige un plan. <span class="muted">O escríbenos si dudas.</span></h1>
      </div>

      <div class="plans-grid">
        {plans.map((plan) => (
          <Reveal>
            <PlanCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <!--
        El índice va DEBAJO de las tarjetas, no bajo el titular: los precios van
        primeros a propósito (ver el comentario de arriba) y meter una fila de
        enlaces antes los empujaría hacia abajo.

        Los tres destinos son las tres preguntas que le quedan a alguien que
        acaba de ver un precio, y dos de ellas ya no viven en esta página: Care
        se mudó a /servicios y la FAQ a /ayuda. Hasta ahora, quien miraba $850 y
        se preguntaba «¿y el mantenimiento?» o «¿de quién es el código?» no
        tenía ningún camino desde aquí.
      -->
      <div class="planes-next">
        <span class="planes-next-label">¿Y después del precio?</span>
        <SectionNav
          label="Más sobre los planes"
          items={[
            { href: '#modulos', label: 'Capacidades que se suman' },
            { href: `${routes.servicios}#care`, label: 'Mantenimiento desde $35/mes' },
            // Cuarta pregunta de quien acaba de ver un precio, y la única que
            // esta página no podía responder: «¿y el que ya tengo?». Quien
            // llega aquí con un WordPress abierto de par en par no viene a
            // comprar un sitio nuevo, viene a que alguien le diga qué hacer.
            { href: routes.seguridad, label: 'Proteger el sitio que ya tienes' },
            { href: routes.ayuda, label: 'Preguntas frecuentes' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- RESPALDO: lo que sostiene esos precios -->
  <section class="promise">
    <div class="container">
      <div class="promise-grid">
        <Reveal>
          <h2 class="promise-title">Cuatro planes. <span class="muted">Cero letra chica.</span></h2>
        </Reveal>
        <div class="promise-facts">
          <Reveal delay={0.1}>
            <div class="promise-fact">
              <span class="promise-k">Precio cerrado</span>
              <p>El número que ves es el que pagas. El alcance va por escrito antes de arrancar y lo que quede fuera se cotiza aparte, sin sorpresas a mitad del proyecto.</p>
            </div>
          </Reveal>
          <Reveal delay={0.18}>
            <div class="promise-fact">
              <span class="promise-k">Plazo cerrado</span>
              <p>Cada plan trae su cronograma. Los días cuentan desde que recibimos tu contenido y el 50 % del pago, no desde una fecha imaginaria.</p>
            </div>
          </Reveal>
          <Reveal delay={0.26}>
            <div class="promise-fact">
              <span class="promise-k">El código es tuyo</span>
              <p>El repositorio se transfiere a tu GitHub al pago final y el dominio queda a tu nombre. Si mañana te vas, te llevas todo.</p>
            </div>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- VITRINA: los dos extremos del catálogo, como escenas -->
  {showcase.map(({ plan, visual }, i) => {
    const side = i % 2 === 0 ? 'left' : 'right';
    return (
      <section class="showcase-scene" data-side={side}>
        <SceneBg visual={visual} side={side} dim={0.42} />
        <div class="container">
          <div class="showcase-copy">
            <Reveal>
              <span class="showcase-eyebrow">{i === 0 ? 'El arranque' : 'La operación completa'}</span>
              <h2>{plan.name.replace('PanaClaw ', '')}</h2>
            </Reveal>
            <Reveal delay={0.12}>
              <p class="showcase-desc">{plan.desc}</p>
              <div class="showcase-meta">
                <span class="showcase-price">{plan.price}</span>
                <span class="showcase-delivery">{plan.delivery}</span>
              </div>
              <a class="btn btn-primary" href={`${routes.contacto}?plan=${plan.slug}`}>
                <span class="dot"></span> Cotizar {plan.name.replace('PanaClaw ', '')}
              </a>
            </Reveal>
          </div>
        </div>
      </section>
    );
  })}

  <!-- CAPACIDADES AVANZADAS -->
  <section class="modulos" id="modulos">
    <div class="container">
      <span class="eyebrow">Capacidades avanzadas</span>
      <h2 class="section-title">
        ¿Tu negocio necesita más? <span class="muted">Súmale potencia.</span>
      </h2>
      <Reveal>
        <p class="modules-intro">
          Tu web no tiene por qué quedarse en una web. Cada cosa de aquí abajo se le añade a lo
          que ya tengas, con precio cerrado y sin rehacer nada: activas la que necesitas cuando la
          necesitas. Puedes empezar por una y sumar el resto más adelante.
        </p>
      </Reveal>

      <div class="modules-grid">
        {modules.map((mod, i) => (
          <Reveal>
            <ModuleCard module={mod} idx={i} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Sin hero: el nav flotante necesita aire propio arriba */
  .planes {
    padding-top: 168px;
  }
  .planes-head {
    margin-bottom: 54px;
  }
  .planes-title {
    font-size: clamp(38px, 5.6vw, 72px);
    font-weight: 600;
    line-height: 1.0;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 20ch;
  }
  .planes-title .muted {
    color: var(--studio-gray);
  }

  .planes-next {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 20px;
    margin-top: 54px;
    padding-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .planes-next-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--studio-gray);
  }

  /* Destino de #modulos: sin esto el nav flotante tapa el titular al saltar. */
  .modulos {
    scroll-margin-top: 110px;
  }

  /* ---------- RESPALDO ---------- */
  .promise {
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .promise-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
  }
  .promise-title {
    font-size: clamp(32px, 4.2vw, 56px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .promise-title .muted {
    color: var(--studio-gray);
  }
  .promise-facts {
    display: grid;
    gap: 28px;
  }
  .promise-k {
    display: block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 10px;
  }
  .promise-fact p {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    max-width: 56ch;
  }

  /* ---------- VITRINA ---------- */
  .showcase-scene {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: 110px 0;
    overflow: hidden;
  }
  .showcase-scene .container {
    position: relative;
    z-index: 1;
  }
  .showcase-copy {
    max-width: 44ch;
  }
  .showcase-scene[data-side='right'] .showcase-copy {
    margin-left: auto;
  }
  .showcase-eyebrow {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 18px;
  }
  .showcase-copy h2 {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 22px;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .showcase-desc {
    font-size: 17px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }
  .showcase-meta {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin: 26px 0 30px;
  }
  .showcase-price {
    font-size: 46px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .showcase-delivery {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
  }

  @media (max-width: 900px) {
    .planes {
      padding-top: 140px;
    }
    .promise-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .showcase-scene {
      min-height: 0;
      padding: 84px 0;
    }
    .showcase-scene[data-side='right'] .showcase-copy {
      margin-left: 0;
    }
    .showcase-copy {
      max-width: none;
    }
  }
</style>
