---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';
import CareCard from '../components/CareCard.astro';
import { services } from '../data/services';
import { carePlans, careNote } from '../data/care';
import { diagnostico } from '../data/plans';
import { seguridad, revision } from '../data/seguridad';
import { catalogo } from '../data/catalogo';
import { serviceVisuals } from '../data/images';
import { routes } from '../data/links';

/**
 * La puerta del catálogo.
 *
 * Hasta el 2026-08-11 esta página era Care disfrazada de Servicios: su `<h1>`
 * decía «Tu sitio, cuidado todos los meses», o sea que quien pulsaba «Servicios»
 * para saber qué hacemos aterrizaba en una suscripción mensual. Y los dos
 * servicios que más falta hacía encontrar —eBot y Seguridad— ni siquiera
 * estaban: tenían entrada propia en la barra y esta página los ignoraba.
 *
 * Ahora abre con las seis cosas que se venden, con su precio y su forma de
 * cobro, y Care baja a ser una de ellas. La lista sale de `catalogo.ts`, que
 * compone cada cifra de la fuente de su producto: esta es la única pantalla
 * donde se ven todos los precios juntos, y una lista comparativa con una cifra
 * vieja hace más daño que no tener lista.
 *
 * Los tres pilares siguen al final: son el porqué, y el porqué se lee después de
 * lo que se compra, no antes.
 */
---

<BaseLayout
  title="Servicios"
  description="Todo lo que hacemos y lo que cuesta: sitios web desde $295, seguridad desde $80, eBot por $70, mantenimiento desde $35/mes y el diagnóstico de tu sitio actual por $49."
  activePath={routes.servicios}
>
  <!-- EL CATÁLOGO: todo lo que se vende, en una pantalla -->
  <section class="cat">
    <div class="container">
      <div class="cat-head">
        <span class="eyebrow">Servicios</span>
        <h1>Todo lo que hacemos. <span class="muted">Y lo que cuesta.</span></h1>
        <p class="cat-lead">
          Seis cosas, ni una más. Cada una con su precio publicado y su forma de cobro — porque
          «desde $35» y «desde $35 al mes» no son lo mismo, y la mitad de las agencias solo te
          dice la primera mitad.
        </p>
      </div>

      <!--
        Una fila por producto y la primera columna es «para quién», no el
        nombre: casi nadie sabe cómo se llama lo que necesita, pero todo el
        mundo sabe en qué situación está.
      -->
      <ul class="cat-list">
        {catalogo.map((item) => (
          <Reveal>
            <li class="cat-item">
              <a class="cat-link" href={item.href}>
                <span class="cat-main">
                  <span class="cat-name">{item.name}</span>
                  <span class="cat-para">{item.paraQuien}</span>
                  <span class="cat-desc">{item.desc}</span>
                </span>
                <span class="cat-money">
                  <span class="cat-price">{item.price}</span>
                  <span class="cat-cobro">{item.cobro}</span>
                </span>
                <span class="cat-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </Reveal>
        ))}
      </ul>

      <Reveal>
        <p class="cat-foot">
          ¿No sabes cuál es lo tuyo? El <a href={routes.cotizador}>cotizador</a> te da un precio en
          cuatro preguntas, sin dejar tus datos.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- CARE -->
  <section class="care-lead" id="care">
    <div class="container">
      <div class="care-head">
        <span class="eyebrow">PanaClaw Care</span>
        <h2 class="care-title">Tu sitio, <span class="muted">cuidado todos los meses.</span></h2>
        <p class="care-lead-text">
          Care es opcional y tu sitio funciona sin él. Lo que decides no es si sigue en pie, sino
          quién se ocupa de que siga: las copias de seguridad, la vigilancia y los cambios del mes
          son trabajo de alguien. Con Care, nuestro.
        </p>
      </div>

      <div class="care-grid">
        {carePlans.map((plan) => (
          <Reveal>
            <CareCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <Reveal>
        <div class="care-note">
          <strong>Pago anual adelantado:</strong> {careNote.replace('Pago anual adelantado: ', '')}
        </div>
      </Reveal>

      <!--
        Care solo cubre lo que hicimos nosotros, y hasta ahora quien llegaba
        aquí con un sitio ajeno se iba sin nada. La distinción va escrita, no
        insinuada: son dos servicios con dos precios y confundirlos termina en
        alguien pagando dos veces lo mismo.
      -->
      <!--
        La frontera, con las mismas palabras que usa /seguridad y que responde
        el chat: se compone de `seguridad.fronteras`, no se reescribe aquí. Dos
        productos mensuales que se cuentan distinto en cada página se leen como
        el mismo producto contado mal.
      -->
      <Reveal>
        <p class="care-otro">
          {seguridad.fronteras.care} Son cosas distintas y puedes tener una sin la otra:
          <a href={routes.seguridad}>Seguridad web</a> empieza en {revision.price} y no incluye
          actualizaciones ni copias; Care no escanea vulnerabilidades ni pone un filtro contra
          ataques.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- DIAGNÓSTICO -->
  <section class="diag" id="diagnostico">
    <div class="container">
      <Reveal>
        <div class="diag-card">
          <div class="diag-copy">
            <span class="eyebrow">¿Ya tienes sitio?</span>
            <h2>{diagnostico.name}</h2>
            <p>{diagnostico.desc}</p>
            <!--
              Los dos productos que empiezan por «te revisamos el sitio» se
              distinguen aquí mismo, no en una FAQ: el que llega buscando una
              revisión no sabe cuál de los dos quiere hasta que se le dice en
              qué se diferencian.
            -->
            <p class="diag-frontera">
              Mira tu negocio, no tu seguridad: por qué no vende y cómo hacer que convierta. Si lo
              que te preocupa es que te lo tumben o te lo roben, eso es la
              <a href={routes.seguridad}>{revision.name}</a> ({revision.price}).
            </p>
            <a class="btn btn-primary" href={`${routes.contacto}?plan=${diagnostico.slug}`}>
              <span class="dot"></span> Pedir mi diagnóstico
            </a>
          </div>
          <div class="diag-price">
            <span class="diag-price-v">{diagnostico.price}</span>
            <span class="diag-price-k">Pago único · 48 horas</span>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- LOS TRES PILARES -->
  {services.map((s, i) => {
    const side = i % 2 === 0 ? 'left' : 'right';
    return (
      <section class="service-scene" data-scene={s.idx} data-side={side}>
        <SceneBg visual={serviceVisuals[s.idx]!} side={side} dim={0.4} />
        <div class="container">
          <div class="service-copy">
            <Reveal>
              <span class="service-idx">{s.idx} · Por qué</span>
              <h2>{s.title}</h2>
            </Reveal>
            <Reveal delay={0.12}>
              <p class="service-short">{s.desc}</p>
            </Reveal>
            <Reveal delay={0.22}>
              <p class="service-long">{s.longDesc}</p>
            </Reveal>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  /* ---------- CARE ---------- */
  /* ---------- CATÁLOGO ---------- */
  /* Sin hero: el nav flotante necesita su aire arriba, igual que en /planes. */
  .cat {
    padding-top: 168px;
    padding-bottom: 80px;
  }
  .cat-head {
    margin-bottom: 50px;
  }
  .cat-head h1 {
    font-size: clamp(38px, 5.6vw, 72px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .cat-head h1 .muted {
    color: var(--studio-gray);
  }
  .cat-lead {
    margin-top: 22px;
    max-width: 62ch;
    font-size: 17px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.7;
  }

  .cat-list {
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  /* Toda la fila es el enlace: en una lista de seis, obligar a apuntar al
     nombre convierte una decisión en puntería. */
  .cat-link {
    display: grid;
    grid-template-columns: 1fr auto 28px;
    align-items: center;
    gap: 30px;
    padding: 26px 8px 26px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 0.25s, padding-left 0.25s;
  }
  .cat-link:hover {
    background: rgba(255, 81, 0, 0.05);
    padding-left: 14px;
  }
  .cat-link:focus-visible {
    outline: 2px solid var(--flash-orange);
    outline-offset: -2px;
  }
  .cat-name {
    display: block;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  /* La situación del cliente, en naranja: es la línea por la que se reconoce a
     sí mismo, y es lo que decide el clic. */
  .cat-para {
    display: block;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 10px;
  }
  .cat-desc {
    display: block;
    max-width: 62ch;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }
  .cat-money {
    text-align: right;
  }
  .cat-price {
    display: block;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  /* Cómo se cobra, del mismo tamaño que una nota pero SIEMPRE presente: es la
     mitad del precio que casi nadie publica. */
  .cat-cobro {
    display: block;
    margin-top: 5px;
    font-size: 12.5px;
    font-weight: 300;
    color: var(--studio-gray);
  }
  .cat-arrow {
    font-size: 20px;
    color: var(--studio-gray);
    transition: transform 0.25s, color 0.25s;
  }
  .cat-link:hover .cat-arrow {
    color: var(--flash-orange);
    transform: translateX(4px);
  }
  .cat-foot {
    margin-top: 34px;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
  }
  .cat-foot a {
    color: var(--flash-orange);
  }

  /* ---------- CARE ---------- */
  .care-lead {
    padding-top: 40px;
    padding-bottom: 90px;
    scroll-margin-top: 110px;
  }
  .care-head {
    margin-bottom: 54px;
  }
  .care-title {
    font-size: clamp(32px, 4.4vw, 56px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .care-title .muted {
    color: var(--studio-gray);
  }
  .care-otro {
    max-width: 64ch;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.7;
  }
  .care-otro a {
    color: var(--flash-orange);
  }
  .care-lead-text {
    margin-top: 24px;
    max-width: 54ch;
    font-size: 18px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }

  /* ---------- DIAGNÓSTICO ---------- */
  .diag {
    padding: 40px 0 100px;
  }
  .diag-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 44px;
    align-items: center;
    padding: 44px 46px;
    border-radius: 24px;
    background: linear-gradient(120deg, rgba(255, 81, 0, 0.16), rgba(238, 0, 0, 0.06));
    border: 1px solid rgba(255, 81, 0, 0.4);
  }
  .diag-copy h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 6px 0 16px;
  }
  /* Con `.diag-copy` delante a propósito: la regla `.diag-copy p` de abajo tiene
     más especificidad y se comía el tamaño y el color de esta nota. Es la
     trampa que `convenciones.md` documenta para `.container`. */
  .diag-copy .diag-frontera {
    margin-top: 14px;
    max-width: 58ch;
    font-size: 14px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }
  .diag-copy .diag-frontera a {
    color: var(--flash-orange);
  }
  .diag-copy p {
    max-width: 58ch;
    font-size: 16px;
    font-weight: 300;
    color: var(--soft-white);
    line-height: 1.65;
    margin-bottom: 28px;
  }
  .diag-price {
    text-align: right;
  }
  .diag-price-v {
    display: block;
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .diag-price-k {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
  }

  /* ---------- PILARES ---------- */
  .service-scene {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: 120px 0;
    overflow: hidden;
  }
  .service-scene .container {
    position: relative;
    z-index: 1;
  }
  .service-copy {
    max-width: 46ch;
  }
  .service-scene[data-side='right'] .service-copy {
    margin-left: auto;
  }
  .service-idx {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 20px;
  }
  .service-copy h2 {
    font-size: clamp(38px, 5.4vw, 68px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin-bottom: 26px;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .service-short {
    font-size: 20px;
    font-weight: 400;
    color: var(--soft-white);
    margin-bottom: 22px;
    line-height: 1.4;
    text-shadow: 0 2px 24px rgba(16, 1, 1, 0.9);
  }
  .service-long {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }

  @media (max-width: 900px) {
    .cat {
      padding-top: 140px;
    }
    /* El precio baja debajo del texto, no encoge: en una lista de compra, la
       cifra apretada contra el borde en dos líneas es lo primero que deja de
       leerse. La flecha se va — en un teléfono no hay hover que la explique. */
    .cat-link {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px 0;
    }
    .cat-link:hover {
      padding-left: 0;
    }
    .cat-money {
      text-align: left;
    }
    .cat-price {
      font-size: 22px;
    }
    .cat-arrow {
      display: none;
    }
    .diag-card {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 32px 26px;
    }
    .diag-price {
      text-align: left;
    }
    .service-scene {
      min-height: 0;
      padding: 90px 0;
    }
    .service-scene[data-side='right'] .service-copy {
      margin-left: 0;
    }
    .service-copy {
      max-width: none;
    }
  }
</style>
