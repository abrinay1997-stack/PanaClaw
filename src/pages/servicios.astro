---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';
import CareCard from '../components/CareCard.astro';
import { services } from '../data/services';
import { carePlans, careNote } from '../data/care';
import { diagnostico } from '../data/plans';
import { seguridad, revision } from '../data/seguridad';
import { serviceVisuals } from '../data/images';
import { routes } from '../data/links';

/**
 * La página abre con Care y con el Diagnóstico, no con el discurso.
 *
 * Mismo criterio que en /planes: quien entra a "Servicios" viene a ver qué se
 * contrata y cuánto cuesta. Los tres pilares son el porqué, y el porqué se lee
 * después de lo que se compra, no antes.
 */
---

<BaseLayout
  title="Servicios"
  description="Mantenimiento mensual desde $35, diagnóstico de tu sitio actual por $49 y las tres razones por las que un sitio PanaClaw rinde distinto."
  activePath={routes.servicios}
>
  <!-- CARE: lo primero que se ve -->
  <section class="care-lead" id="care">
    <div class="container">
      <div class="care-head">
        <span class="eyebrow">Servicios · PanaClaw Care</span>
        <h1>Tu sitio, <span class="muted">cuidado todos los meses.</span></h1>
        <p class="care-lead-text">
          Care es opcional y tu sitio funciona sin él. Lo que decides no es si sigue en pie, sino
          quién se ocupa de que siga: las copias de seguridad, la vigilancia y los cambios del mes
          son trabajo de alguien. Con Care, nuestro.
        </p>
      </div>

      <div class="care-grid">
        {carePlans.map((plan) => (
          <Reveal>
            <CareCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <Reveal>
        <div class="care-note">
          <strong>Pago anual adelantado:</strong> {careNote.replace('Pago anual adelantado: ', '')}
        </div>
      </Reveal>

      <!--
        Care solo cubre lo que hicimos nosotros, y hasta ahora quien llegaba
        aquí con un sitio ajeno se iba sin nada. La distinción va escrita, no
        insinuada: son dos servicios con dos precios y confundirlos termina en
        alguien pagando dos veces lo mismo.
      -->
      <!--
        La frontera, con las mismas palabras que usa /seguridad y que responde
        el chat: se compone de `seguridad.fronteras`, no se reescribe aquí. Dos
        productos mensuales que se cuentan distinto en cada página se leen como
        el mismo producto contado mal.
      -->
      <Reveal>
        <p class="care-otro">
          {seguridad.fronteras.care} Son cosas distintas y puedes tener una sin la otra:
          <a href={routes.seguridad}>Seguridad web</a> empieza en {revision.price} y no incluye
          actualizaciones ni copias; Care no escanea vulnerabilidades ni pone un filtro contra
          ataques.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- DIAGNÓSTICO -->
  <section class="diag" id="diagnostico">
    <div class="container">
      <Reveal>
        <div class="diag-card">
          <div class="diag-copy">
            <span class="eyebrow">¿Ya tienes sitio?</span>
            <h2>{diagnostico.name}</h2>
            <p>{diagnostico.desc}</p>
            <!--
              Los dos productos que empiezan por «te revisamos el sitio» se
              distinguen aquí mismo, no en una FAQ: el que llega buscando una
              revisión no sabe cuál de los dos quiere hasta que se le dice en
              qué se diferencian.
            -->
            <p class="diag-frontera">
              Mira tu negocio, no tu seguridad: por qué no vende y cómo hacer que convierta. Si lo
              que te preocupa es que te lo tumben o te lo roben, eso es la
              <a href={routes.seguridad}>{revision.name}</a> ({revision.price}).
            </p>
            <a class="btn btn-primary" href={`${routes.contacto}?plan=${diagnostico.slug}`}>
              <span class="dot"></span> Pedir mi diagnóstico
            </a>
          </div>
          <div class="diag-price">
            <span class="diag-price-v">{diagnostico.price}</span>
            <span class="diag-price-k">Pago único · 48 horas</span>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- LOS TRES PILARES -->
  {services.map((s, i) => {
    const side = i % 2 === 0 ? 'left' : 'right';
    return (
      <section class="service-scene" data-scene={s.idx} data-side={side}>
        <SceneBg visual={serviceVisuals[s.idx]!} side={side} dim={0.4} />
        <div class="container">
          <div class="service-copy">
            <Reveal>
              <span class="service-idx">{s.idx} · Por qué</span>
              <h2>{s.title}</h2>
            </Reveal>
            <Reveal delay={0.12}>
              <p class="service-short">{s.desc}</p>
            </Reveal>
            <Reveal delay={0.22}>
              <p class="service-long">{s.longDesc}</p>
            </Reveal>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  /* ---------- CARE ---------- */
  .care-lead {
    padding-top: 168px;
    padding-bottom: 90px;
  }
  .care-head {
    margin-bottom: 54px;
  }
  .care-head h1 {
    font-size: clamp(38px, 5.6vw, 72px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .care-head h1 .muted {
    color: var(--studio-gray);
  }
  .care-otro {
    max-width: 64ch;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.7;
  }
  .care-otro a {
    color: var(--flash-orange);
  }
  .care-lead-text {
    margin-top: 24px;
    max-width: 54ch;
    font-size: 18px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }

  /* ---------- DIAGNÓSTICO ---------- */
  .diag {
    padding: 40px 0 100px;
  }
  .diag-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 44px;
    align-items: center;
    padding: 44px 46px;
    border-radius: 24px;
    background: linear-gradient(120deg, rgba(255, 81, 0, 0.16), rgba(238, 0, 0, 0.06));
    border: 1px solid rgba(255, 81, 0, 0.4);
  }
  .diag-copy h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 6px 0 16px;
  }
  /* Con `.diag-copy` delante a propósito: la regla `.diag-copy p` de abajo tiene
     más especificidad y se comía el tamaño y el color de esta nota. Es la
     trampa que `convenciones.md` documenta para `.container`. */
  .diag-copy .diag-frontera {
    margin-top: 14px;
    max-width: 58ch;
    font-size: 14px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }
  .diag-copy .diag-frontera a {
    color: var(--flash-orange);
  }
  .diag-copy p {
    max-width: 58ch;
    font-size: 16px;
    font-weight: 300;
    color: var(--soft-white);
    line-height: 1.65;
    margin-bottom: 28px;
  }
  .diag-price {
    text-align: right;
  }
  .diag-price-v {
    display: block;
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .diag-price-k {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
  }

  /* ---------- PILARES ---------- */
  .service-scene {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: 120px 0;
    overflow: hidden;
  }
  .service-scene .container {
    position: relative;
    z-index: 1;
  }
  .service-copy {
    max-width: 46ch;
  }
  .service-scene[data-side='right'] .service-copy {
    margin-left: auto;
  }
  .service-idx {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 20px;
  }
  .service-copy h2 {
    font-size: clamp(38px, 5.4vw, 68px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin-bottom: 26px;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .service-short {
    font-size: 20px;
    font-weight: 400;
    color: var(--soft-white);
    margin-bottom: 22px;
    line-height: 1.4;
    text-shadow: 0 2px 24px rgba(16, 1, 1, 0.9);
  }
  .service-long {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }

  @media (max-width: 900px) {
    .care-lead {
      padding-top: 140px;
    }
    .diag-card {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 32px 26px;
    }
    .diag-price {
      text-align: left;
    }
    .service-scene {
      min-height: 0;
      padding: 90px 0;
    }
    .service-scene[data-side='right'] .service-copy {
      margin-left: 0;
    }
    .service-copy {
      max-width: none;
    }
  }
</style>
