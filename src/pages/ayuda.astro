---
import Icono from '../components/Icono.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { faqGroups, faq } from '../data/faq';
import { getCollection } from 'astro:content';
import { routes } from '../data/links';
import { site, contact, waLink } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recientes = posts.slice(0, 6);
const etiquetas: Record<string, string> = {
  precios: 'Precios', guias: 'Guía', comparativas: 'Comparativa', casos: 'Caso', panama: 'Panamá',
};
const fecha = (d: Date) =>
  new Intl.DateTimeFormat('es-PA', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);

/**
 * Centro de ayuda.
 *
 * Antes era un acordeón al final de /planes con cinco preguntas. Ahí solo lo
 * leía quien ya estaba decidido; las dudas que frenan la compra aparecen mucho
 * antes y en otro sitio. Ahora es una página propia, agrupada por el momento en
 * que surge cada duda, no por categoría interna.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="Ayuda: precios, plazos y de quién es el sitio"
  description="Las dudas reales antes de encargar una web: precios, plazos, qué tienes que tener listo, qué pasa si no te gusta y de quién es el sitio al final."
  activePath={routes.ayuda}
  jsonLd={[faqSchema]}
>
  <section class="ayuda">
    <div class="container">
      <header class="ayuda-head">
        <span class="eyebrow">Ayuda</span>
        <h1>Las preguntas <span class="muted">que de verdad importan.</span></h1>
        <p class="ayuda-lead">
          Para alguien que nunca ha encargado una web. Busca tu duda o elige un tema: todo está en
          esta misma pantalla.
        </p>
      </header>

      <!--
        UN SOLO PANEL. Ayuda es la única página que no necesita secciones de
        pantalla completa: aquí se viene a encontrar una respuesta rápido. Buscador
        arriba, temas a la izquierda, preguntas a la derecha y el blog como un tema
        más. Sin JavaScript se ve todo en una sola lista; con él, un tema a la vez.
      -->
      <div class="ayuda-panel" data-ayuda>
        <div class="ayuda-barra">
          <label class="sr-only" for="ayuda-q">Buscar en la ayuda</label>
          <input id="ayuda-q" class="ayuda-buscar" type="search" autocomplete="off" placeholder="Busca tu duda: precio, plazo, el código, pagos…" data-ayuda-q />
          <p class="ayuda-cuenta" data-ayuda-cuenta aria-live="polite"></p>
        </div>

        <div class="ayuda-cuerpo">
          <div class="ayuda-cats" role="group" aria-label="Temas de ayuda">
            <button type="button" class="ayuda-cat is-activa" data-cat="todas">Todas</button>
            {faqGroups.map((g) => (
              <button type="button" class="ayuda-cat" data-cat={g.id}>{g.title}<span class="ayuda-n">{g.items.length}</span></button>
            ))}
            <button type="button" class="ayuda-cat" data-cat="blog">Del blog<span class="ayuda-n">{recientes.length}</span></button>
          </div>

          <div class="ayuda-contenido">
            {faqGroups.map((group) => (
              <section class="ayuda-group" id={group.id} data-grupo={group.id} aria-label={group.title}>
                <header class="ayuda-group-head">
                  <h2>{group.title}</h2>
                  <p>{group.intro}</p>
                </header>
                <div class="ayuda-items">
                  {group.items.map((item) => (
                    <details class="ayuda-item">
                      <summary>
                        <span>{item.q}</span>
                        <span class="ayuda-mark" aria-hidden="true"></span>
                      </summary>
                      <p>{item.a}</p>
                    </details>
                  ))}
                </div>
              </section>
            ))}

            <section class="ayuda-group ayuda-blog" id="blog" data-grupo="blog" aria-label="Del blog">
              <header class="ayuda-group-head">
                <h2>Del blog</h2>
                <p>Lo último que escribimos, sin jerga y con datos reales. <a href={routes.blog}>Ver los {posts.length} artículos →</a></p>
              </header>
              <ul class="ayuda-posts">
                {recientes.map((post) => (
                  <li data-post>
                    <a class="ayuda-post" href={`/blog/${post.id.replace(/\.md$/, '')}/`}>
                      <span class="ayuda-post-meta">{etiquetas[post.data.category] ?? post.data.category} · {fecha(post.data.date)}</span>
                      <span class="ayuda-post-title">{post.data.title}</span>
                      <span class="ayuda-post-go" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>

            <p class="ayuda-vacio" data-ayuda-vacio hidden>
              Nada coincide con tu búsqueda. Prueba con otra palabra, o pregúntanos directo abajo.
            </p>
          </div>
        </div>
      </div>

      <aside class="ayuda-more">
        <p>
          <strong>¿No está tu pregunta?</strong> Te respondemos en horario laboral ({contact.horario}); contesta la misma persona que programaría tu sitio.
        </p>
        <div class="ayuda-more-actions">
          <a class="btn btn-primary" href={waLink(`Hola ${site.name}, tengo una pregunta`)} target="_blank" rel="noopener">
            <Icono nombre="whatsapp" /> Preguntar por WhatsApp
          </a>
          <a class="btn btn-ghost" href={routes.contacto}>Escribir un mensaje</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .ayuda { padding: 100px 0 var(--e5); }
  .ayuda-head { margin-bottom: var(--e3); }
  .ayuda-head h1 {
    font-size: clamp(30px, 4vw, 54px);
    font-weight: 600; line-height: 1; letter-spacing: -0.025em; text-transform: uppercase; max-width: none;
  }
  .ayuda-head h1 .muted { color: var(--studio-gray); }
  .ayuda-lead { margin-top: var(--e1); max-width: 60ch; font-size: 16px; font-weight: 300; color: var(--studio-gray); line-height: 1.55; }

  .ayuda-barra { display: flex; align-items: center; gap: var(--e3); margin-bottom: var(--e2); }
  .ayuda-buscar {
    flex: 1; min-width: 0; font: inherit; font-size: 16px; color: var(--soft-white);
    padding: 14px var(--e3); border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.04);
    transition: border-color .2s, background .2s;
  }
  .ayuda-buscar::placeholder { color: rgba(255, 247, 247, 0.4); }
  .ayuda-buscar:focus { outline: none; border-color: var(--flash-orange); background: rgba(255, 81, 0, 0.06); }
  .ayuda-cuenta { font-size: 13px; letter-spacing: .06em; color: var(--studio-gray); white-space: nowrap; min-width: 9ch; text-align: right; }

  .ayuda-cuerpo { display: grid; grid-template-columns: 250px 1fr; gap: var(--e4); align-items: start; }
  .ayuda-cats { position: sticky; top: 96px; display: grid; gap: 4px; }
  .ayuda-cat {
    display: flex; align-items: center; justify-content: space-between; gap: var(--e1);
    text-align: left; font: inherit; font-size: 15px; color: var(--studio-gray); cursor: pointer;
    padding: 11px var(--e2); border-radius: 12px; border: 1px solid transparent; background: transparent;
    transition: color .2s, background .2s, border-color .2s;
  }
  .ayuda-cat:hover { color: var(--soft-white); background: rgba(255, 255, 255, 0.05); }
  .ayuda-cat:focus-visible { outline: 2px solid var(--flash-orange); outline-offset: 2px; }
  .ayuda-cat.is-activa { color: var(--soft-white); border-color: rgba(255, 81, 0, 0.55); background: rgba(255, 81, 0, 0.1); }
  .ayuda-n { font-size: 12px; color: var(--flash-orange); font-variant-numeric: tabular-nums; }

  .ayuda-group { padding-bottom: var(--e3); scroll-margin-top: 100px; }
  .ayuda-group:not([hidden]) ~ .ayuda-group:not([hidden]) { padding-top: var(--e3); border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .ayuda-group-head h2 { font-size: clamp(22px, 2.4vw, 30px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .ayuda-group-head p { margin: 6px 0 var(--e2); font-size: 14.5px; font-weight: 300; color: var(--studio-gray); line-height: 1.5; max-width: 62ch; }
  .ayuda-group-head a { color: var(--flash-orange); text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 1px; }

  .ayuda-item { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .ayuda-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--e3);
    padding: 14px 0; font-size: 16px; font-weight: 500; line-height: 1.4; cursor: pointer; list-style: none;
  }
  .ayuda-item summary::-webkit-details-marker { display: none; }
  .ayuda-item summary:hover { color: var(--flash-orange); }
  .ayuda-mark { position: relative; flex-shrink: 0; width: 16px; height: 16px; }
  .ayuda-mark::before, .ayuda-mark::after { content: ''; position: absolute; inset: 0; margin: auto; background: var(--flash-orange); transition: transform .25s ease; }
  .ayuda-mark::before { width: 16px; height: 1.5px; }
  .ayuda-mark::after { width: 1.5px; height: 16px; }
  .ayuda-item[open] .ayuda-mark::after { transform: rotate(90deg); }
  .ayuda-item p { padding: 0 0 var(--e2); max-width: 68ch; font-size: 15.5px; font-weight: 300; color: var(--studio-gray); line-height: 1.7; }

  .ayuda-posts { list-style: none; display: grid; }
  .ayuda-post {
    display: grid; grid-template-columns: 1fr auto; gap: 2px var(--e3); align-items: center;
    padding: 13px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: padding-left .25s, background .25s;
  }
  .ayuda-post:hover { padding-left: var(--e1); background: rgba(255, 81, 0, 0.05); }
  .ayuda-post:focus-visible { outline: 2px solid var(--flash-orange); outline-offset: -2px; }
  .ayuda-post-meta { grid-column: 1; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--flash-orange); }
  .ayuda-post-title { grid-column: 1; font-size: 16.5px; font-weight: 500; line-height: 1.35; }
  .ayuda-post-go { grid-column: 2; grid-row: 1 / span 2; color: var(--studio-gray); transition: transform .25s, color .25s; }
  .ayuda-post:hover .ayuda-post-go { color: var(--flash-orange); transform: translateX(4px); }

  .ayuda-vacio { padding: var(--e4) 0; color: var(--studio-gray); font-size: 16px; }

  .ayuda-more {
    display: flex; align-items: center; justify-content: space-between; gap: var(--e3); flex-wrap: wrap;
    margin-top: var(--e3); padding: var(--e2) var(--e3);
    border-radius: 18px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.03);
  }
  .ayuda-more p { max-width: 62ch; font-size: 15px; font-weight: 300; color: var(--studio-gray); line-height: 1.55; }
  .ayuda-more strong { color: var(--soft-white); font-weight: 600; }
  .ayuda-more-actions { display: flex; gap: var(--e1); flex-wrap: wrap; }

  @media (max-width: 900px) {
    .ayuda { padding-top: 104px; }
    .ayuda-barra { flex-direction: column; align-items: stretch; gap: 6px; }
    .ayuda-cuenta { text-align: left; min-height: 1.2em; }
    .ayuda-cuerpo { grid-template-columns: 1fr; gap: var(--e2); }
    /* En el teléfono los temas son una fila que se desliza de lado, no una columna. */
    .ayuda-cats { position: static; display: flex; overflow-x: auto; gap: 8px; padding-bottom: 4px; scrollbar-width: none; margin-inline: calc(var(--e3) * -1); padding-inline: var(--e3); }
    .ayuda-cats::-webkit-scrollbar { display: none; }
    .ayuda-cat { flex: none; white-space: nowrap; border-color: rgba(255, 255, 255, 0.14); border-radius: 999px; }
  }
</style>

<script>
  /**
   * Panel de ayuda: un tema a la vez, y un buscador que mira todas las preguntas.
   * Sin este script la página muestra todo en una sola lista (ver `data-js`).
   */
  function iniciarAyuda() {
    const raiz = document.querySelector<HTMLElement>('[data-ayuda]');
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = '1';
    raiz.dataset.js = '1';
    const cats = Array.from(raiz.querySelectorAll<HTMLButtonElement>('.ayuda-cat'));
    const grupos = Array.from(raiz.querySelectorAll<HTMLElement>('.ayuda-group'));
    const q = raiz.querySelector<HTMLInputElement>('[data-ayuda-q]')!;
    const cuenta = raiz.querySelector<HTMLElement>('[data-ayuda-cuenta]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-ayuda-vacio]')!;
    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    let activa = cats[1]?.dataset.cat ?? 'todas'; // el primer tema, no todos

    function pintar() {
      const term = norm(q.value.trim());
      let total = 0;
      grupos.forEach((g) => {
        const propio = activa === 'todas' || g.dataset.grupo === activa || term !== '';
        let visibles = 0;
        g.querySelectorAll<HTMLElement>('.ayuda-item, [data-post]').forEach((el) => {
          const ok = !term || norm(el.textContent ?? '').includes(term);
          el.hidden = !ok;
          if (ok) visibles += 1;
        });
        const mostrar = propio && visibles > 0;
        g.hidden = !mostrar;
        if (mostrar) total += visibles;
      });
      vacio.hidden = total > 0;
      cuenta.textContent = term ? `${total} ${total === 1 ? 'resultado' : 'resultados'}` : '';
      cats.forEach((c) => c.classList.toggle('is-activa', !term && c.dataset.cat === activa));
    }

    cats.forEach((c) => c.addEventListener('click', () => { q.value = ''; activa = c.dataset.cat ?? 'todas'; pintar(); }));
    q.addEventListener('input', pintar);
    pintar();
  }
  iniciarAyuda();
  document.addEventListener('astro:page-load', iniciarAyuda);
</script>
