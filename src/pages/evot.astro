  .evot-propiedad-fact p {
    max-width: 56ch;
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
  }

  /* ---------- PREGUNTAS ---------- */
  /* Mismo acordeón que /ayuda: es el patrón que el sitio ya tiene y copiar su
     comportamiento evita que dos preguntas frecuentes se abran distinto. */
  .evot-faq-items {
    display: grid;
    gap: 2px;
    max-width: 90ch;
  }
  .evot-faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .evot-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  .evot-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .evot-faq-item summary:hover {
    color: var(--flash-orange);
  }
  .evot-mark {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }
  .evot-mark::before,
  .evot-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--flash-orange);
    transition: transform 0.25s ease;
  }
  .evot-mark::before {
    width: 16px;
    height: 1.5px;
  }
  .evot-mark::after {
    width: 1.5px;
    height: 16px;
  }
  .evot-faq-item[open] .evot-mark::after {
    transform: rotate(90deg);
  }
  .evot-faq-item p {
    padding: 0 0 24px;
    max-width: 68ch;
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
