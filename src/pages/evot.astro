  .evot-no {
    margin-top: 54px;
    padding: 34px 36px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.02);
  }

  /* ---------- PROPIEDAD ---------- */
  .evot-propiedad {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 100px 0;
  }
  .evot-propiedad-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
  }
  .evot-propiedad-title {
    font-size: clamp(32px, 4.2vw, 56px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .evot-propiedad-title .muted {
    color: var(--studio-gray);
  }
  .evot-propiedad-facts {
    display: grid;
    gap: 28px;
  }
  .evot-propiedad-k {
    display: block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 10px;
