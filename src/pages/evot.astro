  .evot-faq-foot {
    margin-top: 34px;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
  }
  .evot-faq-foot a {
    color: var(--flash-orange);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1024px) {
    .evot-canal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .evot-hace-grid,
    .evot-panel-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .evot-hero {
      min-height: 0;
      padding: 150px 0 90px;
    }
    .evot-hero-copy {
      max-width: none;
    }
    .evot-precio-card {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 32px 26px;
    }
    .evot-precio-tag {
      text-align: left;
    }
    .evot-costo-grid,
    .evot-propiedad-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .evot-no {
      padding: 28px 24px;
    }
    .evot-propiedad {
      padding: 80px 0;
    }
  }
  /*
    En el teléfono todo se apila y la página se convierte en la más larga del
    sitio. No se recorta contenido para arreglarlo —lo que hay que leer para
    comprar un bot es lo que hay—, se recorta el aire: relleno de tarjeta y hueco
    entre ellas. Son ~1 200 px menos de scroll sin quitar una sola frase.
  */
  @media (max-width: 640px) {
    .evot-canal-grid {
      grid-template-columns: 1fr;
    }
    .evot-canal-grid,
    .evot-hace-grid,
    .evot-panel-grid,
    .evot-costo-grid {
      gap: 12px;
    }
    .evot-canal,
    .evot-cap,
    .evot-panel-group,
    .evot-costo {
      padding: 24px 22px;
    }
    .evot-intro {
      margin-bottom: 32px;
    }
    .evot-index {
      margin-bottom: 32px;
      padding-bottom: 26px;
    }
    .evot-costos {
      margin-top: 44px;
    }
    .evot-no {
      margin-top: 38px;
    }
  }
</style>

<style is:global>
  /* <Reveal> mete un <div> entre la grid y la tarjeta, así que la tarjeta deja
     de ser el item de grid y no se estira a la altura de la fila. Mismo apaño
     que `global.css` aplica a las grids del resto del sitio, aquí con los
     nombres de esta página. Va en `is:global` porque el nodo intermedio lo
     genera el componente y no lleva el `data-astro-cid` de esta página. */
  .evot-canal-grid > .reveal,
  .evot-hace-grid > .reveal,
  .evot-panel-grid > .reveal,
  .evot-costo-grid > .reveal {
    display: flex;
    flex-direction: column;
  }
  .evot-canal-grid > .reveal > *,
  .evot-hace-grid > .reveal > *,
  .evot-panel-grid > .reveal > *,
  .evot-costo-grid > .reveal > * {
    flex: 1 1 auto;
  }
</style>
