---
/**
 * /evot/ — la página del bot multicanal con panel.
 *
 * Es la primera página del sitio que vende algo que NO es una web, y eso cambia
 * dos cosas respecto a `/planes`:
 *
 * 1. **El precio no basta.** Con $70 delante, la pregunta que frena no es
 *    «¿es caro?» sino «¿dónde está la trampa?». Por eso los dos gastos que no
 *    cobramos nosotros —la nube y la llave de IA— van publicados con el mismo
 *    tamaño que la implementación, y no en una nota al pie. Callarlos sería la
 *    letra chica que el resto del sitio dice no tener.
 * 2. **Hay que enseñar el panel por dentro.** Un plan de web se entiende sin
 *    verlo; una bandeja de mensajes, no. Los nombres de las trece pantallas son
 *    los reales, para que el día de la entrega no haya que buscar nada.
 *
 * REGLA 13 DEL PROYECTO: aquí NO va un bloque de cierre «¿Empezamos?» — ese vive
 * solo en /proceso. La salida de esta página es el CTA del nav, el del hero y el
 * del bloque de precio, y ni uno más.
 *
 * Todo el contenido sale de `src/data/evot.ts`. Esta página no escribe una sola
 * cifra ni una sola característica a mano: lo que se cambie ahí cambia aquí, en
 * el desplegable de /contacto y en lo que responde el chat, en el mismo build.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';
import SectionNav from '../components/SectionNav.astro';

import {
  evot,
  evotCanales,
  evotCapacidades,
  evotPanel,
  evotCostos,
  evotIncluye,
  evotNoIncluye,
  evotPropiedad,
  evotFaq,
  evotContactHref,
} from '../data/evot';
import { evotVisual } from '../data/images';
import { routes } from '../data/links';
import { site, waLink } from '../data/site';

const origin = Astro.site ?? new URL('http://localhost:4321');
const evotUrl = new URL(routes.evot, origin).toString();

/** El precio va como número: schema.org no acepta "$70". */
const amount = Number(evot.price.replace(/[^0-9.]/g, ''));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${evot.name} — bot multicanal con panel`,
  serviceType: 'Implementación de asistente automatizado para atención al cliente',
  description: evot.summary,
  areaServed: { '@type': 'Country', name: site.location },
  provider: {
    '@type': 'Organization',
    name: site.name,
    url: new URL(routes.home, origin).toString(),
  },
  offers: {
    '@type': 'Offer',
    name: `Implementación de ${evot.name}`,
    description: evotIncluye.join('. '),
    price: amount,
    priceCurrency: 'USD',
    url: evotUrl,
    availability: 'https://schema.org/InStock',
  },
};

/*
 * Las preguntas de esta página también van como datos estructurados. No pisan
 * las de /ayuda: son otras preguntas, en otra URL, y ninguna se repite entre las
 * dos — si algún día se repitiera, se quita de una de las dos, porque el mismo
 * par pregunta/respuesta declarado en dos sitios es contenido duplicado.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: evotFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const canalNames = evotCanales.map((c) => c.name).join(', ');

/**
 * Cuántas pantallas trae el panel. Se cuenta, no se escribe: el titular anuncia
 * la cifra y una pantalla nueva en `evot.ts` la dejaría desactualizada — que es
 * exactamente la clase de dato inventado que la regla 14 prohíbe.
 */
const pantallas = evotPanel.reduce((n, g) => n + g.items.length, 0);
---

<BaseLayout
  title={`${evot.name} — bot multicanal`}
  description={`${evot.name}: contesta por ${canalNames} las 24 horas y guarda cada conversación y cada cliente en un panel tuyo. Implementación ${evot.price}, pago único, sin mensualidad nuestra.`}
  activePath={routes.evot}
  jsonLd={[serviceSchema, faqSchema]}
>
  <!-- HERO -->
  <section class="evot-hero">
    <SceneBg visual={evotVisual} side="left" />
    <div class="container">
      <div class="evot-hero-copy">
        <Reveal>
          <span class="eyebrow">{evot.name} · Bot multicanal con panel</span>
          <h1>Todos tus mensajes, <span class="muted">en un solo lugar.</span></h1>
        </Reveal>
        <Reveal delay={0.12}>
          <p class="evot-lead">{evot.summary}</p>
        </Reveal>
        <Reveal delay={0.2}>
          <div class="evot-hero-price">
            <span class="evot-hero-amount">{evot.price}</span>
            <span class="evot-hero-kicker">{evot.priceKicker}</span>
          </div>
          <div class="evot-hero-actions">
            <a class="btn btn-primary" href={evotContactHref}>
              <span class="dot"></span> Quiero {evot.name}
            </a>
            <a
              class="btn btn-ghost"
              href={waLink(`Hola ${site.name}, quiero ${evot.name} para mi negocio. Mi negocio es: `)}
              target="_blank"
              rel="noopener"
            >
              Preguntar por WhatsApp
            </a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- CANALES: lo primero que hay que creer es que entra por donde te escriben -->
  <section class="evot-canales" id="canales">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Los cuatro canales</span>
        <h2 class="section-title">Contesta por donde <span class="muted">ya te escriben.</span></h2>
      </Reveal>
      <Reveal>
        <p class="evot-intro">
          No hay que enseñarle a nadie a usar una aplicación nueva. Tu cliente escribe donde
          siempre escribió y le contestan igual de rápido a las tres de la tarde que a las once de
          la noche. Tú lo ves todo desde una sola pantalla.
        </p>
      </Reveal>

      <!--
        El índice va arriba, antes de las tarjetas, y no al final de la sección:
        esta es con diferencia la página más larga del sitio (medido abajo, en
        docs/ESTADO.md) y un índice al que se llega scrolleando 2 400 px en el
        teléfono no le ahorra el scroll a nadie. Las dos reglas de <SectionNav>
        se respetan: cada destino declara su `id` y su `scroll-margin-top`.
      -->
      <div class="evot-index">
        <span class="evot-index-label">Salta a lo que viniste a ver</span>
        <SectionNav
          label={`Secciones de ${evot.name}`}
          items={[
            { href: '#hace', label: 'Qué hace' },
            { href: '#panel', label: 'El panel por dentro' },
            { href: '#precio', label: 'Qué cuesta de verdad' },
            { href: '#preguntas', label: 'Preguntas' },
          ]}
        />
      </div>

      <div class="evot-canal-grid">
        {evotCanales.map((canal) => (
          <Reveal>
            <div class="evot-canal">
              <h3>{canal.name}</h3>
              <p>{canal.desc}</p>
              {canal.nota && <p class="evot-canal-nota">{canal.nota}</p>}
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- QUÉ HACE -->
  <section class="evot-hace" id="hace">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Qué hace</span>
        <h2 class="section-title">Las mismas cinco preguntas, <span class="muted">contestadas sin ti.</span></h2>
      </Reveal>

      <div class="evot-hace-grid">
        {evotCapacidades.map((cap, i) => (
          <Reveal>
            <div class="evot-cap">
              <span class="evot-cap-idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- EL PANEL -->
  <section class="evot-panel" id="panel">
    <div class="container">
      <Reveal>
        <span class="eyebrow">El panel por dentro</span>
        <h2 class="section-title">{pantallas} pantallas. <span class="muted">Estas son, con su nombre real.</span></h2>
      </Reveal>
      <Reveal>
        <p class="evot-intro">
          Entras con tu contraseña desde el teléfono o la computadora. Lo que ves aquí abajo es
          exactamente lo que vas a encontrar adentro, y en el mismo orden — nada de nombres
          bonitos para la página de ventas.
        </p>
      </Reveal>

      <div class="evot-panel-grid">
        {evotPanel.map((group) => (
          <Reveal>
            <div class="evot-panel-group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <span class="evot-panel-name">{item.name}</span>
                    <span class="evot-panel-desc">{item.desc}</span>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- PRECIO: lo nuestro y lo que no es nuestro, al mismo tamaño -->
  <section class="evot-precio" id="precio">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Qué cuesta de verdad</span>
        <h2 class="section-title">{evot.price} una vez. <span class="muted">Y dos cuentas que no nos pagas a nosotros.</span></h2>
      </Reveal>

      <Reveal>
        <div class="evot-precio-card">
          <div class="evot-precio-copy">
            <h3>Lo que nos pagas a nosotros</h3>
            <p class="evot-precio-desc">
              Una sola vez, por montarlo y dejarlo funcionando en tu cuenta. No hay cuota de
              plataforma, ni límite de mensajes, ni un precio que suba el año que viene.
            </p>
            <ul class="evot-check">
              {evotIncluye.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="evot-precio-tag">
            <span class="evot-precio-v">{evot.price}</span>
            <span class="evot-precio-k">{evot.priceKicker}</span>
            <a class="btn btn-primary" href={evotContactHref}>
              <span class="dot"></span> Pedir {evot.name}
            </a>
          </div>
        </div>
      </Reveal>

      <div class="evot-costos">
        <Reveal>
          <h3 class="evot-sub">Lo que pagas por tu cuenta, cada mes</h3>
          <p class="evot-intro">
            Estas dos no pasan por nosotros: las contratas tú, a tu nombre, y son las que hacen
            que el bot sea tuyo de verdad. Son aproximadas y para un negocio normal; el panel te
            enseña el gasto al día para que nunca sea una sorpresa.
          </p>
        </Reveal>
        <div class="evot-costo-grid">
          {evotCostos.map((costo) => (
            <Reveal>
              <div class="evot-costo">
                <span class="evot-costo-k">{costo.concepto}</span>
                <span class="evot-costo-v">{costo.price}</span>
                <span class="evot-costo-a">{costo.aQuien}</span>
                <p>{costo.desc}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>

      <Reveal>
        <div class="evot-no">
          <h3 class="evot-sub">Lo que no está incluido</h3>
          <ul class="evot-cross">
            {evotNoIncluye.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- PROPIEDAD -->
  <section class="evot-propiedad">
    <div class="container">
      <div class="evot-propiedad-grid">
        <Reveal>
          <h2 class="evot-propiedad-title">Es tuyo. <span class="muted">Igual que el código de tu sitio.</span></h2>
        </Reveal>
        <div class="evot-propiedad-facts">
          {evotPropiedad.map((hecho, i) => (
            <Reveal delay={0.1 + i * 0.08}>
              <div class="evot-propiedad-fact">
                <span class="evot-propiedad-k">{hecho.k}</span>
                <p>{hecho.desc}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="evot-faq" id="preguntas">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Preguntas</span>
        <h2 class="section-title">Lo que se pregunta <span class="muted">antes de decir que sí.</span></h2>
      </Reveal>

      <div class="evot-faq-items">
        {evotFaq.map((item) => (
          <Reveal>
            <details class="evot-faq-item">
              <summary>
                <span>{item.q}</span>
                <span class="evot-mark" aria-hidden="true"></span>
              </summary>
              <p>{item.a}</p>
            </details>
          </Reveal>
        ))}
      </div>

      <Reveal>
        <p class="evot-faq-foot">
          ¿Otra duda? Está el <a href={routes.ayuda}>centro de ayuda</a>, y si tampoco está ahí,
          contesta la misma persona que montaría tu bot.
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  /* Sin `.hero` global: esa clase trae el halo naranja del hero de la home, y
     aquí el fondo lo pone <SceneBg>. Dos fuentes de luz peleando dejaban el
     titular sin contraste justo en la mitad izquierda. */
  .evot-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 88vh;
    padding: 168px 0 110px;
    overflow: hidden;
  }
  .evot-hero .container {
    position: relative;
    z-index: 1;
  }
  .evot-hero-copy {
    max-width: 54ch;
  }
  /* Medido a 1440×900: con 88px y 15ch el titular ocupaba cinco líneas y
     empujaba el precio y los dos botones por debajo del pliegue. En una página
     que vende un producto que nadie conoce, la cifra tiene que verse sin
     scrollear — es la que decide si se sigue leyendo. */
  .evot-hero h1 {
    font-size: clamp(38px, 5vw, 74px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 17ch;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .evot-hero h1 .muted {
    color: var(--studio-gray);
  }
  .evot-lead {
    margin-top: 26px;
    max-width: 56ch;
    font-size: 18px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    text-shadow: 0 2px 24px rgba(16, 1, 1, 0.9);
  }
  /* El precio va en el hero y no solo en su bloque: es la cifra que decide si
     alguien sigue leyendo, y en un producto desconocido decidirla tarde es
     perder a quien se imaginó una mensualidad. */
  .evot-hero-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 34px;
  }
  .evot-hero-amount {
    font-size: clamp(44px, 5.6vw, 68px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .evot-hero-kicker {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--flash-orange);
  }
  .evot-hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
  }

  /* ---------- CANALES ---------- */
  .evot-canales {
    padding-bottom: 100px;
  }
  .evot-intro {
    max-width: 62ch;
    margin-bottom: 44px;
    font-size: 17px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.7;
  }
  .evot-canal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .evot-canal {
    height: 100%;
    padding: 30px 26px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, background 0.25s;
  }
  .evot-canal:hover {
    border-color: var(--flash-orange);
    background: rgba(255, 81, 0, 0.06);
  }
  .evot-canal h3 {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }
  .evot-canal p {
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }
  /* El trámite que no depende de nosotros se marca, no se esconde: quien lee
     rápido tiene que verlo sin leerlo entero. */
  .evot-canal-nota {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13.5px;
  }

  .evot-index {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 20px;
    margin-bottom: 44px;
    padding-bottom: 34px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .evot-index-label {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
  }

  /* ---------- QUÉ HACE ---------- */
  /* Los cuatro destinos del índice necesitan margen: el nav flotante mide 110px
     y sin esto el salto deja el titular debajo de la barra. */
  .evot-hace,
  .evot-panel,
  .evot-precio,
  .evot-faq,
  .evot-canales {
    scroll-margin-top: 110px;
  }
  .evot-hace {
    padding-top: 20px;
  }
  .evot-hace-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .evot-cap {
    height: 100%;
    padding: 32px 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, background 0.25s;
  }
  .evot-cap:hover {
    border-color: var(--flash-orange);
    background: rgba(255, 81, 0, 0.05);
  }
  .evot-cap-idx {
    display: block;
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--flash-orange);
  }
  .evot-cap h3 {
    margin: 14px 0 12px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .evot-cap p {
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
  }

  /* ---------- PANEL ---------- */
  .evot-panel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .evot-panel-group {
    height: 100%;
    padding: 30px 28px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
  }
  .evot-panel-group h3 {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 22px;
  }
  .evot-panel-group ul {
    list-style: none;
    display: grid;
    gap: 16px;
  }
  .evot-panel-group li {
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .evot-panel-group li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }
  .evot-panel-name {
    display: block;
    font-size: 16px;
    font-weight: 500;
  }
  .evot-panel-desc {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.55;
  }

  /* ---------- PRECIO ---------- */
  .evot-precio-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 44px;
    align-items: center;
    padding: 44px 46px;
    border-radius: 24px;
    background: linear-gradient(120deg, rgba(255, 81, 0, 0.16), rgba(238, 0, 0, 0.06));
    border: 1px solid rgba(255, 81, 0, 0.4);
  }
  .evot-precio-copy h3 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 14px;
  }
  .evot-precio-desc {
    max-width: 58ch;
    font-size: 16px;
    font-weight: 300;
    color: var(--soft-white);
    line-height: 1.65;
    margin-bottom: 22px;
  }
  .evot-precio-tag {
    text-align: right;
  }
  .evot-precio-v {
    display: block;
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .evot-precio-k {
    display: block;
    margin: 10px 0 22px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
  }

  /* Listas de sí y de no. El símbolo va en `::before` y no en el texto para que
     el lector de pantalla lea la frase y no un carácter suelto. */
  .evot-check,
  .evot-cross {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .evot-check li,
  .evot-cross li {
    position: relative;
    padding-left: 26px;
    font-size: 15.5px;
    font-weight: 300;
    line-height: 1.55;
  }
  .evot-check li {
    color: var(--soft-white);
  }
  .evot-cross li {
    color: var(--studio-gray);
  }
  .evot-check li::before,
  .evot-cross li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 500;
  }
  .evot-check li::before {
    content: '✓';
    color: var(--flash-orange);
  }
  .evot-cross li::before {
    content: '×';
    color: var(--studio-gray);
  }

  .evot-costos {
    margin-top: 64px;
  }
  .evot-sub {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .evot-costo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .evot-costo {
    height: 100%;
    padding: 30px 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
