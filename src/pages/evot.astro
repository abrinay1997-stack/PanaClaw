  .evot-costo-k {
    display: block;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
  }
  .evot-costo-v {
    display: block;
    margin-top: 10px;
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .evot-costo-a {
    display: block;
    margin-top: 10px;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
  }
  .evot-costo p {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 300;
    color: var(--studio-gray);
