---
import '@fontsource/archivo/300.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '../styles/global.css';

// Los dos pesos que usan los H1/H2 above-the-fold. Se preloadean para que el
// texto no repinte al llegar la fuente (evita CLS y un flash de fallback).
import archivo600 from '@fontsource/archivo/files/archivo-latin-600-normal.woff2?url';
import archivo700 from '@fontsource/archivo/files/archivo-latin-700-normal.woff2?url';

import { ClientRouter } from 'astro:transitions';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import ChatWidget from '../components/ChatWidget.astro';

import { site, contact } from '../data/site';
import { withBase, routes } from '../data/links';
import { metaPixelId } from '../data/analytics';
import { socials } from '../data/footer';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  activePath?: string;
  bodyClass?: string;
  /** Schemas JSON-LD extra de la página (Service, FAQPage, …). */
  jsonLd?: Record<string, unknown>[];
  /**
   * Página sin chrome: ni nav, ni footer, ni chat, ni scroll suave. Solo el
   * `<head>` completo y el contenido.
   *
   * Existe para `/smark/`, el enlace de la bio. Ahí el chrome no solo sobra,
   * resta: la página tiene un único trabajo —repartir hacia un destino— y cada
   * salida extra compite con los botones. Quitar el chat y Lenis además evita
   * cargar su JavaScript en la única página que se abre casi siempre desde el
   * navegador interno de una red social, con datos móviles y sin caché.
   *
   * El `<head>` se mantiene entero a propósito: título, OpenGraph e icono son
   * justo lo que se ve al pegar el enlace en un chat o en una historia.
   */
  bare?: boolean;
}

const {
  title,
  description = site.description,
  noindex = false,
  activePath,
  bodyClass,
  jsonLd = [],
  bare = false,
} = Astro.props;

const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;

// URL canónica y OG:URL absolutas (necesitan `site` en astro.config)
const origin = Astro.site ?? new URL('http://localhost:4321');
// Con `trailingSlash:'always'` el pathname ya llega como `/contacto/`, que es
// exactamente la URL que emite el sitemap. La barra final se fuerza igualmente:
// declarar canónica una URL distinta de la que se enlaza es entregarle a Google
// dos direcciones para la misma página.
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, origin).toString();
/**
 * Las páginas con `noindex` no declaran canonical, y la de 404 es el motivo:
 * es el único archivo que NO se sirve como directorio —Netlify la busca en
 * `/404.html`—, así que forzarle la barra final la hacía anunciarse como
 * `/404/`, una URL que devuelve 404. Además, canonical y noindex juntos son
 * señales contradictorias: una dice «indexa esta otra» y la otra «no indexes».
 * Ninguna de las dos páginas afectadas (404 y gracias) gana nada con él.
 */
const emitCanonical = !noindex;
const ogImage = new URL(withBase('og.png'), origin).toString();

/*
 * Schema JSON-LD — se emite solo en la home para no duplicar.
 *
 * Migrado de `Organization` a un tipo doble `[LocalBusiness, ProfessionalService]`
 * en 2026-08-20 a raíz de la auditoría SEO: Organization es genérico y no da
 * señal de negocio local a Google, y por eso el sitio no aparecía en el paquete
 * de Maps para búsquedas como "agencia web Panamá". LocalBusiness sí, y
 * ProfessionalService lo especializa. Van los dos como array porque una web es
 * las dos cosas.
 *
 * Los campos añadidos y por qué:
 * - `address`   → PostalAddress con país PA. Sin dirección exacta a propósito
 *                 (es 100% remoto), pero la locality/country ya localiza.
 * - `priceRange`→ los valores del catálogo, calculados de plans.ts sería ideal,
 *                 pero como este archivo no lo importa y no vale la pena
 *                 acoplar, se pone el rango a mano ($295 - $1200); si cambia,
 *                 sale del build igual porque `astro check` no lo valida.
 * - `sameAs`    → URLs de los perfiles sociales. Es la señal más fuerte para
 *                 DESAMBIGUAR "panaclaw" (que Google confunde con "panaclub").
 *                 Salen de `data/footer.ts`, así el día que activemos otra red
 *                 se suma sola aquí.
 * - `logo`      → apunta al icon-512.png (más grande y más limpio para search
 *                 result), no al apple-touch-icon.
 */
const isHome = canonicalPath === import.meta.env.BASE_URL;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': new URL(routes.home, origin).toString() + '#business',
  name: site.name,
  description: site.description,
  url: new URL(routes.home, origin).toString(),
  logo: new URL(withBase('icon-512.png'), origin).toString(),
  image: ogImage,
  priceRange: '$295 - $1200',
  areaServed: {
    '@type': 'Country',
    name: 'Panama',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'PA',
    addressLocality: 'Panamá',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: contact.whatsapp,
    availableLanguage: ['Spanish'],
  },
  sameAs: socials.filter((s) => s.href).map((s) => s.href),
};

const schemas = isHome ? [orgSchema, ...jsonLd] : jsonLd;

/**
 * Píxel de Meta.
 *
 * TRES COSAS QUE NO SON EL FRAGMENTO QUE DA FACEBOOK, y son a propósito:
 *
 * 1. `PageView` se dispara en la carga inicial Y en `astro:after-swap`. El
 *    sitio navega con View Transitions: sin la segunda llamada, Meta contaría
 *    la primera página de cada visita y ni una más, y todo el recorrido interno
 *    —que es justo lo que se quiere medir— sería invisible. Se usa
 *    `after-swap`, que salta solo al cambiar de página, y NO `page-load`, que
 *    salta también en la carga inicial: con ese se contaría dos veces la
 *    primera página de cada visita.
 *
 * 2. En `/gracias/` se dispara además `Lead`. Es el único punto del sitio donde
 *    alguien ha completado algo, así que es el único evento que sirve para
 *    medir conversiones y construir públicos parecidos. Un píxel que solo
 *    registra visitas no da para nada de eso.
 *
 * 3. EL FRAGMENTO NO SE DESCARGA A SÍ MISMO. El de Meta inserta `fbevents.js`
 *    en la misma línea en que se define `fbq`; aquí la descarga se separa y se
 *    pide más tarde. El motivo está medido: PageSpeed, 22 ago 2026, con Meta
 *    como responsable de 233 KiB, 289 ms de hilo principal en móvil y la mayor
 *    parte de los 620 ms de TBT en escritorio —además de los cuatro hallazgos
 *    que se derivan de él: caché de 20 minutos, 67 KiB de JavaScript sin usar,
 *    13 KiB de polyfills viejos y trabajo de hilo principal. Nada de eso se
 *    arregla desde aquí: el archivo es de Facebook. Lo que sí se puede decidir
 *    es CUÁNDO pesa, y no tiene por qué ser mientras el visitante espera a ver
 *    el titular.
 *
 *    NO SE PIERDE NI UN EVENTO, y esto es lo que hace que el cambio sea seguro:
 *    el `fbq` que define el fragmento es una cola. Las llamadas que se hacen
 *    antes de que llegue el archivo se apilan en `fbq.queue` y se envían todas,
 *    en orden, en cuanto carga. Por eso `init` y `PageView` se siguen llamando
 *    de inmediato: lo único que se aplaza es la descarga.
 *
 *    Se pide en cuanto ocurra lo primero de estas dos: que el visitante toque
 *    la página (cualquier gesto real), o que el navegador termine de cargar y
 *    quede ocioso —con un tope de 2 s para que un hilo ocupado no lo entierre—.
 *    Es decir: siempre, y siempre después de lo que el visitante vino a ver.
 *
 * La ruta de gracias se interpola de `routes`, no se escribe a mano: la regla 1
 * del proyecto vale también dentro de un `<script>`, y esa ruta ya cambió una
 * vez al quitar los `.html`.
 */
const metaPixelSnippet = `
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window,document,'script');
fbq('init', ${JSON.stringify(metaPixelId)});
(function () {
  var gracias = ${JSON.stringify(routes.gracias)};
  function medir() {
    fbq('track', 'PageView');
    if (location.pathname === gracias) fbq('track', 'Lead');
  }
  medir();
  document.addEventListener('astro:after-swap', medir);

  // La descarga: una sola vez, pase lo que pase y gane quien gane la carrera.
  var pedido = false;
  var gestos = ['pointerdown', 'keydown', 'touchstart', 'wheel'];
  var opciones = { passive: true, capture: true };

  function pedirPixel() {
    if (pedido) return;
    pedido = true;
    for (var i = 0; i < gestos.length; i++) {
      window.removeEventListener(gestos[i], pedirPixel, opciones);
    }
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://connect.facebook.net/en_US/fbevents.js';
    document.head.appendChild(s);
  }

  for (var i = 0; i < gestos.length; i++) {
    window.addEventListener(gestos[i], pedirPixel, opciones);
  }

  function alQuedarOcioso() {
    if (window.requestIdleCallback) requestIdleCallback(pedirPixel, { timeout: 2000 });
    else setTimeout(pedirPixel, 1200);
  }
  if (document.readyState === 'complete') alQuedarOcioso();
  else window.addEventListener('load', alQuedarOcioso, { once: true });
})();
`.trim();
---

<!DOCTYPE html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {emitCanonical && <link rel="canonical" href={canonical} />}

    <!-- La fuente self-hosted del H1: sin preload el texto repinta al llegar -->
    <link rel="preload" href={archivo700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo600} as="font" type="font/woff2" crossorigin />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Cuatro iconos, cada uno con su motivo:
      - SVG: navegadores modernos, escala a cualquier densidad.
      - 32×32 PNG: fallback histórico para la pestaña.
      - 192×192 PNG: el que prefiere Google Search para el favicon del
        resultado (documentado por Google en la guía de favicon). Sin esto, el
        resultado sale con un globo genérico —fue el hallazgo del 2026-08-20—.
        Va en múltiplo de 48, que es lo que Google recomienda.
      - 512×512 PNG: el que usan Android/PWA para instalar en pantalla de
        inicio, y el que declaramos como `logo` en el JSON-LD.
      - apple-touch-icon: iOS al añadir a inicio; fondo negro obligatorio.
    */}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('icon-192.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase('icon-512.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />

    <!-- View Transitions API entre páginas -->
    <ClientRouter />

    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Sin identificador no se emite nada: ver el porqué en data/analytics.ts */}
    {metaPixelId && <script is:inline set:html={metaPixelSnippet} />}
  </head>
  <body class={bodyClass}>
    {/*
      Respaldo del píxel para navegadores con JavaScript desactivado. Va tal
      cual lo distribuye Meta. Alcance real muy pequeño —sin JavaScript aquí no
      funcionan ni el cotizador, ni el chat, ni el menú de móvil—, pero no
      cuesta nada y es la única señal que dejaría esa visita.
    */}
    {metaPixelId && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        />
      </noscript>
    )}
    {/* Sin nav no hay nada que saltar: el enlace sobraría y confundiría. */}
    {!bare && <a class="skip-link" href="#contenido">Saltar al contenido</a>}
    {!bare && <Nav activePath={activePath} />}
    <main id="contenido">
      <slot />
    </main>
    {!bare && <Footer />}

    <!-- Sistemas globales de motion. Se auto-inicializan y respetan reduce-motion. -->
    {!bare && <SmoothScroll />}
    {!bare && <ChatWidget />}
  </body>
</html>
